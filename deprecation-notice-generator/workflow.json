{"name":"Deprecation Notice Generator Agent","nodes":[{"parameters":{"httpMethod":"POST","path":"generate-deprecation-notice","responseMode":"responseNode","options":{}},"id":"w6x7y8z9a1-0001","name":"Webhook","type":"n8n-nodes-base.webhook","typeVersion":2,"position":[200,320]},{"parameters":{"jsCode":"const body=$input.first().json.body;const required=['deprecated_item','deprecation_date','replacement_or_alternative'];const missing=required.filter(f=>!body[f]);if(missing.length)return[{json:{valid:false,error:'Missing: '+missing.join(', ')}}];const itemTypes=['api_endpoint','feature','integration','library_version','entire_product','sdk_method','config_option'];const itemType=itemTypes.includes(body.item_type)?body.item_type:'feature';return[{json:{valid:true,deprecatedItem:body.deprecated_item.trim(),itemType,deprecationDate:body.deprecation_date,sunsetDate:body.sunset_date||'',replacementOrAlternative:body.replacement_or_alternative.trim().slice(0,600),reasonForDeprecation:(body.reason_for_deprecation||'').slice(0,400),affectedUserEstimate:(body.affected_user_estimate||'').slice(0,200),migrationComplexity:body.migration_complexity||'moderate',migrationGuideUrl:(body.migration_guide_url||'').trim(),supportChannel:(body.support_channel||'').trim(),productName:(body.product_name||'').trim(),audienceEmailList:body.audience_email_list||'',replyEmail:body.reply_email||null}}];"},"id":"w6x7y8z9a1-0002","name":"Validate Input","type":"n8n-nodes-base.code","typeVersion":2,"position":[420,320]},{"parameters":{"conditions":{"conditions":[{"id":"cv","leftValue":"={{ $json.valid }}","rightValue":true,"operator":{"type":"boolean","operation":"true"}}],"combinator":"and"}},"id":"w6x7y8z9a1-0003","name":"Valid?","type":"n8n-nodes-base.if","typeVersion":2,"position":[640,320]},{"parameters":{"respondWith":"json","responseBody":"={{ { error: $json.error, status: 400 } }}"},"id":"w6x7y8z9a1-0004","name":"Return Error","type":"n8n-nodes-base.respondToWebhook","typeVersion":1,"position":[860,480]},{"parameters":{"model":"claude-sonnet-4-20250514","options":{"temperature":0.4,"maxTokens":2500},"messages":{"values":[{"content":"You write deprecation notices for developer and customer audiences. Good deprecation notices: state clearly what is deprecated and by when, explain why without excessive apology, give a specific migration path, and respect the reader's time by front-loading the actionable information. You write multiple versions calibrated to urgency as the sunset date approaches. Always respond in valid JSON only.","role":"system"},{"content":"Write deprecation notices.\n\nProduct: {{ $json.productName || 'not specified' }}\nDeprecated: {{ $json.deprecatedItem }}\nType: {{ $json.itemType.replace(/_/g,' ') }}\nDeprecation announced: {{ $json.deprecationDate }}\nSunset date (removal): {{ $json.sunsetDate || 'not specified' }}\nReplacement/alternative: {{ $json.replacementOrAlternative }}\nReason: {{ $json.reasonForDeprecation || 'not specified' }}\nAffected users: {{ $json.affectedUserEstimate || 'not specified' }}\nMigration complexity: {{ $json.migrationComplexity }}\nMigration guide: {{ $json.migrationGuideUrl || 'not provided' }}\nSupport channel: {{ $json.supportChannel || 'not specified' }}\n\nReturn JSON:\n{\"initial_announcement\":{\"subject\":\"\",\"headline\":\"\",\"body\":\"complete notice for the initial announcement — what's deprecated, why, timeline, migration path, where to get help\"},\"reminder_notice\":{\"subject\":\"\",\"headline\":\"\",\"body\":\"a shorter reminder notice for roughly the midpoint before sunset — more urgent tone\"},\"final_warning\":{\"subject\":\"\",\"headline\":\"\",\"body\":\"an urgent final notice shortly before sunset — clear about what breaks and when\"},\"changelog_entry\":\"a concise changelog-style entry\",\"migration_checklist\":[\"specific steps for affected users to migrate\"],\"faq\":[{\"question\":\"a question affected users will likely ask\",\"answer\":\"\"}],\"internal_talking_points\":[\"points for support/CS team to use when customers ask about this deprecation\"]}","role":"user"}]}},"id":"w6x7y8z9a1-0005","name":"Claude Notice Writer","type":"@n8n/n8n-nodes-langchain.lmChatAnthropic","typeVersion":1.3,"position":[860,240]},{"parameters":{"jsCode":"const raw=$input.first().json.text||$input.first().json.content?.[0]?.text||'';let result;try{result=JSON.parse(raw.replace(/```json|```/g,'').trim());}catch(e){return[{json:{error:'Parse error'}}];}const input=$('Validate Input').first().json;result._meta={deprecatedItem:input.deprecatedItem,productName:input.productName,deprecationDate:input.deprecationDate,sunsetDate:input.sunsetDate,audienceEmailList:input.audienceEmailList,replyEmail:input.replyEmail};return[{json:result}];"},"id":"w6x7y8z9a1-0006","name":"Parse Result","type":"n8n-nodes-base.code","typeVersion":2,"position":[1080,240]},{"parameters":{"jsCode":"const r=$input.first().json;const m=r._meta;function esc(s){return String(s||'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');}const ia=r.initial_announcement||{};const rn=r.reminder_notice||{};const fw=r.final_warning||{};const noticeBlock=(label,notice,color)=>notice.headline?'<div style=\"border:1px solid #e5e7eb;border-radius:8px;margin-bottom:12px;overflow:hidden\"><div style=\"background:'+color+';color:#fff;padding:9px 16px;font-size:12px;font-weight:700;text-transform:uppercase\">'+label+'</div><div style=\"padding:14px 18px\"><div style=\"font-size:12px;color:#9ca3af;margin-bottom:3px\">Subject: '+esc(notice.subject)+'</div><div style=\"font-size:15px;font-weight:700;margin-bottom:8px\">'+esc(notice.headline)+'</div><div style=\"font-size:14px;line-height:1.7;color:#374151;white-space:pre-line\">'+esc(notice.body)+'</div></div></div>':'';const checklist=(r.migration_checklist||[]).map((c,i)=>'<div style=\"font-size:13px;padding:5px 0;border-bottom:1px solid #f3f4f6;display:flex;gap:6px\"><input type=\"checkbox\"><span>'+esc(c)+'</span></div>').join('');const faq=(r.faq||[]).map(f=>'<div style=\"margin-bottom:10px\"><div style=\"font-size:13px;font-weight:700;margin-bottom:3px\">'+esc(f.question)+'</div><div style=\"font-size:13px;color:#374151\">'+esc(f.answer)+'</div></div>').join('');const talkingPoints=(r.internal_talking_points||[]).map(t=>'<div style=\"font-size:13px;padding:4px 0;color:#1e40af\">\u2192 '+esc(t)+'</div>').join('');const html='<!DOCTYPE html><html><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"></head><body style=\"margin:0;padding:16px;background:#f9fafb;font-family:sans-serif;color:#111\"><div style=\"max-width:760px;margin:0 auto\"><div style=\"background:#1e293b;color:#fff;padding:18px 26px;border-radius:10px 10px 0 0\"><div style=\"font-size:11px;text-transform:uppercase;color:#64748b\">Deprecation Notice'+(m.productName?' \u00b7 '+esc(m.productName):'')+'</div><div style=\"font-size:18px;font-weight:700\">'+esc(m.deprecatedItem)+'</div><div style=\"font-size:13px;color:#94a3b8\">Announced: '+esc(m.deprecationDate)+(m.sunsetDate?' \u00b7 Sunset: '+esc(m.sunsetDate):'')+'</div></div><div style=\"background:#fff;padding:16px 26px;border:1px solid #e5e7eb;border-top:none\">'+noticeBlock('Initial announcement',ia,'#2563eb')+noticeBlock('Reminder notice (midpoint)',rn,'#d97706')+noticeBlock('Final warning',fw,'#dc2626')+'</div>'+(checklist?'<div style=\"background:#fff;padding:14px 26px;border:1px solid #e5e7eb;border-top:3px solid #f3f4f6\"><div style=\"font-size:11px;font-weight:700;text-transform:uppercase;color:#9ca3af;margin-bottom:8px\">Migration checklist</div>'+checklist+'</div>':'')+(faq?'<div style=\"background:#fff;padding:14px 26px;border:1px solid #e5e7eb;border-top:3px solid #f3f4f6\"><div style=\"font-size:11px;font-weight:700;text-transform:uppercase;color:#9ca3af;margin-bottom:8px\">FAQ</div>'+faq+'</div>':'')+(talkingPoints?'<div style=\"background:#eff6ff;padding:12px 26px;border:1px solid #bfdbfe\"><div style=\"font-size:11px;font-weight:700;text-transform:uppercase;color:#1d4ed8;margin-bottom:6px\">Internal talking points (support/CS)</div>'+talkingPoints+'</div>':'')+(r.changelog_entry?'<div style=\"background:#f9fafb;padding:10px 26px;border:1px solid #e5e7eb;font-family:monospace;font-size:13px\">'+esc(r.changelog_entry)+'</div>':'')+'<div style=\"background:#1e293b;color:#475569;font-size:11px;padding:10px 26px;border-radius:0 0 10px 10px;text-align:center\">Deprecation Notice \u00b7 '+esc(m.deprecatedItem)+'</div></div></body></html>';return[{json:{html,replyEmail:m.replyEmail,audienceEmailList:m.audienceEmailList,deprecatedItem:m.deprecatedItem,initialSubject:ia.subject,initialBody:ia.body,result:r}}];"},"id":"w6x7y8z9a1-0007","name":"Build Notices","type":"n8n-nodes-base.code","typeVersion":2,"position":[1300,240]},{"parameters":{"conditions":{"conditions":[{"id":"cae","leftValue":"={{ $json.audienceEmailList }}","rightValue":"","operator":{"type":"string","operation":"notEmpty"}}],"combinator":"and"}},"id":"w6x7y8z9a1-0008","name":"Send Initial?","type":"n8n-nodes-base.if","typeVersion":2,"position":[1520,180]},{"parameters":{"fromEmail":"={{$env.FROM_EMAIL}}","toEmail":"={{ $json.audienceEmailList }}","subject":"={{ $json.initialSubject }}","emailType":"text","message":"={{ $json.initialBody }}"},"id":"w6x7y8z9a1-0009","name":"Email Initial Notice","type":"n8n-nodes-base.emailSend","typeVersion":2.1,"position":[1740,120],"credentials":{"smtp":{"id":"smtp-creds-01","name":"SMTP Account"}}},{"parameters":{"conditions":{"conditions":[{"id":"cre","leftValue":"={{ $json.replyEmail }}","rightValue":"","operator":{"type":"string","operation":"notEmpty"}}],"combinator":"and"}},"id":"w6x7y8z9a1-0010","name":"Has Reply Email?","type":"n8n-nodes-base.if","typeVersion":2,"position":[1520,320]},{"parameters":{"fromEmail":"={{$env.FROM_EMAIL}}","toEmail":"={{$json.replyEmail}}","subject":"Deprecation notices: {{ $json.deprecatedItem }}","emailType":"html","message":"={{$json.html}}"},"id":"w6x7y8z9a1-0011","name":"Email Preview","type":"n8n-nodes-base.emailSend","typeVersion":2.1,"position":[1740,380],"credentials":{"smtp":{"id":"smtp-creds-01","name":"SMTP Account"}}},{"parameters":{"respondWith":"json","responseBody":"={{ { status: 'generated', item: $json.deprecatedItem, initial_sent: $json.audienceEmailList ? true : false, emailed_preview: $json.replyEmail ? true : false, result: $json.result } }}"},"id":"w6x7y8z9a1-0012","name":"Return Result","type":"n8n-nodes-base.respondToWebhook","typeVersion":1,"position":[1960,240]}],"connections":{"Webhook":{"main":[[{"node":"Validate Input","type":"main","index":0}]]},"Validate Input":{"main":[[{"node":"Valid?","type":"main","index":0}]]},"Valid?":{"main":[[{"node":"Claude Notice Writer","type":"main","index":0}],[{"node":"Return Error","type":"main","index":0}]]},"Claude Notice Writer":{"main":[[{"node":"Parse Result","type":"main","index":0}]]},"Parse Result":{"main":[[{"node":"Build Notices","type":"main","index":0}]]},"Build Notices":{"main":[[{"node":"Send Initial?","type":"main","index":0}],[{"node":"Has Reply Email?","type":"main","index":0}]]},"Send Initial?":{"main":[[{"node":"Email Initial Notice","type":"main","index":0}],[]]},"Has Reply Email?":{"main":[[{"node":"Email Preview","type":"main","index":0}],[{"node":"Return Result","type":"main","index":0}]]},"Email Initial Notice":{"main":[[{"node":"Return Result","type":"main","index":0}]]},"Email Preview":{"main":[[{"node":"Return Result","type":"main","index":0}]]}},"pinData":{},"settings":{"executionOrder":"v1","saveManualExecutions":true},"staticData":null,"tags":["developer","api","deprecation","communications"],"triggerCount":0,"updatedAt":"2025-06-18T11:00:00.000Z","versionId":"v1.0.0"}
