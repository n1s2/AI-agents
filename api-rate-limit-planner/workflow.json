{"name":"API Rate Limit Planner Agent","nodes":[{"parameters":{"httpMethod":"POST","path":"plan-rate-limits","responseMode":"responseNode","options":{}},"id":"t3u4v5w6x7-0001","name":"Webhook","type":"n8n-nodes-base.webhook","typeVersion":2,"position":[200,320]},{"parameters":{"jsCode":"const body=$input.first().json.body;const required=['api_name','usage_patterns'];const missing=required.filter(f=>!body[f]);if(missing.length)return[{json:{valid:false,error:'Missing: '+missing.join(', ')}}];const patterns=Array.isArray(body.usage_patterns)?body.usage_patterns:[];if(patterns.length===0)return[{json:{valid:false,error:'usage_patterns must be non-empty'}}];const formatted=patterns.slice(0,15).map((p,i)=>({endpoint:(p.endpoint||'endpoint-'+(i+1)).trim(),avgRequestsPerMin:parseFloat(p.avg_requests_per_min)||null,peakRequestsPerMin:parseFloat(p.peak_requests_per_min)||null,requestCost:p.request_cost||'low',clientType:p.client_type||'external',criticality:p.criticality||'medium'}));return[{json:{valid:true,apiName:body.api_name.trim(),infraCapacity:(body.infra_capacity||'').slice(0,400),customerTiers:Array.isArray(body.customer_tiers)?body.customer_tiers:[],usagePatterns:formatted,abusePreventionGoals:(body.abuse_prevention_goals||'').slice(0,300),existingLimits:(body.existing_limits||'').slice(0,300),fairnessGoals:(body.fairness_goals||'').slice(0,300),replyEmail:body.reply_email||null}}];"},"id":"t3u4v5w6x7-0002","name":"Validate Input","type":"n8n-nodes-base.code","typeVersion":2,"position":[420,320]},{"parameters":{"conditions":{"conditions":[{"id":"cv","leftValue":"={{ $json.valid }}","rightValue":true,"operator":{"type":"boolean","operation":"true"}}],"combinator":"and"}},"id":"t3u4v5w6x7-0003","name":"Valid?","type":"n8n-nodes-base.if","typeVersion":2,"position":[640,320]},{"parameters":{"respondWith":"json","responseBody":"={{ { error: $json.error, status: 400 } }}"},"id":"t3u4v5w6x7-0004","name":"Return Error","type":"n8n-nodes-base.respondToWebhook","typeVersion":1,"position":[860,480]},{"parameters":{"model":"claude-sonnet-4-20250514","options":{"temperature":0.3,"maxTokens":2500},"messages":{"values":[{"content":"You design API rate limiting strategies. Good rate limit design: protects infrastructure without punishing legitimate usage, uses appropriate algorithms per use case (token bucket for bursty traffic, sliding window for steady traffic), gives clients clear signals about their limits and remaining quota, and has a graceful degradation path rather than hard failures. Always respond in valid JSON only.","role":"system"},{"content":"Design a rate limiting strategy.\n\nAPI: {{ $json.apiName }}\nInfra capacity: {{ $json.infraCapacity || 'not specified' }}\nAbuse prevention goals: {{ $json.abusePreventionGoals || 'not specified' }}\nExisting limits: {{ $json.existingLimits || 'none — greenfield design' }}\nFairness goals: {{ $json.fairnessGoals || 'not specified' }}\n\nCustomer tiers: {{ JSON.stringify($json.customerTiers) }}\n\nUsage patterns by endpoint:\n{{ $json.usagePatterns.map(p=>p.endpoint+': avg='+(p.avgRequestsPerMin||'?')+'/min peak='+(p.peakRequestsPerMin||'?')+'/min cost='+p.requestCost+' client='+p.clientType+' criticality='+p.criticality).join('\\n') }}\n\nReturn JSON:\n{\"strategy_summary\":\"2-3 sentences on overall rate limiting approach and why\",\"algorithm_recommendation\":{\"algorithm\":\"token_bucket|sliding_window|fixed_window|leaky_bucket\",\"rationale\":\"\"},\"endpoint_limits\":[{\"endpoint\":\"\",\"limit\":\"specific number and window, e.g. 100 requests per minute\",\"burst_allowance\":\"\",\"rationale\":\"\"}],\"tier_based_limits\":[{\"tier\":\"\",\"overall_limit\":\"\",\"rationale\":\"\"}],\"response_headers\":[\"specific rate limit headers to return, e.g. X-RateLimit-Remaining\"],\"exceeded_behavior\":{\"http_status\":429,\"response_body_example\":\"\",\"retry_after_guidance\":\"\"},\"graceful_degradation\":\"what happens as clients approach limits — warnings before hard block\",\"abuse_detection_signals\":[\"specific patterns that indicate abuse vs legitimate high usage\"],\"monitoring_metrics\":[\"specific metrics to track rate limit effectiveness\"],\"documentation_recommendations\":[\"what to document for API consumers about rate limits\"]}","role":"user"}]}},"id":"t3u4v5w6x7-0005","name":"Claude Rate Limit Designer","type":"@n8n/n8n-nodes-langchain.lmChatAnthropic","typeVersion":1.3,"position":[860,240]},{"parameters":{"jsCode":"const raw=$input.first().json.text||$input.first().json.content?.[0]?.text||'';let result;try{result=JSON.parse(raw.replace(/```json|```/g,'').trim());}catch(e){return[{json:{error:'Parse error'}}];}const input=$('Validate Input').first().json;result._meta={apiName:input.apiName,replyEmail:input.replyEmail};return[{json:result}];"},"id":"t3u4v5w6x7-0006","name":"Parse Result","type":"n8n-nodes-base.code","typeVersion":2,"position":[1080,240]},{"parameters":{"jsCode":"const r=$input.first().json;const m=r._meta;function esc(s){return String(s||'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');}const endpointRows=(r.endpoint_limits||[]).map(e=>'<tr style=\"border-bottom:1px solid #f3f4f6\"><td style=\"padding:8px 12px;font-size:12px;font-family:monospace\">'+esc(e.endpoint)+'</td><td style=\"padding:8px 12px;font-size:13px;font-weight:700;color:#2563eb\">'+esc(e.limit)+'</td><td style=\"padding:8px 12px;font-size:12px\">'+esc(e.burst_allowance||'—')+'</td><td style=\"padding:8px 12px;font-size:12px;color:#6b7280\">'+esc(e.rationale)+'</td></tr>').join('');const tierRows=(r.tier_based_limits||[]).map(t=>'<div style=\"border:1px solid #e5e7eb;border-radius:6px;padding:9px 14px;margin-bottom:7px\"><div style=\"display:flex;justify-content:space-between;margin-bottom:3px\"><span style=\"font-size:14px;font-weight:700\">'+esc(t.tier)+'</span><span style=\"font-size:14px;font-weight:800;color:#7c3aed\">'+esc(t.overall_limit)+'</span></div><div style=\"font-size:12px;color:#6b7280\">'+esc(t.rationale)+'</div></div>').join('');const headers=(r.response_headers||[]).map(h=>'<code style=\"background:#0f172a;color:#86efac;padding:3px 8px;border-radius:4px;font-size:12px;margin-right:6px;display:inline-block;margin-bottom:4px\">'+esc(h)+'</code>').join('');const abuseSignals=(r.abuse_detection_signals||[]).map(a=>'<div style=\"font-size:13px;padding:4px 0;color:#7f1d1d\">\u26a0 '+esc(a)+'</div>').join('');const monitoring=(r.monitoring_metrics||[]).map(mo=>'<div style=\"font-size:13px;padding:4px 0\">\ud83d\udcc8 '+esc(mo)+'</div>').join('');const docs=(r.documentation_recommendations||[]).map((d,i)=>'<div style=\"font-size:13px;padding:5px 0;border-bottom:1px solid #eff6ff;color:#1e40af\">'+(i+1)+'. '+esc(d)+'</div>').join('');const eb=r.exceeded_behavior||{};const algo=r.algorithm_recommendation||{};const html='<!DOCTYPE html><html><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"></head><body style=\"margin:0;padding:16px;background:#f9fafb;font-family:sans-serif;color:#111\"><div style=\"max-width:780px;margin:0 auto\"><div style=\"background:#1e293b;color:#fff;padding:18px 26px;border-radius:10px 10px 0 0\"><div style=\"font-size:11px;text-transform:uppercase;color:#64748b\">Rate Limit Strategy</div><div style=\"font-size:18px;font-weight:700\">'+esc(m.apiName)+'</div></div><div style=\"background:#fff;padding:14px 26px;border:1px solid #e5e7eb;border-top:none\"><p style=\"font-size:14px;color:#374151;margin:0 0 8px\">'+esc(r.strategy_summary)+'</p><div style=\"background:#eff6ff;padding:8px 12px;border-radius:6px;font-size:13px;color:#1e40af\"><strong>Algorithm:</strong> '+esc((algo.algorithm||'').replace(/_/g,' '))+' — '+esc(algo.rationale)+'</div></div>'+(tierRows?'<div style=\"background:#fff;padding:14px 26px;border:1px solid #e5e7eb;border-top:3px solid #f3f4f6\"><div style=\"font-size:11px;font-weight:700;text-transform:uppercase;color:#7c3aed;margin-bottom:8px\">Tier-based limits</div>'+tierRows+'</div>':'')+(endpointRows?'<div style=\"background:#fff;border:1px solid #e5e7eb;border-top:3px solid #f3f4f6;overflow-x:auto\"><div style=\"font-size:11px;font-weight:700;text-transform:uppercase;color:#9ca3af;padding:10px 26px 0\">Endpoint limits</div><table style=\"width:100%;border-collapse:collapse\"><thead><tr style=\"font-size:11px;text-transform:uppercase;color:#9ca3af\"><th style=\"padding:7px 12px;text-align:left\">Endpoint</th><th style=\"padding:7px 12px;text-align:left\">Limit</th><th style=\"padding:7px 12px;text-align:left\">Burst</th><th style=\"padding:7px 12px;text-align:left\">Rationale</th></tr></thead><tbody>'+endpointRows+'</tbody></table></div>':'')+(headers?'<div style=\"background:#fff;padding:12px 26px;border:1px solid #e5e7eb\"><div style=\"font-size:11px;font-weight:700;text-transform:uppercase;color:#9ca3af;margin-bottom:6px\">Response headers</div>'+headers+'</div>':'')+(eb.http_status?'<div style=\"background:#fef2f2;padding:12px 26px;border:1px solid #fecaca\"><div style=\"font-size:11px;font-weight:700;text-transform:uppercase;color:#dc2626;margin-bottom:6px\">Exceeded behavior (HTTP '+eb.http_status+')</div><div style=\"background:#0f172a;color:#86efac;padding:8px;border-radius:4px;font-family:monospace;font-size:12px;margin-bottom:6px\">'+esc(eb.response_body_example)+'</div><div style=\"font-size:12px;color:#7f1d1d\">'+esc(eb.retry_after_guidance)+'</div></div>':'')+(r.graceful_degradation?'<div style=\"background:#f9fafb;padding:10px 26px;border:1px solid #e5e7eb\"><div style=\"font-size:11px;font-weight:700;text-transform:uppercase;color:#9ca3af;margin-bottom:4px\">Graceful degradation</div><div style=\"font-size:13px;color:#374151\">'+esc(r.graceful_degradation)+'</div></div>':'')+(abuseSignals?'<div style=\"background:#fef2f2;padding:12px 26px;border:1px solid #fecaca\"><div style=\"font-size:11px;font-weight:700;text-transform:uppercase;color:#dc2626;margin-bottom:5px\">Abuse detection signals</div>'+abuseSignals+'</div>':'')+(monitoring?'<div style=\"background:#f9fafb;padding:12px 26px;border:1px solid #e5e7eb\"><div style=\"font-size:11px;font-weight:700;text-transform:uppercase;color:#9ca3af;margin-bottom:5px\">Monitoring metrics</div>'+monitoring+'</div>':'')+(docs?'<div style=\"background:#eff6ff;padding:14px 26px;border:1px solid #bfdbfe\"><div style=\"font-size:11px;font-weight:700;text-transform:uppercase;color:#1d4ed8;margin-bottom:7px\">Documentation recommendations</div>'+docs+'</div>':'')+'<div style=\"background:#1e293b;color:#475569;font-size:11px;padding:10px 26px;border-radius:0 0 10px 10px;text-align:center\">Rate Limit Strategy \u00b7 '+esc(m.apiName)+'</div></div></body></html>';return[{json:{html,replyEmail:m.replyEmail,apiName:m.apiName,result:r}}];"},"id":"t3u4v5w6x7-0007","name":"Build Plan","type":"n8n-nodes-base.code","typeVersion":2,"position":[1300,240]},{"parameters":{"conditions":{"conditions":[{"id":"ce","leftValue":"={{ $json.replyEmail }}","rightValue":"","operator":{"type":"string","operation":"notEmpty"}}],"combinator":"and"}},"id":"t3u4v5w6x7-0008","name":"Has Email?","type":"n8n-nodes-base.if","typeVersion":2,"position":[1520,240]},{"parameters":{"fromEmail":"={{$env.FROM_EMAIL}}","toEmail":"={{$json.replyEmail}}","subject":"Rate limit strategy: {{ $json.apiName }}","emailType":"html","message":"={{$json.html}}"},"id":"t3u4v5w6x7-0009","name":"Email Plan","type":"n8n-nodes-base.emailSend","typeVersion":2.1,"position":[1740,180],"credentials":{"smtp":{"id":"smtp-creds-01","name":"SMTP Account"}}},{"parameters":{"respondWith":"json","responseBody":"={{ { status: 'planned', api: $json.apiName, emailed: $json.replyEmail ? true : false, result: $json.result } }}"},"id":"t3u4v5w6x7-0010","name":"Return Plan","type":"n8n-nodes-base.respondToWebhook","typeVersion":1,"position":[1960,240]}],"connections":{"Webhook":{"main":[[{"node":"Validate Input","type":"main","index":0}]]},"Validate Input":{"main":[[{"node":"Valid?","type":"main","index":0}]]},"Valid?":{"main":[[{"node":"Cl