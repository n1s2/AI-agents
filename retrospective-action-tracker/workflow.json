{"name":"Retrospective Action Tracker Agent","nodes":[{"parameters":{"httpMethod":"POST","path":"submit-retro-item","responseMode":"responseNode","options":{}},"id":"d4e5f6g7h8-0001","name":"Submit Item Webhook","type":"n8n-nodes-base.webhook","typeVersion":2,"position":[200,200]},{"parameters":{"httpMethod":"POST","path":"generate-retro-summary","responseMode":"responseNode","options":{}},"id":"d4e5f6g7h8-0011","name":"Generate Summary Webhook","type":"n8n-nodes-base.webhook","typeVersion":2,"position":[200,480]},{"parameters":{"jsCode":"const body=$input.first().json.body;const required=['team_name','sprint_name','item_text','item_type'];const missing=required.filter(f=>!body[f]);if(missing.length)return[{json:{valid:false,error:'Missing: '+missing.join(', ')}}];const types=['went_well','went_poorly','action_item','kudos','blocker'];const itemType=types.includes(body.item_type)?body.item_type:'went_poorly';return[{json:{valid:true,teamName:body.team_name.trim(),sprintName:body.sprint_name.trim(),itemId:'RET-'+Date.now(),itemType,itemText:body.item_text.trim().slice(0,600),submittedBy:body.submitted_by||'anonymous',votes:parseInt(body.votes)||1,timestamp:new Date().toISOString()}}];"},"id":"d4e5f6g7h8-0002","name":"Validate Item","type":"n8n-nodes-base.code","typeVersion":2,"position":[420,200]},{"parameters":{"conditions":{"conditions":[{"id":"cv","leftValue":"={{ $json.valid }}","rightValue":true,"operator":{"type":"boolean","operation":"true"}}],"combinator":"and"}},"id":"d4e5f6g7h8-0003","name":"Item Valid?","type":"n8n-nodes-base.if","typeVersion":2,"position":[640,200]},{"parameters":{"respondWith":"json","responseBody":"={{ { error: $json.error, status: 400 } }}"},"id":"d4e5f6g7h8-0004","name":"Return Item Error","type":"n8n-nodes-base.respondToWebhook","typeVersion":1,"position":[860,300]},{"parameters":{"operation":"append","documentId":{"__rl":true,"value":"={{$env.RETRO_SHEET_ID}}","mode":"id"},"sheetName":{"__rl":true,"value":"Sheet1","mode":"name"},"columns":{"mappingMode":"defineBelow","value":{"item_id":"={{ $json.itemId }}","team_name":"={{ $json.teamName }}","sprint_name":"={{ $json.sprintName }}","item_type":"={{ $json.itemType }}","item_text":"={{ $json.itemText }}","submitted_by":"={{ $json.submittedBy }}","votes":"={{ $json.votes }}","timestamp":"={{ $json.timestamp }}"}},"options":{}},"id":"d4e5f6g7h8-0005","name":"Save to Sheets","type":"n8n-nodes-base.googleSheets","typeVersion":4.4,"position":[860,160],"credentials":{"googleSheetsOAuth2Api":{"id":"gsheets-creds-01","name":"Google Sheets"}}},{"parameters":{"respondWith":"json","responseBody":"={{ { status: 'saved', item_id: $json.itemId, team: $json.teamName, sprint: $json.sprintName, type: $json.itemType } }}"},"id":"d4e5f6g7h8-0006","name":"Confirm Saved","type":"n8n-nodes-base.respondToWebhook","typeVersion":1,"position":[1080,160]},{"parameters":{"jsCode":"const body=$input.first().json.body;const required=['team_name','sprint_name'];const missing=required.filter(f=>!body[f]);if(missing.length)return[{json:{valid:false,error:'Missing: '+missing.join(', ')}}];return[{json:{valid:true,teamName:body.team_name.trim(),sprintName:body.sprint_name.trim(),sprintGoal:(body.sprint_goal||'').slice(0,300),velocityNotes:(body.velocity_notes||'').slice(0,300),replyEmail:body.reply_email||null}}];"},"id":"d4e5f6g7h8-0012","name":"Validate Summary Request","type":"n8n-nodes-base.code","typeVersion":2,"position":[420,480]},{"parameters":{"conditions":{"conditions":[{"id":"cv2","leftValue":"={{ $json.valid }}","rightValue":true,"operator":{"type":"boolean","operation":"true"}}],"combinator":"and"}},"id":"d4e5f6g7h8-0013","name":"Summary Valid?","type":"n8n-nodes-base.if","typeVersion":2,"position":[640,480]},{"parameters":{"respondWith":"json","responseBody":"={{ { error: $json.error, status: 400 } }}"},"id":"d4e5f6g7h8-0014","name":"Return Summary Error","type":"n8n-nodes-base.respondToWebhook","typeVersion":1,"position":[860,580]},{"parameters":{"operation":"read","documentId":{"__rl":true,"value":"={{$env.RETRO_SHEET_ID}}","mode":"id"},"sheetName":{"__rl":true,"value":"Sheet1","mode":"name"},"options":{}},"id":"d4e5f6g7h8-0015","name":"Read All Items","type":"n8n-nodes-base.googleSheets","typeVersion":4.4,"position":[860,420],"credentials":{"googleSheetsOAuth2Api":{"id":"gsheets-creds-01","name":"Google Sheets"}}},{"parameters":{"jsCode":"const allRows=$input.first().json||[];const req=$('Validate Summary Request').first().json;const rows=Array.isArray(allRows)?allRows:Object.values(allRows);const sprintItems=rows.filter(r=>r.team_name===req.teamName&&r.sprint_name===req.sprintName);if(sprintItems.length===0)return[{json:{valid:false,error:'No retro items found for '+req.teamName+' / '+req.sprintName}}];const byType={went_well:[],went_poorly:[],action_item:[],kudos:[],blocker:[]};sprintItems.forEach(r=>{const t=r.item_type;if(byType[t])byType[t].push({text:r.item_text,votes:parseInt(r.votes)||1,by:r.submitted_by});});const formatItems=arr=>arr.sort((a,b)=>b.votes-a.votes).map(i=>'['+i.votes+' votes] '+i.text+(i.by&&i.by!=='anonymous'?' ('+i.by+')':'')).join('\\n');return[{json:{teamName:req.teamName,sprintName:req.sprintName,sprintGoal:req.sprintGoal,velocityNotes:req.velocityNotes,replyEmail:req.replyEmail,itemCount:sprintItems.length,wentWell:formatItems(byType.went_well),wentPoorly:formatItems(byType.went_poorly),actionItems:formatItems(byType.action_item),kudos:formatItems(byType.kudos),blockers:formatItems(byType.blocker)}}];"},"id":"d4e5f6g7h8-0016","name":"Filter Sprint Items","type":"n8n-nodes-base.code","typeVersion":2,"position":[1060,420]},{"parameters":{"model":"claude-sonnet-4-20250514","options":{"temperature":0.45,"maxTokens":1500},"messages":{"values":[{"content":"You facilitate sprint retrospectives for engineering teams. You synthesize raw retro items into: themes that cluster related feedback, concrete action items with owners and timelines (not vague commitments), a team health signal, and a summary useful for stakeholders. You notice patterns, call out recurring issues, and celebrate genuine wins. Always respond in valid JSON only.","role":"system"},{"content":"Generate a retrospective summary.\n\nTeam: {{ $json.teamName }}\nSprint: {{ $json.sprintName }}\nSprint goal: {{ $json.sprintGoal || 'not specified' }}\nVelocity notes: {{ $json.velocityNotes || 'not provided' }}\nTotal items: {{ $json.itemCount }}\n\nWent well:\n{{ $json.wentWell || 'none submitted' }}\n\nWent poorly:\n{{ $json.wentPoorly || 'none submitted' }}\n\nAction items (submitted):\n{{ $json.actionItems || 'none submitted' }}\n\nKudos:\n{{ $json.kudos || 'none submitted' }}\n\nBlockers:\n{{ $json.blockers || 'none submitted' }}\n\nReturn JSON:\n{\"retro_summary\":\"3-4 sentences: overall sprint narrative, what went well, what's recurring, key insight\",\"team_health\":\"green|yellow|red\",\"health_rationale\":\"why this health signal\",\"themes\":[{\"theme\":\"\",\"category\":\"process|technical|people|communication|tooling\",\"items_grouped\":[\"item texts that belong to this theme\"],\"proposed_action\":\"\",\"action_owner\":\"role not name\",\"due\":\"next sprint|this week|ongoing\"}],\"sprint_wins\":[\"specific things that went well worth calling out\"],\"recurring_issues\":[\"issues that appear to be systemic not one-off\"],\"kudos_highlights\":[\"genuine recognition worth sharing with the team\"],\"commitments\":[{\"commitment\":\"\",\"owner\":\"role\",\"due\":\"\",\"how_to_verify\":\"\"}],\"facilitator_notes\":\"what the team lead should discuss or follow up on before next sprint\"}","role":"user"}]}},"id":"d4e5f6g7h8-0017","name":"Claude Retro Synthesizer","type":"@n8n/n8n-nodes-langchain.lmChatAnthropic","typeVersion":1.3,"position":[1280,420]},{"parameters":{"jsCode":"const raw=$input.first().json.text||$input.first().json.content?.[0]?.text||'';let summary;try{summary=JSON.parse(raw.replace(/```json|```/g,'').trim());}catch(e){return[{json:{error:'Parse error'}}];}const req=$('Filter Sprint Items').first().json;summary._meta={teamName:req.teamName,sprintName:req.sprintName,itemCount:req.itemCount,replyEmail:req.replyEmail};return[{json:summary}];"},"id":"d4e5f6g7h8-0018","name":"Parse Summary","type":"n8n-nodes-base.code","typeVersion":2,"position":[1500,420]},{"parameters":{"jsCode":"const s=$input.first().json;const m=s._meta;function esc(t){return String(t||'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');}const pulseColors={green:'#16a34a',yellow:'#d97706',red:'#dc2626'};const pc=pulseColors[s.team_health]||'#6b7280';const catColors={process:'#2563eb',technical:'#dc2626',people:'#7c3aed',communication:'#d97706',tooling:'#6b7280'};const themeCards=(s.themes||[]).map(t=>{const cc=catColors[t.category]||'#6b7280';const items=(t.items_grouped||[]).map(i=>'<div style=\"font-size:12px;color:#374151;padding:2px 0\">\u2022 '+esc(i)+'</div>').join('');return '<div style=\"border:1px solid #e5e7eb;border-radius:6px;margin-bottom:8px;overflow:hidden\"><div style=\"background:#f8faff;padding:8px 14px;border-bottom:1px solid #e5e7eb;display:flex;justify-content:space-between;align-items:center\"><span style=\"font-size:13px;font-weight:700\">'+esc(t.theme)+'</span><span style=\"background:'+cc+'22;color:'+cc+';font-size:10px;font-weight:700;padding:1px 6px;border-radius:4px\">'+esc(t.category)+'</span></div><div style=\"padding:10px 14px\">'+items+'<div style=\"margin-top:8px;padding-top:6px;border-top:1px solid #e5e7eb\"><div style=\"font-size:12px;color:#2563eb\">\u2192 Action: '+esc(t.proposed_action)+'</div><div style=\"font-size:11px;color:#9ca3af\">Owner: '+esc(t.action_owner)+' \u00b7 Due: '+esc(t.due)+'</div></div></div></div>';}).join('');const commits=(s.commitments||[]).map(c=>'<tr style=\"border-bottom:1px solid #f3f4f6\"><td style=\"padding:8px 12px;font-size:13px\">'+esc(c.commitment)+'</td><td style=\"padding:8px 12px;font-size:12px;color:#6b7280\">'+esc(c.owner)+'</td><td style=\"padding:8px 12px;font-size:12px;color:#6b7280\">'+esc(c.due)+'</td><td style=\"padding:8px 12px;font-size:12px;color:#9ca3af\">'+esc(c.how_to_verify)+'</td></tr>').join('');const wins=(s.sprint_wins||[]).map(w=>'<div style=\"font-size:14px;padding:5px 0;border-bottom:1px solid #f0fdf4;color:#166534\">\u2713 '+esc(w)+'</div>').join('');const recurring=(s.recurring_issues||[]).map(r=>'<div style=\"font-size:14px;padding:5px 0;border-bottom:1px solid #fef2f2;color:#7f1d1d\">\u26a0 '+esc(r)+'</div>').join('');const kudosItems=(s.kudos_highlights||[]).map(k=>'<div style=\"font-size:14px;padding:5px 0;border-bottom:1px solid #f5f3ff;color:#6d28d9\">\u2605 '+esc(k)+'</div>').join('');const html='<!DOCTYPE html><html><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"></head><body style=\"margin:0;padding:16px;background:#f9fafb;font-family:sans-serif;color:#111\"><div style=\"max-width:740px;margin:0 auto\"><div style=\"background:#1e293b;color:#fff;padding:18px 26px;border-radius:10px 10px 0 0\"><div style=\"font-size:11px;text-transform:uppercase;color:#64748b\">Retrospective Summary</div><div style=\"font-size:18px;font-weight:700\">'+esc(m.teamName)+' \u00b7 '+esc(m.sprintName)+'</div><div style=\"font-size:13px;color:#94a3b8\">'+m.itemCount+' items synthesized</div></div><div style=\"background:'+pc+'15;padding:14px 26px;border:1px solid '+pc+'44;border-top:none;display:flex;align-items:flex-start;gap:14px\"><span style=\"background:'+pc+';color:#fff;font-size:13px;font-weight:700;padding:5px 14px;border-radius:10px;flex-shrink:0\">'+(s.team_health||'').toUpperCase()+'</span><div><p style=\"font-size:14px;line-height:1.65;color:#374151;margin:0 0 5px\">'+esc(s.retro_summary)+'</p><div style=\"font-size:13px;color:#6b7280\">'+esc(s.health_rationale)+'</div></div></div>'+(wins?'<div style=\"background:#f0fdf4;padding:12px 26px;border:1px solid #bbf7d0\"><div style=\"font-size:11px;font-weight:700;text-transform:uppercase;color:#15803d;margin-bottom:6px\">Sprint wins</div>'+wins+'</div>':'')+(themeCards?'<div style=\"background:#fff;padding:14px 26px;border:1px solid #e5e7eb;border-top:3px solid #f3f4f6\"><div style=\"font-size:11px;font-weight:700;text-transform:uppercase;color:#9ca3af;margin-bottom:8px\">Themes \u0026 actions</div>'+themeCards+'</div>':'')+(commits?'<div style=\"background:#fff;border:1px solid #e5e7eb;border-top:3px solid #f3f4f6\"><div style=\"font-size:11px;font-weight:700;text-transform:uppercase;color:#9ca3af;padding:10px 26px 0\">Commitments</div><table style=\"width:100%;border-collapse:collapse\"><thead><tr style=\"font-size:11px;text-transform:uppercase;color:#9ca3af\"><th style=\"padding:7px 12px;text-align:left\">Commitment</th><th style=\"padding:7px 12px;text-align:left\">Owner</th><th style=\"padding:7px 12px;text-align:left\">Due</th><th style=\"padding:7px 12px;text-align:left\">Verify by</th></tr></thead><tbody>'+commits+'</tbody></table></div>':'')+(recurring?'<div style=\"background:#fef2f2;padding:12px 26px;border:1px solid #fecaca\"><div style=\"font-size:11px;font-weight:700;text-transform:uppercase;color:#dc2626;margin-bottom:5px\">Recurring issues</div>'+recurring+'</div>':'')+(kudosItems?'<div style=\"background:#f5f3ff;padding:12px 26px;border:1px solid #ddd6fe\"><div style=\"font-size:11px;font-weight:700;text-transform:uppercase;color:#7c3aed;margin-bottom:5px\">Kudos</div>'+kudosItems+'</div>':'')+(s.facilitator_notes?'<div style=\"background:#fffbeb;padding:12px 26px;border:1px solid #fde68a\"><div style=\"font-size:11px;font-weight:700;text-transform:uppercase;color:#92400e;margin-bottom:5px\">Facilitator notes</div><div style=\"font-size:14px;color:#78350f\">'+esc(s.facilitator_notes)+'</div></div>':'')+'<div style=\"background:#1e293b;color:#475569;font-size:11px;padding:10px 26px;border-radius:0 0 10px 10px;text-align:center\">Retro \u00b7 '+esc(m.teamName)+' \u00b7 '+esc(m.sprintName)+'</div></div></body></html>';return[{json:{html,replyEmail:m.replyEmail,teamName:m.teamName,sprintName:m.sprintName,teamHealth:s.team_health,themeCount:(s.themes||[]).length,summary:s}}];"},"id":"d4e5f6g7h8-0019","name":"Build Summary Doc","type":"n8n-nodes-base.code","typeVersion":2,"position":[1720,420]},{"parameters":{"conditions":{"conditions":[{"id":"ce","leftValue":"={{ $json.replyEmail }}","rightValue":"","operator":{"type":"string","operation":"notEmpty"}}],"combinator":"and"}},"id":"d4e5f6g7h8-0020","name":"Has Email?","type":"n8n-nodes-base.if","typeVersion":2,"position":[1940,420]},{"parameters":{"fromEmail":"={{$env.FROM_EMAIL}}","toEmail":"={{$json.replyEmail}}","subject":"Retro summary: {{ $json.teamName }} {{ $json.sprintName }} — {{ $json.teamHealth.toUpperCase() }}","emailType":"html","message":"={{$json.html}}"},"id":"d4e5f6g7h8-0021","name":"Email Summary","type":"n8n-nodes-base.emailSend","typeVersion":2.1,"position":[2160,360],"credentials":{"smtp":{"id":"smtp-creds-01","name":"SMTP Account"}}},{"parameters":{"respondWith":"json","responseBody":"={{ { status: 'summarized', team: $json.teamName, sprint: $json.sprintName, health: $json.teamHealth, theme_count: $json.themeCount, emailed: $json.replyEmail ? true : false, summary: $json.summary } }}"},"id":"d4e5f6g7h8-0022","name":"Return Summary","type":"n8n-nodes-base.respondToWebhook","typeVersion":1,"position":[2160,500]}],"connections":{"Submit Item Webhook":{"main":[[{"node":"Validate Item","type":"main","index":0}]]},"Generate Summary Webhook":{"main":[[{"node":"Validate Summary Request","type":"main","index":0}]]},"Validate Item":{"main":[[{"node":"Item Valid?","type":"main","index":0}]]},"Item Valid?":{"main":[[{"node":"Save to Sheets","type":"main","index":0}],[{"node":"Return Item Error","type":"main","index":0}]]},"Save to Sheets":{"main":[[{"node":"Confirm Saved","type":"main","index":0}]]},"Validate Summary Request":{"main":[[{"node":"Summary Valid?","type":"main","index":0}]]},"Summary Valid?":{"main":[[{"node":"Read All Items","type":"main","index":0}],[{"node":"Return Summary Error","type":"main","index":0}]]},"Read All Items":{"main":[[{"node":"Filter Sprint Items","type":"main","index":0}]]},"Filter Sprint Items":{"main":[[{"node":"Claude Retro Synthesizer","type":"main","index":0}]]},"Claude Retro Synthesizer":{"main":[[{"node":"Parse Summary","type":"main","index":0}]]},"Parse Summary":{"main":[[{"node":"Build Summary Doc","type":"main","index":0}]]},"Build Summary Doc":{"main":[[{"node":"Has Email?","type":"main","index":0}]]},"Has Email?":{"main":[[{"node":"Email Summary","type":"main","index":0}],[{"node":"Return Summary","type":"main","index":0}]]},"Email Summary":{"main":[[{"node":"Return Summary","type":"main","index":0}]]}},"pinData":{},"settings":{"executionOrder":"v1","saveManualExecutions":true},"staticData":null,"tags":["agile","retrospective","team","engineering"],"triggerCount":0,"updatedAt":"2025-06-02T11:00:00.000Z","versionId":"v1.0.0"}
