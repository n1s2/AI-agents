{
  "name": "FLOOWBOX - Self-Updating RAG Knowledge Base",
  "meta": { "instanceId": "navtej-floowbox-n8n-2025" },
  "nodes": [
    { "id": "n1", "name": "New Document Webhook", "type": "n8n-nodes-base.webhook", "position": [240, 300], "parameters": { "path": "ingest-document", "httpMethod": "POST", "responseMode": "responseNode" }, "typeVersion": 2 },
    { "id": "n2", "name": "Extract Document", "type": "n8n-nodes-base.set", "position": [460, 300], "parameters": { "assignments": { "assignments": [ {"id":"ra1","name":"doc_url","type":"string","value":"={{ $json.url || '' }}"}, {"id":"ra2","name":"doc_text","type":"string","value":"={{ $json.text || '' }}"}, {"id":"ra3","name":"doc_title","type":"string","value":"={{ $json.title || 'Untitled' }}"}, {"id":"ra4","name":"doc_type","type":"string","value":"={{ $json.type || 'general' }}"}, {"id":"ra5","name":"source","type":"string","value":"={{ $json.source || 'manual' }}"} ] } }, "typeVersion": 3.4 },
    { "id": "n3", "name": "Fetch URL Content", "type": "n8n-nodes-base.httpRequest", "position": [680, 200], "parameters": { "url": "=https://r.jina.ai/{{ $json.doc_url }}", "authentication": "genericCredentialType", "genericAuthType": "httpHeaderAuth" }, "typeVersion": 4.2 },
    { "id": "n4", "name": "Has URL?", "type": "n8n-nodes-base.if", "position": [680, 360], "parameters": { "conditions": { "conditions": [{"leftValue": "={{ $json.doc_url }}", "rightValue": "", "operator": {"type": "string", "operation": "notEmpty"}}] } }, "typeVersion": 2.2 },
    { "id": "n5", "name": "Merge Content", "type": "n8n-nodes-base.set", "position": [900, 300], "parameters": { "assignments": { "assignments": [ {"id":"ra6","name":"full_content","type":"string","value":"={{ $('Fetch URL Content').item.json.data || $('Extract Document').item.json.doc_text }}"}, {"id":"ra7","name":"title","type":"string","value":"={{ $('Extract Document').item.json.doc_title }}"}, {"id":"ra8","name":"doc_type","type":"string","value":"={{ $('Extract Document').item.json.doc_type }}"} ] } }, "typeVersion": 3.4 },
    { "id": "n6", "name": "Clean and Chunk Text", "type": "n8n-nodes-base.code", "position": [1100, 300], "parameters": { "jsCode": "const text = $input.item.json.full_content || '';\nconst title = $input.item.json.title;\nconst docType = $input.item.json.doc_type;\nconst chunkSize = 500;\nconst overlap = 50;\nconst words = text.split(' ');\nconst chunks = [];\nfor (let i = 0; i < words.length; i += chunkSize - overlap) {\n  const chunk = words.slice(i, i + chunkSize).join(' ');\n  if (chunk.length > 100) {\n    chunks.push({ text: chunk, chunk_index: chunks.length, title, doc_type: docType, total_chunks: 0 });\n  }\n}\nchunks.forEach(c => c.total_chunks = chunks.length);\nreturn chunks.map(c => ({ json: c }));" }, "typeVersion": 2 },
    { "id": "n7", "name": "Generate Embeddings", "type": "n8n-nodes-base.httpRequest", "position": [1300, 300], "parameters": { "method": "POST", "url": "https://api.openai.com/v1/embeddings", "authentication": "genericCredentialType", "genericAuthType": "httpHeaderAuth", "sendBody": true, "specifyBody": "json", "jsonBody": "={\n  \"model\": \"text-embedding-3-small\",\n  \"input\": \"{{ $json.text }}\"\n}" }, "typeVersion": 4.2 },
    { "id": "n8", "name": "Upsert to Qdrant", "type": "n8n-nodes-base.httpRequest", "position": [1500, 300], "parameters": { "method": "PUT", "url": "=http://localhost:6333/collections/knowledge_base/points", "sendBody": true, "specifyBody": "json", "jsonBody": "={\n  \"points\": [{\n    \"id\": {{ Math.floor(Math.random() * 1000000) }},\n    \"vector\": {{ JSON.stringify($json.data[0].embedding) }},\n    \"payload\": {\n      \"text\": \"{{ $('Clean and Chunk Text').item.json.text }}\",\n      \"title\": \"{{ $('Clean and Chunk Text').item.json.title }}\",\n      \"doc_type\": \"{{ $('Clean and Chunk Text').item.json.doc_type }}\",\n      \"chunk_index\": {{ $('Clean and Chunk Text').item.json.chunk_index }},\n      \"ingested_at\": \"{{ $now.toISO() }}\"\n    }\n  }]\n}" }, "typeVersion": 4.2 },
    { "id": "n9", "name": "Log Ingestion", "type": "n8n-nodes-base.googleSheets", "position": [1700, 300], "parameters": { "operation": "appendOrUpdate", "documentId": "YOUR_SHEET_ID", "sheetName": "Ingestion Log", "fieldsUi": { "fieldValues": [ {"fieldId": "Date", "fieldValue": "={{ $now.toFormat('yyyy-MM-dd HH:mm') }}"}, {"fieldId": "Title", "fieldValue": "={{ $('Extract Document').item.json.doc_title }}"}, {"fieldId": "Chunks", "fieldValue": "={{ $('Clean and Chunk Text').item.json.total_chunks }}"}, {"fieldId": "Type", "fieldValue": "={{ $('Extract Document').item.json.doc_type }}"}, {"fieldId": "Source", "fieldValue": "={{ $('Extract Document').item.json.source }}"} ] } }, "typeVersion": 4.4 },
    { "id": "n10", "name": "Respond Success", "type": "n8n-nodes-base.respondToWebhook", "position": [1900, 300], "parameters": { "respondWith": "json", "responseBody": "={\n  \"status\": \"ingested\",\n  \"title\": \"{{ $('Extract Document').item.json.doc_title }}\",\n  \"chunks\": {{ $('Clean and Chunk Text').item.json.total_chunks }}\n}" }, "typeVersion": 1.1 },
    { "id": "n11", "name": "Sticky Note", "type": "n8n-nodes-base.stickyNote", "position": [220, 140], "parameters": { "content": "## FLOOWBOX - Self-Updating RAG Pipeline\nSend any document (URL or raw text) to the webhook.\nJina AI fetches URL content. Text is chunked with overlap.\nOpenAI generates embeddings (text-embedding-3-small).\nChunks upserted to Qdrant vector database.\nAll ingestions logged to Google Sheets.\n\nThe knowledge base updates itself — no manual re-indexing needed." }, "typeVersion": 1 }
  ],
  "connections": {
    "New Document Webhook": {"main": [[{"node": "Extract Document", "type": "main", "index": 0}]]},
    "Extract Document": {"main": [[{"node": "Has URL?", "type": "main", "index": 0}]]},
    "Has URL?": {"main": [[{"node": "Fetch URL Content", "type": "main", "index": 0}], [{"node": "Merge Content", "type": "main", "index": 0}]]},
    "Fetch URL Content": {"main": [[{"node": "Merge Content", "type": "main", "index": 0}]]},
    "Merge Content": {"main": [[{"node": "Clean and Chunk Text", "type": "main", "index": 0}]]},
    "Clean and Chunk Text": {"main": [[{"node": "Generate Embeddings", "type": "main", "index": 0}]]},
    "Generate Embeddings": {"main": [[{"node": "Upsert to Qdrant", "type": "main", "index": 0}]]},
    "Upsert to Qdrant": {"main": [[{"node": "Log Ingestion", "type": "main", "index": 0}]]},
    "Log Ingestion": {"main": [[{"node": "Respond Success", "type": "main", "index": 0}]]}
  },
  "active": false,
  "settings": {"executionOrder": "v1"}
}
