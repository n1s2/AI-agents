{"name":"Incident Communication Writer Agent","nodes":[{"parameters":{"httpMethod":"POST","path":"write-incident-comms","responseMode":"responseNode","options":{}},"id":"q8r9s1t2-0001","name":"Webhook","type":"n8n-nodes-base.webhook","typeVersion":2,"position":[200,320]},{"parameters":{"jsCode":"const body=$input.first().json.body;const required=['incident_title','incident_status','impact_description'];const missing=required.filter(f=>!body[f]);if(missing.length)return[{json:{valid:false,error:'Missing: '+missing.join(', ')}}];const statuses=['investigating','identified','monitoring','resolved'];const status=statuses.includes(body.incident_status)?body.incident_status:'investigating';const severities=['p1','p2','p3','p4'];const severity=severities.includes(body.severity?.toLowerCase())?body.severity.toLowerCase():'p2';const audiences=Array.isArray(body.audiences)?body.audiences:['customers','status_page','internal'];return[{json:{valid:true,incidentId:body.incident_id||('INC-'+Date.now()),incidentTitle:body.incident_title.trim(),incidentStatus:status,severity,startedAt:body.started_at||'',impactDescription:body.impact_description.trim().slice(0,600),affectedServices:Array.isArray(body.affected_services)?body.affected_services:(body.affected_services||'').split(',').map(s=>s.trim()).filter(Boolean),currentKnowledge:(body.current_knowledge||'').slice(0,800),resolution:(body.resolution||'').slice(0,500),eta:(body.eta||''),audiences,productName:(body.product_name||'').trim(),toneGuidance:(body.tone_guidance||'transparent and calm').slice(0,200),customerEmailList:body.customer_email_list||'',internalEmailList:body.internal_email_list||'',replyEmail:body.reply_email||null}}];"},"id":"q8r9s1t2-0002","name":"Validate Input","type":"n8n-nodes-base.code","typeVersion":2,"position":[420,320]},{"parameters":{"conditions":{"conditions":[{"id":"cv","leftValue":"={{ $json.valid }}","rightValue":true,"operator":{"type":"boolean","operation":"true"}}],"combinator":"and"}},"id":"q8r9s1t2-0003","name":"Valid?","type":"n8n-nodes-base.if","typeVersion":2,"position":[640,320]},{"parameters":{"respondWith":"json","responseBody":"={{ { error: $json.error, status: 400 } }}"},"id":"q8r9s1t2-0004","name":"Return Error","type":"n8n-nodes-base.respondToWebhook","typeVersion":1,"position":[860,480]},{"parameters":{"model":"claude-sonnet-4-20250514","options":{"temperature":0.4,"maxTokens":2500},"messages":{"values":[{"content":"You write incident communications for SaaS companies. Good incident comms: are honest without being alarmist; say what you know and acknowledge what you don't; avoid jargon; give users actionable workarounds where possible; are calibrated to the status (investigating is different from resolved); and maintain trust even when the news is bad. You write for multiple audiences simultaneously. Always respond in valid JSON only.","role":"system"},{"content":"Write incident communications.\n\nIncident: {{ $json.incidentId }} — {{ $json.incidentTitle }}\nStatus: {{ $json.incidentStatus }}\nSeverity: {{ $json.severity.toUpperCase() }}\nStarted: {{ $json.startedAt || 'unknown' }}\nProduct: {{ $json.productName || 'the product' }}\nTone: {{ $json.toneGuidance }}\n\nAffected services: {{ $json.affectedServices.join(', ') || 'not specified' }}\n\nImpact:\n{{ $json.impactDescription }}\n\nCurrent knowledge:\n{{ $json.currentKnowledge || 'under investigation' }}\n\nResolution (if known):\n{{ $json.resolution || 'not yet resolved' }}\n\nETA: {{ $json.eta || 'unknown' }}\n\nAudiences needed: {{ $json.audiences.join(', ') }}\n\nReturn JSON:\n{\"customer_email\":{\"subject\":\"\",\"body\":\"complete email body — clear, honest, not overly apologetic. Includes what happened, who's affected, what we're doing, ETA or next update time, workaround if any.\"},\"status_page_update\":{\"headline\":\"short status page headline under 80 chars\",\"body\":\"1-3 sentences. Plain language. Factual.\"},\"internal_update\":{\"subject\":\"\",\"body\":\"internal comms for support/CS team — includes technical details they need to help customers, what to tell customers who contact support, what NOT to say publicly yet\"},\"social_post\":\"optional: under 280 chars for Twitter/X if this is a public-facing incident\",\"what_not_to_say\":[\"phrases or commitments to avoid in this communication\"],\"next_update_guidance\":\"when and what to communicate next based on current status\"}","role":"user"}]}},"id":"q8r9s1t2-0005","name":"Claude Comms Writer","type":"@n8n/n8n-nodes-langchain.lmChatAnthropic","typeVersion":1.3,"position":[860,240]},{"parameters":{"jsCode":"const raw=$input.first().json.text||$input.first().json.content?.[0]?.text||'';let comms;try{comms=JSON.parse(raw.replace(/```json|```/g,'').trim());}catch(e){return[{json:{error:'Parse error'}}];}const input=$('Validate Input').first().json;comms._meta={incidentId:input.incidentId,incidentTitle:input.incidentTitle,incidentStatus:input.incidentStatus,severity:input.severity,productName:input.productName,audiences:input.audiences,customerEmailList:input.customerEmailList,internalEmailList:input.internalEmailList,replyEmail:input.replyEmail};return[{json:comms}];"},"id":"q8r9s1t2-0006","name":"Parse Comms","type":"n8n-nodes-base.code","typeVersion":2,"position":[1080,240]},{"parameters":{"jsCode":"const c=$input.first().json;const m=c._meta;function esc(s){return String(s||'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');}const statusColors={investigating:'#dc2626',identified:'#d97706',monitoring:'#2563eb',resolved:'#16a34a'};const sc=statusColors[m.incidentStatus]||'#6b7280';const sevColors={p1:'#dc2626',p2:'#ea580c',p3:'#d97706',p4:'#2563eb'};const sevc=sevColors[m.severity]||'#6b7280';const ce=c.customer_email||{};const sp=c.status_page_update||{};const iu=c.internal_update||{};const dontSay=(c.what_not_to_say||[]).map(d=>'<div style=\"font-size:13px;padding:5px 0;border-bottom:1px solid #fef2f2;color:#7f1d1d\">\u2717 '+esc(d)+'</div>').join('');const html='<!DOCTYPE html><html><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"></head><body style=\"margin:0;padding:16px;background:#f9fafb;font-family:sans-serif;color:#111\"><div style=\"max-width:720px;margin:0 auto\"><div style=\"background:#1e293b;color:#fff;padding:18px 26px;border-radius:10px 10px 0 0\"><div style=\"display:flex;gap:8px;align-items:center;margin-bottom:5px\"><span style=\"background:'+sevc+';color:#fff;font-size:11px;font-weight:700;padding:2px 8px;border-radius:6px\">'+m.severity.toUpperCase()+'</span><span style=\"background:'+sc+';color:#fff;font-size:11px;font-weight:700;padding:2px 8px;border-radius:6px\">'+esc(m.incidentStatus)+'</span></div><div style=\"font-size:18px;font-weight:700\">'+esc(m.incidentTitle)+'</div><div style=\"font-size:13px;color:#94a3b8;margin-top:3px\">'+esc(m.incidentId)+(m.productName?' \u00b7 '+esc(m.productName):'')+'</div></div>'+(sp.headline?'<div style=\"background:'+sc+'22;padding:14px 26px;border:1px solid '+sc+'44;border-top:none\"><div style=\"font-size:11px;font-weight:700;text-transform:uppercase;color:'+sc+';margin-bottom:4px\">Status page update</div><div style=\"font-size:15px;font-weight:700;margin-bottom:4px\">'+esc(sp.headline)+'</div><div style=\"font-size:14px;color:#374151\">'+esc(sp.body)+'</div></div>':'')+(ce.body?'<div style=\"background:#fff;padding:16px 26px;border:1px solid #e5e7eb;border-top:3px solid #f3f4f6\"><div style=\"font-size:11px;font-weight:700;text-transform:uppercase;color:#9ca3af;margin-bottom:6px\">Customer email</div><div style=\"font-size:13px;color:#6b7280;margin-bottom:8px\">Subject: <strong>'+esc(ce.subject)+'</strong></div><div style=\"background:#f9fafb;border:1px solid #e5e7eb;border-radius:6px;padding:14px;font-size:14px;line-height:1.75;white-space:pre-line\">'+esc(ce.body)+'</div></div>':'')+(iu.body?'<div style=\"background:#eff6ff;padding:16px 26px;border:1px solid #bfdbfe\"><div style=\"font-size:11px;font-weight:700;text-transform:uppercase;color:#1d4ed8;margin-bottom:6px\">Internal update (support team)</div><div style=\"font-size:13px;color:#1e40af;margin-bottom:8px\">Subject: <strong>'+esc(iu.subject)+'</strong></div><div style=\"background:#fff;border:1px solid #bfdbfe;border-radius:6px;padding:14px;font-size:14px;line-height:1.75;white-space:pre-line\">'+esc(iu.body)+'</div></div>':'')+(c.social_post?'<div style=\"background:#fff;padding:14px 26px;border:1px solid #e5e7eb;border-top:3px solid #f3f4f6\"><div style=\"font-size:11px;font-weight:700;text-transform:uppercase;color:#9ca3af;margin-bottom:5px\">Social / X post</div><div style=\"font-size:14px;color:#1da1f2;background:#f9fafb;padding:10px;border-radius:6px\">'+esc(c.social_post)+'</div></div>':'')+(dontSay?'<div style=\"background:#fef2f2;padding:14px 26px;border:1px solid #fecaca\"><div style=\"font-size:11px;font-weight:700;text-transform:uppercase;color:#dc2626;margin-bottom:7px\">Do NOT say</div>'+dontSay+'</div>':'')+(c.next_update_guidance?'<div style=\"background:#fffbeb;padding:12px 26px;border:1px solid #fde68a\"><div style=\"font-size:11px;font-weight:700;text-transform:uppercase;color:#92400e;margin-bottom:4px\">Next update guidance</div><div style=\"font-size:13px;color:#78350f\">'+esc(c.next_update_guidance)+'</div></div>':'')+'<div style=\"background:#1e293b;color:#475569;font-size:11px;padding:10px 26px;border-radius:0 0 10px 10px;text-align:center\">Incident Comms \u00b7 '+esc(m.incidentId)+'</div></div></body></html>';return[{json:{html,customerEmailList:m.customerEmailList,internalEmailList:m.internalEmailList,replyEmail:m.replyEmail,incidentTitle:m.incidentTitle,incidentStatus:m.incidentStatus,comms:c}}];"},"id":"q8r9s1t2-0007","name":"Build Comms Doc","type":"n8n-nodes-base.code","typeVersion":2,"position":[1300,240]},{"parameters":{"conditions":{"conditions":[{"id":"cce","leftValue":"={{ $json.customerEmailList }}","rightValue":"","operator":{"type":"string","operation":"notEmpty"}}],"combinator":"and"}},"id":"q8r9s1t2-0008","name":"Send to Customers?","type":"n8n-nodes-base.if","typeVersion":2,"position":[1520,180]},{"parameters":{"fromEmail":"={{$env.FROM_EMAIL}}","toEmail":"={{ $json.customerEmailList }}","subject":"={{ $json.comms.customer_email.subject }}","emailType":"text","message":"={{ $json.comms.customer_email.body }}"},"id":"q8r9s1t2-0009","name":"Email Customers","type":"n8n-nodes-base.emailSend","typeVersion":2.1,"position":[1740,120],"credentials":{"smtp":{"id":"smtp-creds-01","name":"SMTP Account"}}},{"parameters":{"conditions":{"conditions":[{"id":"cie","leftValue":"={{ $json.internalEmailList }}","rightValue":"","operator":{"type":"string","operation":"notEmpty"}}],"combinator":"and"}},"id":"q8r9s1t2-0010","name":"Send Internal?","type":"n8n-nodes-base.if","typeVersion":2,"position":[1520,320]},{"parameters":{"fromEmail":"={{$env.FROM_EMAIL}}","toEmail":"={{ $json.internalEmailList }}","subject":"={{ $json.comms.internal_update.subject }}","emailType":"text","message":"={{ $json.comms.internal_update.body }}"},"id":"q8r9s1t2-0011","name":"Email Internal","type":"n8n-nodes-base.emailSend","typeVersion":2.1,"position":[1740,280],"credentials":{"smtp":{"id":"smtp-creds-01","name":"SMTP Account"}}},{"parameters":{"conditions":{"conditions":[{"id":"cre","leftValue":"={{ $json.replyEmail }}","rightValue":"","operator":{"type":"string","operation":"notEmpty"}}],"combinator":"and"}},"id":"q8r9s1t2-0012","name":"Has Reply Email?","type":"n8n-nodes-base.if","typeVersion":2,"position":[1520,460]},{"parameters":{"fromEmail":"={{$env.FROM_EMAIL}}","toEmail":"={{$json.replyEmail}}","subject":"Incident comms: {{ $json.incidentTitle }} ({{ $json.incidentStatus }})","emailType":"html","message":"={{$json.html}}"},"id":"q8r9s1t2-0013","name":"Email Full Doc","type":"n8n-nodes-base.emailSend","typeVersion":2.1,"position":[1740,420],"credentials":{"smtp":{"id":"smtp-creds-01","name":"SMTP Account"}}},{"parameters":{"respondWith":"json","responseBody":"={{ { status: 'written', incident_id: $json.comms._meta.incidentId, incident_status: $json.incidentStatus, audiences_written: $json.comms._meta.audiences, comms: $json.comms } }}"},"id":"q8r9s1t2-0014","name":"Return Comms","type":"n8n-nodes-base.respondToWebhook","typeVersion":1,"position":[1960,320]}],"connections":{"Webhook":{"main":[[{"node":"Validate Input","type":"main","index":0}]]},"Validate Input":{"main":[[{"node":"Valid?","type":"main","index":0}]]},"Valid?":{"main":[[{"node":"Claude Comms Writer","type":"main","index":0}],[{"node":"Return Error","type":"main","index":0}]]},"Claude Comms Writer":{"main":[[{"node":"Parse Comms","type":"main","index":0}]]},"Parse Comms":{"main":[[{"node":"Build Comms Doc","type":"main","index":0}]]},"Build Comms Doc":{"main":[[{"node":"Send to Customers?","type":"main","index":0}],[{"node":"Send Internal?","type":"main","index":0}],[{"node":"Has Reply Email?","type":"main","index":0}]]},"Send to Customers?":{"main":[[{"node":"Email Customers","type":"main","index":0}],[]]},"Send Internal?":{"main":[[{"node":"Email Internal","type":"main","index":0}],[]]},"Has Reply Email?":{"main":[[{"node":"Email Full Doc","type":"main","index":0}],[{"node":"Return Comms","type":"main","index":0}]]},"Email Customers":{"main":[[{"node":"Return Comms","type":"main","index":0}]]},"Email Internal":{"main":[[{"node":"Return Comms","type":"main","index":0}]]},"Email Full Doc":{"main":[[{"node":"Return Comms","type":"main","index":0}]]}},"pinData":{},"settings":{"executionOrder":"v1","saveManualExecutions":true},"staticData":null,"tags":["incidents","communications","status-page","cx"],"triggerCount":0,"updatedAt":"2025-05-29T10:00:00.000Z","versionId":"v1.0.0"}
