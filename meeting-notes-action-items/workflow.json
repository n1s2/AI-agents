    },
    "OpenAI GPT-4o": {
      "ai_languageModel": [[{"node": "Extract Action Items", "type": "ai_languageModel", "index": 0}]]
    },
    "Prepare Email": {
      "main": [[{"node": "Send Summary Email", "type": "main", "index": 0}]]
    }
  },
