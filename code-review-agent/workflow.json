{
  "name": "FLOOWBOX - Code Review Agent (GitHub PR)",
  "meta": { "instanceId": "navtej-floowbox-n8n-2025" },
  "nodes": [
    { "id": "n1", "name": "GitHub PR Webhook", "type": "n8n-nodes-base.webhook", "position": [240, 300], "parameters": { "path": "github-pr-review", "httpMethod": "POST", "responseMode": "responseNode" }, "typeVersion": 2 },
    { "id": "n2", "name": "Filter PR Events", "type": "n8n-nodes-base.filter", "position": [460, 300], "parameters": { "conditions": { "conditions": [{"leftValue": "={{ $json.action }}", "rightValue": "opened", "operator": {"type": "string", "operation": "equals"}}] } }, "typeVersion": 2.2 },
    { "id": "n3", "name": "Extract PR Info", "type": "n8n-nodes-base.set", "position": [660, 300], "parameters": { "assignments": { "assignments": [ {"id":"cr1","name":"pr_number","type":"number","value":"={{ $json.pull_request.number }}"}, {"id":"cr2","name":"pr_title","type":"string","value":"={{ $json.pull_request.title }}"}, {"id":"cr3","name":"pr_body","type":"string","value":"={{ $json.pull_request.body || '' }}"}, {"id":"cr4","name":"repo","type":"string","value":"={{ $json.repository.full_name }}"}, {"id":"cr5","name":"author","type":"string","value":"={{ $json.pull_request.user.login }}"}, {"id":"cr6","name":"diff_url","type":"string","value":"={{ $json.pull_request.diff_url }}"}, {"id":"cr7","name":"files_changed","type":"number","value":"={{ $json.pull_request.changed_files }}"} ] } }, "typeVersion": 3.4 },
    { "id": "n4", "name": "Fetch PR Diff", "type": "n8n-nodes-base.httpRequest", "position": [860, 300], "parameters": { "url": "={{ $json.diff_url }}", "authentication": "genericCredentialType", "genericAuthType": "httpHeaderAuth", "options": { "response": { "response": { "fullResponse": false } } } }, "typeVersion": 4.2 },
    { "id": "n5", "name": "Truncate Diff", "type": "n8n-nodes-base.code", "position": [1060, 300], "parameters": { "jsCode": "const diff = $input.item.json.data || '';\nconst truncated = diff.length > 8000 ? diff.substring(0, 8000) + '\\n...[diff truncated]' : diff;\nreturn [{ json: { diff: truncated, pr: $('Extract PR Info').item.json } }];" }, "typeVersion": 2 },
    { "id": "n6", "name": "Review Code", "type": "@n8n/n8n-nodes-langchain.chainLlm", "position": [1260, 300], "parameters": { "promptType": "define", "text": "=Perform a thorough code review on this GitHub Pull Request.\n\nPR Title: {{ $json.pr.pr_title }}\nPR Description: {{ $json.pr.pr_body }}\nAuthor: {{ $json.pr.author }}\nFiles Changed: {{ $json.pr.files_changed }}\n\nDiff:\n{{ $json.diff }}\n\nReview for:\n1. Bugs and logic errors\n2. Security vulnerabilities (injection, auth issues, secrets in code)\n3. Performance issues (N+1 queries, unnecessary loops, memory leaks)\n4. Code style and readability\n5. Missing error handling\n6. Test coverage gaps\n7. Breaking changes\n\nReturn JSON:\n{\n  \"overall_verdict\": \"approve/request_changes/comment\",\n  \"summary\": \"2-3 sentence overall assessment\",\n  \"critical_issues\": [{\"file\": \"\", \"line\": \"\", \"issue\": \"\", \"suggestion\": \"\"}],\n  \"warnings\": [{\"file\": \"\", \"concern\": \"\", \"suggestion\": \"\"}],\n  \"praise\": [],\n  \"security_issues\": [],\n  \"performance_issues\": [],\n  \"missing_tests\": [],\n  \"review_comment\": \"full markdown comment to post on the PR\"\n}" }, "typeVersion": 1.5 },
    { "id": "n7", "name": "OpenAI GPT-4o", "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi", "position": [1260, 460], "parameters": { "model": "gpt-4o", "options": {} }, "typeVersion": 1 },
    { "id": "n8", "name": "Parse Review", "type": "n8n-nodes-base.code", "position": [1460, 300], "parameters": { "jsCode": "const raw = $input.item.json.text.replace(/```json|```/g,'').trim();\nreturn [{ json: { ...JSON.parse(raw), pr: $('Extract PR Info').item.json } }];" }, "typeVersion": 2 },
    { "id": "n9", "name": "Post Review to GitHub", "type": "n8n-nodes-base.httpRequest", "position": [1660, 200], "parameters": { "method": "POST", "url": "=https://api.github.com/repos/{{ $json.pr.repo }}/pulls/{{ $json.pr.pr_number }}/reviews", "authentication": "genericCredentialType", "genericAuthType": "httpHeaderAuth", "sendBody": true, "specifyBody": "json", "jsonBody": "={\n  \"body\": \"{{ $json.review_comment.replace(/\"/g, '\\\\\"').replace(/\\n/g, '\\\\n') }}\",\n  \"event\": \"{{ $json.overall_verdict === 'approve' ? 'APPROVE' : 'REQUEST_CHANGES' }}\"\n}" }, "typeVersion": 4.2 },
    { "id": "n10", "name": "Notify Slack", "type": "n8n-nodes-base.slack", "position": [1660, 400], "parameters": { "operation": "post", "channel": "#engineering", "text": "=🔍 *PR Review Complete — #{{ $json.pr.pr_number }}*\n\n*Title:* {{ $json.pr.pr_title }}\n*Author:* @{{ $json.pr.author }}\n*Verdict:* {{ $json.overall_verdict.toUpperCase() }}\n\n*Summary:* {{ $json.summary }}\n\n*Critical Issues:* {{ $json.critical_issues.length }}\n*Warnings:* {{ $json.warnings.length }}\n*Security Issues:* {{ $json.security_issues.length }}" }, "typeVersion": 2.2 },
    { "id": "n11", "name": "Respond to Webhook", "type": "n8n-nodes-base.respondToWebhook", "position": [1880, 300], "parameters": { "respondWith": "json", "responseBody": "{\"status\": \"review_posted\"}" }, "typeVersion": 1.1 },
    { "id": "n12", "name": "Sticky Note", "type": "n8n-nodes-base.stickyNote", "position": [220, 140], "parameters": { "content": "## FLOOWBOX - Code Review Agent\nTriggers on GitHub PR 'opened' events.\nFetches the full diff automatically.\nGPT-4o reviews for: bugs, security, performance, style, missing tests.\nPosts review comment directly on the PR via GitHub API.\nSlack notification with verdict summary.\n\nSetup: Add this webhook URL in GitHub repo → Settings → Webhooks." }, "typeVersion": 1 }
  ],
  "connections": {
    "GitHub PR Webhook": {"main": [[{"node": "Filter PR Events", "type": "main", "index": 0}]]},
    "Filter PR Events": {"main": [[{"node": "Extract PR Info", "type": "main", "index": 0}]]},
    "Extract PR Info": {"main": [[{"node": "Fetch PR Diff", "type": "main", "index": 0}]]},
    "Fetch PR Diff": {"main": [[{"node": "Truncate Diff", "type": "main", "index": 0}]]},
    "Truncate Diff": {"main": [[{"node": "Review Code", "type": "main", "index": 0}]]},
    "Review Code": {"main": [[{"node": "Parse Review", "type": "main", "index": 0}]]},
    "OpenAI GPT-4o": {"ai_languageModel": [[{"node": "Review Code", "type": "ai_languageModel", "index": 0}]]},
    "Parse Review": {"main": [[{"node": "Post Review to GitHub", "type": "main", "index": 0}], [{"node": "Notify Slack", "type": "main", "index": 0}]]},
    "Post Review to GitHub": {"main": [[{"node": "Respond to Webhook", "type": "main", "index": 0}]]}
  },
  "active": false,
  "settings": {"executionOrder": "v1"}
}
