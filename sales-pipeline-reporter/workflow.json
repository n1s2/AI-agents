{
  "name": "FLOOWBOX - Sales Pipeline Status Reporter",
  "meta": {
    "instanceId": "navtej-floowbox-n8n-2025"
  },
  "nodes": [
    {
      "id": "n1",
      "name": "Friday Schedule",
      "type": "n8n-nodes-base.scheduleTrigger",
      "position": [
        240,
        300
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "weeks",
              "triggerAtDay": [
                5
              ],
              "triggerAtHour": 17
            }
          ]
        }
      },
      "typeVersion": 1.2
    },
    {
      "id": "n2",
      "name": "Fetch All Deals",
      "type": "n8n-nodes-base.airtable",
      "position": [
        460,
        300
      ],
      "parameters": {
        "operation": "search",
        "baseId": "YOUR_AIRTABLE_BASE_ID",
        "tableId": "Deals",
        "filterByFormula": "NOT({Status} = 'Closed Lost')"
      },
      "typeVersion": 2.1
    },
    {
      "id": "n3",
      "name": "Aggregate Deals",
      "type": "n8n-nodes-base.aggregate",
      "position": [
        680,
        300
      ],
      "parameters": {
        "aggregate": "aggregateAllItemData",
        "options": {}
      },
      "typeVersion": 1
    },
    {
      "id": "n4",
      "name": "Calculate Pipeline Stats",
      "type": "n8n-nodes-base.code",
      "position": [
        900,
        300
      ],
      "parameters": {
        "jsCode": "\nconst deals = $input.item.json.data.map(d => d.fields);\nconst total_value = deals.reduce((s,d) => s + (parseFloat(d['Value'] || 0)), 0);\nconst by_stage = {};\ndeals.forEach(d => {\n  const stage = d['Stage'] || 'Unknown';\n  if (!by_stage[stage]) by_stage[stage] = {count:0, value:0};\n  by_stage[stage].count++;\n  by_stage[stage].value += parseFloat(d['Value'] || 0);\n});\nconst hot_deals = deals.filter(d => d['Stage'] === 'Proposal' || d['Stage'] === 'Negotiation');\nreturn [{ json: { total_deals: deals.length, total_value, by_stage, hot_deals, week: new Date().toISOString().split('T')[0] } }];\n"
      },
      "typeVersion": 2
    },
    {
      "id": "n5",
      "name": "Generate Pipeline Report",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "position": [
        1120,
        300
      ],
      "parameters": {
        "promptType": "define",
        "text": "=Write a weekly sales pipeline report for FLOOWBOX.\n\nPipeline Data:\n- Total deals: {{ $json.total_deals }}\n- Total pipeline value: \u20b9{{ $json.total_value }}\n- By stage: {{ JSON.stringify($json.by_stage) }}\n- Hot deals (Proposal/Negotiation): {{ JSON.stringify($json.hot_deals) }}\n\nWrite:\n1. This week's pipeline summary (2-3 sentences)\n2. Hot deals to focus on next week\n3. One specific action to take Monday morning\n\nTone: direct, like a sales manager briefing. Under 150 words."
      },
      "typeVersion": 1.5
    },
    {
      "id": "n6",
      "name": "OpenAI GPT-4o",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "position": [
        1120,
        460
      ],
      "parameters": {
        "model": "gpt-4o",
        "options": {}
      },
      "typeVersion": 1
    },
    {
      "id": "n7",
      "name": "Save to Sheets",
      "type": "n8n-nodes-base.googleSheets",
      "position": [
        1340,
        200
      ],
      "parameters": {
        "operation": "appendOrUpdate",
        "documentId": "YOUR_SHEET_ID",
        "sheetName": "Pipeline History",
        "fieldsUi": {
          "fieldValues": [
            {
              "fieldId": "Week",
              "fieldValue": "={{ $('Calculate Pipeline Stats').item.json.week }}"
            },
            {
              "fieldId": "Total Deals",
              "fieldValue": "={{ $('Calculate Pipeline Stats').item.json.total_deals }}"
            },
            {
              "fieldId": "Pipeline Value",
              "fieldValue": "={{ $('Calculate Pipeline Stats').item.json.total_value }}"
            },
            {
              "fieldId": "Report",
              "fieldValue": "={{ $json.text }}"
            }
          ]
        }
      },
      "typeVersion": 4.4
    },
    {
      "id": "n8",
      "name": "Send Report Email",
      "type": "n8n-nodes-base.emailSend",
      "position": [
        1340,
        380
      ],
      "parameters": {
        "toEmail": "navtej@floowbox.com",
        "fromEmail": "reports@floowbox.com",
        "subject": "=FLOOWBOX Pipeline Report \u2014 Week of {{ $('Calculate Pipeline Stats').item.json.week }}",
        "html": "=<h2>Pipeline Summary</h2>{{ $json.text.replace(/\\n/g,'<br>') }}<br><br><small>Total: \u20b9{{ $('Calculate Pipeline Stats').item.json.total_value }} across {{ $('Calculate Pipeline Stats').item.json.total_deals }} deals</small>",
        "options": {}
      },
      "typeVersion": 2.1
    },
    {
      "id": "ns1",
      "name": "Sticky Note",
      "type": "n8n-nodes-base.stickyNote",
      "position": [
        220,
        140
      ],
      "parameters": {
        "content": "## FLOOWBOX - Pipeline Reporter\nRuns every Friday at 5 PM.\nFetches all active deals from Airtable.\nCalculates pipeline value by stage.\nGPT-4o writes a focused weekly summary.\nSaves history to Sheets + emails report.\n\nRequires: Airtable Deals table with Stage, Value, Status fields."
      },
      "typeVersion": 1
    }
  ],
  "connections": {
    "Friday Schedule": {
      "main": [
        [
          {
            "node": "Fetch All Deals",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch All Deals": {
      "main": [
        [
          {
            "node": "Aggregate Deals",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Aggregate Deals": {
      "main": [
        [
          {
            "node": "Calculate Pipeline Stats",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Calculate Pipeline Stats": {
      "main": [
        [
          {
            "node": "Generate Pipeline Report",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Generate Pipeline Report": {
      "main": [
        [
          {
            "node": "Save to Sheets",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "OpenAI GPT-4o": {
      "ai_languageModel": [
        [
          {
            "node": "Generate Pipeline Report",
            "type": "ai_languageModel",
            "index": 0
          }
        ]
      ]
    },
    "Save to Sheets": {
      "main": [
        [
          {
            "node": "Send Report Email",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  }
}