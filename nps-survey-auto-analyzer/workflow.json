{
  "name": "FLOOWBOX - NPS Survey Auto-Analyzer",
  "meta": { "instanceId": "navtej-floowbox-n8n-2025" },
  "nodes": [
    { "id": "n1", "name": "NPS Response Webhook", "type": "n8n-nodes-base.webhook", "position": [240, 300], "parameters": { "path": "nps-response", "httpMethod": "POST", "responseMode": "responseNode" }, "typeVersion": 2 },
    { "id": "n2", "name": "Extract NPS Data", "type": "n8n-nodes-base.set", "position": [460, 300], "parameters": { "assignments": { "assignments": [ {"id":"i1","name":"customer_name","type":"string","value":"={{ $json.customer_name }}"}, {"id":"i2","name":"customer_email","type":"string","value":"={{ $json.email }}"}, {"id":"i3","name":"score","type":"number","value":"={{ $json.score }}"}, {"id":"i4","name":"comment","type":"string","value":"={{ $json.comment || '' }}"}, {"id":"i5","name":"plan","type":"string","value":"={{ $json.plan || 'Unknown' }}"}, {"id":"i6","name":"months_as_customer","type":"number","value":"={{ $json.months || 0 }}"} ] } }, "typeVersion": 3.4 },
    { "id": "n3", "name": "Classify Respondent", "type": "n8n-nodes-base.code", "position": [680, 300], "parameters": { "jsCode": "const score = $input.item.json.score;\nlet category, emoji;\nif (score >= 9) { category = 'promoter'; emoji = '🟢'; }\nelse if (score >= 7) { category = 'passive'; emoji = '🟡'; }\nelse { category = 'detractor'; emoji = '🔴'; }\nreturn [{ json: { ...$input.item.json, category, emoji } }];" }, "typeVersion": 2 },
    { "id": "n4", "name": "Analyze Comment with AI", "type": "@n8n/n8n-nodes-langchain.chainLlm", "position": [900, 300], "parameters": { "promptType": "define", "text": "=Analyze this NPS response and extract actionable insights.\n\nCustomer: {{ $json.customer_name }}\nPlan: {{ $json.plan }}\nMonths as customer: {{ $json.months_as_customer }}\nNPS Score: {{ $json.score }}/10 ({{ $json.category }})\nComment: {{ $json.comment || 'No comment provided' }}\n\nReturn JSON:\n{\n  \"sentiment_topics\": [\"what they mentioned positively or negatively\"],\n  \"product_feedback\": \"specific product feedback if any\",\n  \"churn_risk\": true/false,\n  \"expansion_opportunity\": true/false,\n  \"suggested_response\": \"personalized reply to send this customer\",\n  \"internal_action\": \"what the team should do based on this response\",\n  \"feature_request\": \"any feature request mentioned\"\n}" }, "typeVersion": 1.5 },
    { "id": "n5", "name": "OpenAI GPT-4o", "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi", "position": [900, 460], "parameters": { "model": "gpt-4o", "options": {} }, "typeVersion": 1 },
    { "id": "n6", "name": "Parse Analysis", "type": "n8n-nodes-base.code", "position": [1120, 300], "parameters": { "jsCode": "const raw = $input.item.json.text.replace(/```json|```/g,'').trim();\nconst analysis = JSON.parse(raw);\nreturn [{ json: { ...analysis, respondent: $('Classify Respondent').item.json } }];" }, "typeVersion": 2 },
    { "id": "n7", "name": "Route by Category", "type": "n8n-nodes-base.switch", "position": [1340, 300], "parameters": { "dataType": "string", "value1": "={{ $json.respondent.category }}", "rules": { "rules": [ {"value2": "detractor", "output": 0}, {"value2": "passive", "output": 1}, {"value2": "promoter", "output": 2} ] } }, "typeVersion": 3 },
    { "id": "n8", "name": "Detractor — Urgent Slack", "type": "n8n-nodes-base.slack", "position": [1560, 160], "parameters": { "operation": "post", "channel": "#nps-urgent", "text": "=🔴 *Detractor Alert — Score {{ $json.respondent.score }}/10*\n\n*Customer:* {{ $json.respondent.customer_name }} ({{ $json.respondent.plan }})\n*Comment:* {{ $json.respondent.comment }}\n\n*Churn Risk:* {{ $json.churn_risk ? 'YES' : 'No' }}\n*Internal Action:* {{ $json.internal_action }}\n*Suggested Reply:* {{ $json.suggested_response }}" }, "typeVersion": 2.2 },
    { "id": "n9", "name": "Promoter — Ask for Referral", "type": "n8n-nodes-base.emailSend", "position": [1560, 460], "parameters": { "toEmail": "={{ $json.respondent.customer_email }}", "fromEmail": "navtej@floowbox.com", "subject": "Thank you for the kind words!", "html": "=<p>Hi {{ $json.respondent.customer_name }},</p><p>{{ $json.suggested_response }}</p><p>Since you're enjoying FLOOWBOX, would you be open to referring us to a colleague? It means the world to a small team like ours.</p><p>— Navtej</p>", "options": {} }, "typeVersion": 2.1 },
    { "id": "n10", "name": "Log All to Google Sheets", "type": "n8n-nodes-base.googleSheets", "position": [1560, 600], "parameters": { "operation": "appendOrUpdate", "documentId": "YOUR_SHEET_ID", "sheetName": "NPS Responses", "fieldsUi": { "fieldValues": [ {"fieldId": "Date", "fieldValue": "={{ $now.toFormat('yyyy-MM-dd') }}"}, {"fieldId": "Customer", "fieldValue": "={{ $json.respondent.customer_name }}"}, {"fieldId": "Score", "fieldValue": "={{ $json.respondent.score }}"}, {"fieldId": "Category", "fieldValue": "={{ $json.respondent.category }}"}, {"fieldId": "Churn Risk", "fieldValue": "={{ $json.churn_risk }}"}, {"fieldId": "Expansion", "fieldValue": "={{ $json.expansion_opportunity }}"}, {"fieldId": "Feature Request", "fieldValue": "={{ $json.feature_request }}"}, {"fieldId": "Topics", "fieldValue": "={{ $json.sentiment_topics.join(', ') }}"} ] } }, "typeVersion": 4.4 },
    { "id": "n11", "name": "Respond to Webhook", "type": "n8n-nodes-base.respondToWebhook", "position": [1780, 380], "parameters": { "respondWith": "json", "responseBody": "{\"received\": true}" }, "typeVersion": 1.1 },
    { "id": "n12", "name": "Sticky Note", "type": "n8n-nodes-base.stickyNote", "position": [220, 140], "parameters": { "content": "## FLOOWBOX - NPS Auto-Analyzer\nEvery NPS response is instantly analyzed by GPT-4o.\nDetractors: urgent Slack alert + churn risk flag.\nPromoters: personalized thank you + referral ask.\nPassives: logged for follow-up campaign.\nAll responses logged to Google Sheets for trend analysis." }, "typeVersion": 1 }
  ],
  "connections": {
    "NPS Response Webhook": {"main": [[{"node": "Extract NPS Data", "type": "main", "index": 0}]]},
    "Extract NPS Data": {"main": [[{"node": "Classify Respondent", "type": "main", "index": 0}]]},
    "Classify Respondent": {"main": [[{"node": "Analyze Comment with AI", "type": "main", "index": 0}]]},
    "Analyze Comment with AI": {"main": [[{"node": "Parse Analysis", "type": "main", "index": 0}]]},
    "OpenAI GPT-4o": {"ai_languageModel": [[{"node": "Analyze Comment with AI", "type": "ai_languageModel", "index": 0}]]},
    "Parse Analysis": {"main": [[{"node": "Route by Category", "type": "main", "index": 0}]]},
    "Route by Category": {"main": [[{"node": "Detractor — Urgent Slack", "type": "main", "index": 0}], [{"node": "Log All to Google Sheets", "type": "main", "index": 0}], [{"node": "Promoter — Ask for Referral", "type": "main", "index": 0}]]},
    "Detractor — Urgent Slack": {"main": [[{"node": "Log All to Google Sheets", "type": "main", "index": 0}]]},
    "Promoter — Ask for Referral": {"main": [[{"node": "Log All to Google Sheets", "type": "main", "index": 0}]]},
    "Log All to Google Sheets": {"main": [[{"node": "Respond to Webhook", "type": "main", "index": 0}]]}
  },
  "active": false,
  "settings": {"executionOrder": "v1"}
}
