{"name":"Customer Escalation Triager Agent","nodes":[{"parameters":{"httpMethod":"POST","path":"triage-escalation","responseMode":"responseNode","options":{}},"id":"v5w6x7y8z9-0001","name":"Webhook","type":"n8n-nodes-base.webhook","typeVersion":2,"position":[200,320]},{"parameters":{"jsCode":"const body=$input.first().json.body;const required=['customer_name','escalation_details'];const missing=required.filter(f=>!body[f]);if(missing.length)return[{json:{valid:false,error:'Missing: '+missing.join(', ')}}];return[{json:{valid:true,customerName:body.customer_name.trim(),escalationDetails:body.escalation_details.trim().slice(0,2000),accountValue:parseFloat(body.account_value)||null,currency:body.currency||'USD',escalatedBy:body.escalated_by||'',customerContact:body.customer_contact||'',contactSeniority:body.contact_seniority||'',accountAgeM:parseInt(body.account_age_months)||null,priorEscalations:parseInt(body.prior_escalations)||0,contractRenewalDate:body.contract_renewal_date||'',csmAssigned:body.csm_assigned||'',executiveSponsorInvolved:body.executive_sponsor_involved===true||body.executive_sponsor_involved==='true',escalationEmail:body.escalation_email||'',replyEmail:body.reply_email||null}}];"},"id":"v5w6x7y8z9-0002","name":"Validate Input","type":"n8n-nodes-base.code","typeVersion":2,"position":[420,320]},{"parameters":{"conditions":{"conditions":[{"id":"cv","leftValue":"={{ $json.valid }}","rightValue":true,"operator":{"type":"boolean","operation":"true"}}],"combinator":"and"}},"id":"v5w6x7y8z9-0003","name":"Valid?","type":"n8n-nodes-base.if","typeVersion":2,"position":[640,320]},{"parameters":{"respondWith":"json","responseBody":"={{ { error: $json.error, status: 400 } }}"},"id":"v5w6x7y8z9-0004","name":"Return Error","type":"n8n-nodes-base.respondToWebhook","typeVersion":1,"position":[860,480]},{"parameters":{"model":"claude-sonnet-4-20250514","options":{"temperature":0.3,"maxTokens":2200},"messages":{"values":[{"content":"You triage customer escalations for CS and support leadership. You assess true severity based on business impact and churn risk (not just how upset the message sounds), identify who needs to be involved, and give a specific response plan with timing. You distinguish escalations that need executive involvement from ones that need fast operational fixes. Always respond in valid JSON only.","role":"system"},{"content":"Triage this customer escalation.\n\nCustomer: {{ $json.customerName }}\nAccount value: {{ $json.accountValue ? $json.currency + $json.accountValue : 'unknown' }}\nAccount age: {{ $json.accountAgeM ? $json.accountAgeM + ' months' : 'unknown' }}\nPrior escalations: {{ $json.priorEscalations }}\nContract renewal: {{ $json.contractRenewalDate || 'not specified' }}\nEscalated by: {{ $json.escalatedBy || 'not specified' }}\nCustomer contact: {{ $json.customerContact || 'not specified' }}{{ $json.contactSeniority ? ' ('+$json.contactSeniority+')' : '' }}\nExecutive sponsor already involved: {{ $json.executiveSponsorInvolved }}\nCSM assigned: {{ $json.csmAssigned || 'unassigned' }}\n\nEscalation details:\n{{ $json.escalationDetails }}\n\nReturn JSON:\n{\"true_severity\":\"critical|high|medium|low\",\"severity_rationale\":\"why this severity, considering business impact and churn risk not just tone\",\"churn_risk\":\"high|medium|low\",\"churn_risk_rationale\":\"\",\"who_needs_to_be_involved\":[{\"role\":\"\",\"why\":\"\",\"urgency\":\"immediate|within_hours|within_day\"}],\"response_plan\":{\"first_response_deadline\":\"specific time target\",\"first_response_approach\":\"what the first response should accomplish — not full resolution necessarily, but the right immediate move\",\"resolution_approach\":\"how to actually resolve the underlying issue\",\"follow_up_cadence\":\"\"},\"root_issue_category\":\"product_bug|missing_feature|support_quality|communication_breakdown|billing|onboarding_failure|other\",\"suggested_first_response_draft\":\"a specific first response the CSM/support lead can send or adapt\",\"internal_alert_summary\":\"a 2-sentence summary suitable for a Slack alert to leadership\",\"prevent_recurrence\":\"what would prevent this type of escalation from happening again\"}","role":"user"}]}},"id":"v5w6x7y8z9-0005","name":"Claude Escalation Triager","type":"@n8n/n8n-nodes-langchain.lmChatAnthropic","typeVersion":1.3,"position":[860,240]},{"parameters":{"jsCode":"const raw=$input.first().json.text||$input.first().json.content?.[0]?.text||'';let result;try{result=JSON.parse(raw.replace(/```json|```/g,'').trim());}catch(e){return[{json:{error:'Parse error'}}];}const input=$('Validate Input').first().json;result._meta={customerName:input.customerName,accountValue:input.accountValue,currency:input.currency,escalationEmail:input.escalationEmail,replyEmail:input.replyEmail};return[{json:result}];"},"id":"v5w6x7y8z9-0006","name":"Parse Result","type":"n8n-nodes-base.code","typeVersion":2,"position":[1080,240]},{"parameters":{"conditions":{"conditions":[{"id":"cesc","leftValue":"={{ ($json.true_severity==='critical'||$json.true_severity==='high') && $json._meta.escalationEmail }}","rightValue":true,"operator":{"type":"boolean","operation":"true"}}],"combinator":"and"}},"id":"v5w6x7y8z9-0007","name":"Needs Alert?","type":"n8n-nodes-base.if","typeVersion":2,"position":[1300,180]},{"parameters":{"fromEmail":"={{$env.FROM_EMAIL}}","toEmail":"={{ $json._meta.escalationEmail }}","subject":"🚨 Escalation: {{ $json._meta.customerName }} — {{ $json.true_severity.toUpperCase() }}","emailType":"text","message":"={{ $json.internal_alert_summary + '\\n\\nCustomer: ' + $json._meta.customerName + (($json._meta.accountValue)?' ('+$json._meta.currency+$json._meta.accountValue+')':'') + '\\nChurn risk: ' + $json.churn_risk + '\\n\\n' + $json.severity_rationale + '\\n\\nFirst response deadline: ' + $json.response_plan.first_response_deadline }}"},"id":"v5w6x7y8z9-0008","name":"Send Alert","type":"n8n-nodes-base.emailSend","typeVersion":2.1,"position":[1520,120],"credentials":{"smtp":{"id":"smtp-creds-01","name":"SMTP Account"}}},{"parameters":{"jsCode":"const r=$input.first().json;const m=r._meta;function esc(s){return String(s||'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');}const sevColors={critical:'#dc2626',high:'#ea580c',medium:'#d97706',low:'#16a34a'};const sc=sevColors[r.true_severity]||'#6b7280';const churnColors={high:'#dc2626',medium:'#d97706',low:'#16a34a'};const cc=churnColors[r.churn_risk]||'#6b7280';const involved=(r.who_needs_to_be_involved||[]).map(w=>{const uc={immediate:'#dc2626',within_hours:'#d97706',within_day:'#2563eb'}[w.urgency]||'#6b7280';return '<div style=\"border:1px solid #e5e7eb;border-radius:5px;padding:8px 12px;margin-bottom:6px;display:flex;justify-content:space-between;gap:10px\"><div><div style=\"font-size:13px;font-weight:700\">'+esc(w.role)+'</div><div style=\"font-size:12px;color:#6b7280\">'+esc(w.why)+'</div></div><span style=\"background:'+uc+'22;color:'+uc+';font-size:10px;font-weight:700;padding:2px 7px;border-radius:4px;flex-shrink:0;height:fit-content\">'+esc(w.urgency.replace(/_/g,' '))+'</span></div>';}).join('');const rp=r.response_plan||{};const html='<!DOCTYPE html><html><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"></head><body style=\"margin:0;padding:16px;background:#f9fafb;font-family:sans-serif;color:#111\"><div style=\"max-width:720px;margin:0 auto\"><div style=\"background:#1e293b;color:#fff;padding:18px 26px;border-radius:10px 10px 0 0\"><div style=\"font-size:11px;text-transform:uppercase;color:#64748b\">Escalation Triage</div><div style=\"font-size:18px;font-weight:700\">'+esc(m.customerName)+'</div>'+(m.accountValue?'<div style=\"font-size:13px;color:#94a3b8\">'+m.currency+m.accountValue.toLocaleString()+'</div>':'')+'</div><div style=\"background:'+sc+'15;padding:14px 26px;border:1px solid '+sc+'44;border-top:none;display:flex;gap:16px;align-items:center\"><span style=\"background:'+sc+';color:#fff;font-size:13px;font-weight:700;padding:5px 14px;border-radius:10px\">'+esc(r.true_severity.toUpperCase())+'</span><span style=\"background:'+cc+'22;color:'+cc+';font-size:12px;font-weight:700;padding:3px 10px;border-radius:8px\">Churn risk: '+esc(r.churn_risk)+'</span></div><div style=\"background:#fff;padding:12px 26px;border:1px solid #e5e7eb;border-top:none\"><p style=\"font-size:14px;color:#374151;margin:0 0 6px\">'+esc(r.severity_rationale)+'</p><p style=\"font-size:13px;color:#6b7280;margin:0\">'+esc(r.churn_risk_rationale)+'</p></div>'+(involved?'<div style=\"background:#fff;padding:14px 26px;border:1px solid #e5e7eb;border-top:3px solid #f3f4f6\"><div style=\"font-size:11px;font-weight:700;text-transform:uppercase;color:#9ca3af;margin-bottom:8px\">Who needs to be involved</div>'+involved+'</div>':'')+'<div style=\"background:#eff6ff;padding:14px 26px;border:1px solid #bfdbfe\"><div style=\"font-size:11px;font-weight:700;text-transform:uppercase;color:#1d4ed8;margin-bottom:6px\">Response plan</div><div style=\"font-size:13px;color:#1e40af;margin-bottom:4px\"><strong>Deadline:</strong> '+esc(rp.first_response_deadline)+'</div><div style=\"font-size:13px;color:#374151;margin-bottom:4px\">'+esc(rp.first_response_approach)+'</div><div style=\"font-size:13px;color:#374151\"><strong>Resolution:</strong> '+esc(rp.resolution_approach)+'</div></div>'+(r.suggested_first_response_draft?'<div style=\"background:#f9fafb;padding:14px 26px;border:1px solid #e5e7eb\"><div style=\"font-size:11px;font-weight:700;text-transform:uppercase;color:#9ca3af;margin-bottom:6px\">Suggested first response</div><div style=\"font-size:14px;color:#374151;line-height:1.7;white-space:pre-line;background:#fff;padding:10px;border-radius:6px\">'+esc(r.suggested_first_response_draft)+'</div></div>':'')+(r.prevent_recurrence?'<div style=\"background:#f0fdf4;padding:12px 26px;border:1px solid #bbf7d0\"><div style=\"font-size:11px;font-weight:700;text-transform:uppercase;color:#15803d;margin-bottom:4px\">Prevent recurrence</div><div style=\"font-size:13px;color:#166534\">'+esc(r.prevent_recurrence)+'</div></div>':'')+'<div style=\"background:#1e293b;color:#475569;font-size:11px;padding:10px 26px;border-radius:0 0 10px 10px;text-align:center\">Escalation Triage \u00b7 '+esc(m.customerName)+'</div></div></body></html>';return[{json:{html,replyEmail:m.replyEmail,customerName:m.customerName,severity:r.true_severity,result:r}}];"},"id":"v5w6x7y8z9-0009","name":"Build Triage Card","type":"n8n-nodes-base.code","typeVersion":2,"position":[1300,320]},{"parameters":{"conditions":{"conditions":[{"id":"cre","leftValue":"={{ $json.replyEmail }}","rightValue":"","operator":{"type":"string","operation":"notEmpty"}}],"combinator":"and"}},"id":"v5w6x7y8z9-0010","name":"Has Reply Email?","type":"n8n-nodes-base.if","typeVersion":2,"position":[1520,320]},{"parameters":{"fromEmail":"={{$env.FROM_EMAIL}}","toEmail":"={{$json.replyEmail}}","subject":"Escalation triage: {{ $json.customerName }} — {{ $json.severity.toUpperCase() }}","emailType":"html","message":"={{$json.html}}"},"id":"v5w6x7y8z9-0011","name":"Email Triage Card","type":"n8n-nodes-base.emailSend","typeVersion":2.1,"position":[1740,280],"credentials":{"smtp":{"id":"smtp-creds-01","name":"SMTP Account"}}},{"parameters":{"respondWith":"json","responseBody":"={{ { status: 'triaged', customer: $json.customerName, severity: $json.severity, emailed: $json.replyEmail ? true : false, result: $json.result } }}"},"id":"v5w6x7y8z9-0012","name":"Return Result","type":"n8n-nodes-base.respondToWebhook","typeVersion":1,"position":[1960,320]}],"connections":{"Webhook":{"main":[[{"node":"Validate Input","type":"main","index":0}]]},"Validate Input":{"main":[[{"node":"Valid?","type":"main","index":0}]]},"Valid?":{"main":[[{"node":"Claude Escalation Triager","type":"main","index":0}],[{"node":"Return Error","type":"main","index":0}]]},"Claude Escalation Triager":{"main":[[{"node":"Parse Result","type":"main","index":0}]]},"Parse Result":{"mai