{
  "name": "FLOOWBOX - Instagram Caption Generator (GPT-4o Vision)",
  "meta": { "instanceId": "navtej-floowbox-n8n-2025" },
  "nodes": [
    { "id": "n1", "name": "Image Upload Webhook", "type": "n8n-nodes-base.webhook", "position": [240, 300], "parameters": { "path": "instagram-caption", "httpMethod": "POST", "responseMode": "responseNode" }, "typeVersion": 2 },
    { "id": "n2", "name": "Set Post Config", "type": "n8n-nodes-base.set", "position": [460, 300], "parameters": { "assignments": { "assignments": [ {"id":"j1","name":"image_url","type":"string","value":"={{ $json.image_url }}"}, {"id":"j2","name":"brand_voice","type":"string","value":"={{ $json.brand_voice || 'professional, friendly, authentic' }}"}, {"id":"j3","name":"topic","type":"string","value":"={{ $json.topic || '' }}"}, {"id":"j4","name":"target_audience","type":"string","value":"={{ $json.audience || 'entrepreneurs and business owners' }}"}, {"id":"j5","name":"include_hashtags","type":"boolean","value":"={{ $json.hashtags !== false }}"}, {"id":"j6","name":"cta","type":"string","value":"={{ $json.cta || 'Follow for more' }}"} ] } }, "typeVersion": 3.4 },
    { "id": "n3", "name": "Analyze Image + Write Caption", "type": "n8n-nodes-base.httpRequest", "position": [680, 300], "parameters": { "method": "POST", "url": "https://api.openai.com/v1/chat/completions", "authentication": "genericCredentialType", "genericAuthType": "httpHeaderAuth", "sendBody": true, "specifyBody": "json", "jsonBody": "={\n  \"model\": \"gpt-4o\",\n  \"messages\": [{\n    \"role\": \"user\",\n    \"content\": [\n      {\"type\": \"image_url\", \"image_url\": {\"url\": \"{{ $json.image_url }}\"}},\n      {\"type\": \"text\", \"text\": \"You are a social media expert. Look at this image and write 3 Instagram caption variants.\\n\\nBrand voice: {{ $json.brand_voice }}\\nTopic hint: {{ $json.topic }}\\nTarget audience: {{ $json.target_audience }}\\nCTA to include: {{ $json.cta }}\\nInclude hashtags: {{ $json.include_hashtags }}\\n\\nReturn JSON:\\n{\\\"captions\\\": [{\\\"style\\\": \\\"engaging\\\", \\\"text\\\": \\\"\\\", \\\"hashtags\\\": []}, {\\\"style\\\": \\\"storytelling\\\", \\\"text\\\": \\\"\\\", \\\"hashtags\\\": []}, {\\\"style\\\": \\\"minimal\\\", \\\"text\\\": \\\"\\\", \\\"hashtags\\\": []}], \\\"image_description\\\": \\\"\\\", \\\"best_posting_time\\\": \\\"\\\"}\",\n      \"max_tokens\": 800\n    }\n  }]\n}" }, "typeVersion": 4.2 },
    { "id": "n4", "name": "Parse Captions", "type": "n8n-nodes-base.code", "position": [900, 300], "parameters": { "jsCode": "const content = $input.item.json.choices[0].message.content;\nconst raw = content.replace(/```json|```/g,'').trim();\nconst data = JSON.parse(raw);\nreturn [{ json: { ...data, config: $('Set Post Config').item.json } }];" }, "typeVersion": 2 },
    { "id": "n5", "name": "Save to Notion Content Calendar", "type": "n8n-nodes-base.notion", "position": [1120, 200], "parameters": { "resource": "page", "operation": "create", "databaseId": "YOUR_NOTION_CONTENT_DB", "title": "=IG Caption — {{ $now.toFormat('MMM dd yyyy') }}", "propertiesUi": { "propertyValues": [ {"key": "Status", "selectValue": "Draft"}, {"key": "Platform", "selectValue": "Instagram"}, {"key": "Caption Option 1", "textValue": "={{ $json.captions[0].text }}"}, {"key": "Caption Option 2", "textValue": "={{ $json.captions[1].text }}"} ] } }, "typeVersion": 2.2 },
    { "id": "n6", "name": "Respond with Captions", "type": "n8n-nodes-base.respondToWebhook", "position": [1120, 420], "parameters": { "respondWith": "json", "responseBody": "={{ JSON.stringify({ captions: $json.captions, image_description: $json.image_description, best_posting_time: $json.best_posting_time }) }}" }, "typeVersion": 1.1 },
    { "id": "n7", "name": "Sticky Note", "type": "n8n-nodes-base.stickyNote", "position": [220, 140], "parameters": { "content": "## FLOOWBOX - Instagram Caption Generator\nSend any image URL + brand config via webhook.\nGPT-4o Vision analyzes the image and writes 3 caption variants:\n- Engaging (hooks + emojis)\n- Storytelling (narrative style)\n- Minimal (clean, short)\nSaves all options to Notion content calendar." }, "typeVersion": 1 }
  ],
  "connections": {
    "Image Upload Webhook": {"main": [[{"node": "Set Post Config", "type": "main", "index": 0}]]},
    "Set Post Config": {"main": [[{"node": "Analyze Image + Write Caption", "type": "main", "index": 0}]]},
    "Analyze Image + Write Caption": {"main": [[{"node": "Parse Captions", "type": "main", "index": 0}]]},
    "Parse Captions": {"main": [[{"node": "Save to Notion Content Calendar", "type": "main", "index": 0}], [{"node": "Respond with Captions", "type": "main", "index": 0}]]}
  },
  "active": false,
  "settings": {"executionOrder": "v1"}
}
