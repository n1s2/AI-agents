{
  "name": "FLOOWBOX - Dynamic Pricing Optimizer",
  "meta": { "instanceId": "navtej-floowbox-n8n-2025" },
  "nodes": [
    { "id": "n1", "name": "Daily Pricing Check", "type": "n8n-nodes-base.scheduleTrigger", "position": [240, 300], "parameters": { "rule": { "interval": [{"field": "days", "triggerAtHour": 6}] } }, "typeVersion": 1.2 },
    { "id": "n2", "name": "Fetch Products to Price", "type": "n8n-nodes-base.googleSheets", "position": [460, 300], "parameters": { "operation": "readRows", "documentId": "YOUR_PRICING_SHEET_ID", "sheetName": "Products" }, "typeVersion": 4.4 },
    { "id": "n3", "name": "Split Products", "type": "n8n-nodes-base.splitOut", "position": [660, 300], "parameters": { "fieldToSplitOut": "", "options": {} }, "typeVersion": 1 },
    { "id": "n4", "name": "Limit to 10", "type": "n8n-nodes-base.limit", "position": [840, 300], "parameters": { "maxItems": 10 }, "typeVersion": 1 },
    { "id": "n5", "name": "Research Competitor Prices", "type": "n8n-nodes-base.httpRequest", "position": [1020, 300], "parameters": { "method": "POST", "url": "https://api.perplexity.ai/chat/completions", "authentication": "genericCredentialType", "genericAuthType": "httpHeaderAuth", "sendBody": true, "specifyBody": "json", "jsonBody": "={\n  \"model\": \"sonar\",\n  \"messages\": [{\"role\": \"user\", \"content\": \"What are the current prices for '{{ $json['Product Name'] }}' or equivalent products on Amazon, Flipkart, and competitor websites? Give me price range and most common price point. Be specific with numbers.\"}],\n  \"search_recency_filter\": \"week\"\n}" }, "typeVersion": 4.2 },
    { "id": "n6", "name": "Calculate Optimal Price", "type": "@n8n/n8n-nodes-langchain.chainLlm", "position": [1220, 300], "parameters": { "promptType": "define", "text": "=Recommend an optimal price for this product based on market data.\n\nProduct: {{ $('Fetch Products to Price').all()[0]?.json['Product Name'] || $json.product }}\nCurrent Price: ₹{{ $('Fetch Products to Price').all()[0]?.json['Current Price'] || 0 }}\nCost Price: ₹{{ $('Fetch Products to Price').all()[0]?.json['Cost Price'] || 0 }}\nCurrent Sales Velocity: {{ $('Fetch Products to Price').all()[0]?.json['Weekly Sales'] || 0 }} units/week\nTarget Margin: {{ $('Fetch Products to Price').all()[0]?.json['Target Margin'] || '30' }}%\n\nCompetitor Price Data:\n{{ $json.choices[0].message.content }}\n\nReturn JSON:\n{\n  \"current_price\": 0,\n  \"recommended_price\": 0,\n  \"price_change_direction\": \"increase/decrease/maintain\",\n  \"price_change_percent\": 0,\n  \"reasoning\": \"\",\n  \"competitor_range\": {\"min\": 0, \"max\": 0, \"median\": 0},\n  \"expected_margin\": 0,\n  \"risk\": \"low/medium/high\",\n  \"confidence\": \"high/medium/low\"\n}" }, "typeVersion": 1.5 },
    { "id": "n7", "name": "OpenAI GPT-4o", "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi", "position": [1220, 460], "parameters": { "model": "gpt-4o", "options": {} }, "typeVersion": 1 },
    { "id": "n8", "name": "Parse Recommendation", "type": "n8n-nodes-base.code", "position": [1420, 300], "parameters": { "jsCode": "const raw = $input.item.json.text.replace(/```json|```/g,'').trim();\nconst rec = JSON.parse(raw);\nreturn [{ json: { ...rec, product: $('Fetch Products to Price').all()[0]?.json['Product Name'] || 'Unknown' } }];" }, "typeVersion": 2 },
    { "id": "n9", "name": "Filter Significant Changes", "type": "n8n-nodes-base.filter", "position": [1620, 300], "parameters": { "conditions": { "conditions": [{"leftValue": "={{ Math.abs($json.price_change_percent) }}", "rightValue": 3, "operator": {"type": "number", "operation": "gte"}}] } }, "typeVersion": 2.2 },
    { "id": "n10", "name": "Log All Recommendations", "type": "n8n-nodes-base.googleSheets", "position": [1820, 200], "parameters": { "operation": "appendOrUpdate", "documentId": "YOUR_PRICING_SHEET_ID", "sheetName": "Pricing Log", "fieldsUi": { "fieldValues": [ {"fieldId": "Date", "fieldValue": "={{ $now.toFormat('yyyy-MM-dd') }}"}, {"fieldId": "Product", "fieldValue": "={{ $json.product }}"}, {"fieldId": "Current", "fieldValue": "={{ $json.current_price }}"}, {"fieldId": "Recommended", "fieldValue": "={{ $json.recommended_price }}"}, {"fieldId": "Direction", "fieldValue": "={{ $json.price_change_direction }}"}, {"fieldId": "Reasoning", "fieldValue": "={{ $json.reasoning }}"} ] } }, "typeVersion": 4.4 },
    { "id": "n11", "name": "Alert Significant Changes", "type": "n8n-nodes-base.slack", "position": [1820, 420], "parameters": { "operation": "post", "channel": "#pricing", "text": "=💰 *Pricing Recommendation — {{ $json.product }}*\n\n*Current:* ₹{{ $json.current_price }} → *Recommended:* ₹{{ $json.recommended_price }} ({{ $json.price_change_direction }} {{ $json.price_change_percent }}%)\n\n*Reason:* {{ $json.reasoning }}\n*Competitor range:* ₹{{ $json.competitor_range.min }} - ₹{{ $json.competitor_range.max }}\n*Risk:* {{ $json.risk }} | *Confidence:* {{ $json.confidence }}" }, "typeVersion": 2.2 },
    { "id": "n12", "name": "Sticky Note", "type": "n8n-nodes-base.stickyNote", "position": [220, 140], "parameters": { "content": "## FLOOWBOX - Dynamic Pricing Optimizer\nRuns daily at 6 AM.\nFetches product list from Google Sheets.\nPerplexity researches live competitor prices for each product.\nGPT-4o calculates optimal price based on: cost, margin target, competitor range, sales velocity.\nOnly alerts on significant changes (>3% difference).\nLogs all recommendations to pricing history sheet." }, "typeVersion": 1 }
  ],
  "connections": {
    "Daily Pricing Check": {"main": [[{"node": "Fetch Products to Price", "type": "main", "index": 0}]]},
    "Fetch Products to Price": {"main": [[{"node": "Split Products", "type": "main", "index": 0}]]},
    "Split Products": {"main": [[{"node": "Limit to 10", "type": "main", "index": 0}]]},
    "Limit to 10": {"main": [[{"node": "Research Competitor Prices", "type": "main", "index": 0}]]},
    "Research Competitor Prices": {"main": [[{"node": "Calculate Optimal Price", "type": "main", "index": 0}]]},
    "Calculate Optimal Price": {"main": [[{"node": "Parse Recommendation", "type": "main", "index": 0}]]},
    "OpenAI GPT-4o": {"ai_languageModel": [[{"node": "Calculate Optimal Price", "type": "ai_languageModel", "index": 0}]]},
    "Parse Recommendation": {"main": [[{"node": "Filter Significant Changes", "type": "main", "index": 0}]]},
    "Filter Significant Changes": {"main": [[{"node": "Log All Recommendations", "type": "main", "index": 0}], [{"node": "Alert Significant Changes", "type": "main", "index": 0}]]}
  },
  "active": false,
  "settings": {"executionOrder": "v1"}
}
