{
  "name": "FLOOWBOX - Shopify Sales AI Weekly Report",
  "meta": { "instanceId": "navtej-floowbox-n8n-2025" },
  "nodes": [
    { "id": "n1", "name": "Weekly Report Trigger", "type": "n8n-nodes-base.scheduleTrigger", "position": [240, 300], "parameters": { "rule": { "interval": [{"field": "weeks", "triggerAtDay": [1], "triggerAtHour": 8}] } }, "typeVersion": 1.2 },
    { "id": "n2", "name": "Set Shopify Config", "type": "n8n-nodes-base.set", "position": [460, 300], "parameters": { "assignments": { "assignments": [ {"id":"sh1","name":"shop_domain","type":"string","value":"your-store.myshopify.com"}, {"id":"sh2","name":"days_back","type":"number","value":7} ] } }, "typeVersion": 3.4 },
    { "id": "n3", "name": "Fetch This Week Orders", "type": "n8n-nodes-base.httpRequest", "position": [680, 200], "parameters": { "url": "=https://{{ $json.shop_domain }}/admin/api/2024-01/orders.json", "authentication": "genericCredentialType", "genericAuthType": "httpHeaderAuth", "sendQuery": true, "queryParameters": { "parameters": [ {"name": "status", "value": "any"}, {"name": "created_at_min", "value": "={{ $now.minus({days: 7}).toISO() }}"}, {"name": "limit", "value": "250"} ] } }, "typeVersion": 4.2 },
    { "id": "n4", "name": "Fetch Last Week Orders", "type": "n8n-nodes-base.httpRequest", "position": [680, 420], "parameters": { "url": "=https://{{ $('Set Shopify Config').item.json.shop_domain }}/admin/api/2024-01/orders.json", "authentication": "genericCredentialType", "genericAuthType": "httpHeaderAuth", "sendQuery": true, "queryParameters": { "parameters": [ {"name": "status", "value": "any"}, {"name": "created_at_min", "value": "={{ $now.minus({days: 14}).toISO() }}"}, {"name": "created_at_max", "value": "={{ $now.minus({days: 7}).toISO() }}"}, {"name": "limit", "value": "250"} ] } }, "typeVersion": 4.2 },
    { "id": "n5", "name": "Process Sales Data", "type": "n8n-nodes-base.code", "position": [900, 300], "parameters": { "jsCode": "const thisWeek = $('Fetch This Week Orders').item.json.orders || [];\nconst lastWeek = $('Fetch Last Week Orders').item.json.orders || [];\n\nconst summarize = (orders) => {\n  const revenue = orders.reduce((s,o) => s + parseFloat(o.total_price||0), 0);\n  const byProduct = {};\n  orders.forEach(o => {\n    (o.line_items||[]).forEach(item => {\n      const key = item.title;\n      byProduct[key] = (byProduct[key]||0) + item.quantity;\n    });\n  });\n  const topProducts = Object.entries(byProduct).sort((a,b)=>b[1]-a[1]).slice(0,5).map(([name,qty])=>({name,qty}));\n  return { revenue: revenue.toFixed(2), order_count: orders.length, top_products: topProducts, avg_order: orders.length ? (revenue/orders.length).toFixed(2) : 0 };\n};\n\nreturn [{ json: { this_week: summarize(thisWeek), last_week: summarize(lastWeek) } }];" }, "typeVersion": 2 },
    { "id": "n6", "name": "Generate Sales Analysis", "type": "@n8n/n8n-nodes-langchain.chainLlm", "position": [1100, 300], "parameters": { "promptType": "define", "text": "=Analyze this Shopify store's weekly sales data and provide actionable insights.\n\nThis Week:\n{{ JSON.stringify($json.this_week) }}\n\nLast Week:\n{{ JSON.stringify($json.last_week) }}\n\nReturn JSON:\n{\n  \"revenue_change_percent\": 0,\n  \"order_change_percent\": 0,\n  \"performance\": \"strong/good/average/weak\",\n  \"top_performing_products\": [],\n  \"underperforming_products\": [],\n  \"revenue_insights\": [],\n  \"recommended_actions\": [],\n  \"promotion_opportunities\": [],\n  \"inventory_flags\": [],\n  \"weekly_summary\": \"3-4 sentence plain English summary\"\n}" }, "typeVersion": 1.5 },
    { "id": "n7", "name": "OpenAI GPT-4o", "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi", "position": [1100, 460], "parameters": { "model": "gpt-4o", "options": {} }, "typeVersion": 1 },
    { "id": "n8", "name": "Parse Report", "type": "n8n-nodes-base.code", "position": [1300, 300], "parameters": { "jsCode": "const raw = $input.item.json.text.replace(/```json|```/g,'').trim();\nconst report = JSON.parse(raw);\nreturn [{ json: { ...report, sales_data: $('Process Sales Data').item.json } }];" }, "typeVersion": 2 },
    { "id": "n9", "name": "Send Email Report", "type": "n8n-nodes-base.emailSend", "position": [1500, 200], "parameters": { "toEmail": "store-owner@example.com", "fromEmail": "reports@floowbox.com", "subject": "=Weekly Sales Report — {{ $now.toFormat('MMM dd yyyy') }}", "html": "=<h2>Weekly Sales Summary</h2><p>{{ $json.weekly_summary }}</p><table border='1' cellpadding='8'><tr><th>Metric</th><th>This Week</th><th>Last Week</th><th>Change</th></tr><tr><td>Revenue</td><td>₹{{ $json.sales_data.this_week.revenue }}</td><td>₹{{ $json.sales_data.last_week.revenue }}</td><td>{{ $json.revenue_change_percent }}%</td></tr><tr><td>Orders</td><td>{{ $json.sales_data.this_week.order_count }}</td><td>{{ $json.sales_data.last_week.order_count }}</td><td>{{ $json.order_change_percent }}%</td></tr></table><h3>Recommended Actions</h3><ul>{{ $json.recommended_actions.map(a=>`<li>${a}</li>`).join('') }}</ul>", "options": {} }, "typeVersion": 2.1 },
    { "id": "n10", "name": "Post Slack Summary", "type": "n8n-nodes-base.slack", "position": [1500, 420], "parameters": { "operation": "post", "channel": "#ecommerce", "text": "=🛒 *Weekly Shopify Report — {{ $now.toFormat('MMM dd') }}*\n\n*Performance:* {{ $json.performance.toUpperCase() }}\n*Revenue:* ₹{{ $json.sales_data.this_week.revenue }} ({{ $json.revenue_change_percent > 0 ? '+' : '' }}{{ $json.revenue_change_percent }}% WoW)\n*Orders:* {{ $json.sales_data.this_week.order_count }}\n\n{{ $json.weekly_summary }}\n\n*Top actions:*\n{{ $json.recommended_actions.slice(0,3).map(a=>`• ${a}`).join('\\n') }}" }, "typeVersion": 2.2 },
    { "id": "n11", "name": "Sticky Note", "type": "n8n-nodes-base.stickyNote", "position": [220, 140], "parameters": { "content": "## FLOOWBOX - Shopify Weekly Sales Report\nRuns every Monday at 8 AM.\nFetches this week vs last week orders from Shopify API.\nCalculates: revenue, order count, top products, avg order value.\nGPT-4o analyzes performance + recommends actions.\nSends email report + Slack summary.\n\nReplace shop_domain with your store URL." }, "typeVersion": 1 }
  ],
  "connections": {
    "Weekly Report Trigger": {"main": [[{"node": "Set Shopify Config", "type": "main", "index": 0}]]},
    "Set Shopify Config": {"main": [[{"node": "Fetch This Week Orders", "type": "main", "index": 0}], [{"node": "Fetch Last Week Orders", "type": "main", "index": 0}]]},
    "Fetch This Week Orders": {"main": [[{"node": "Process Sales Data", "type": "main", "index": 0}]]},
    "Fetch Last Week Orders": {"main": [[{"node": "Process Sales Data", "type": "main", "index": 0}]]},
    "Process Sales Data": {"main": [[{"node": "Generate Sales Analysis", "type": "main", "index": 0}]]},
    "Generate Sales Analysis": {"main": [[{"node": "Parse Report", "type": "main", "index": 0}]]},
    "OpenAI GPT-4o": {"ai_languageModel": [[{"node": "Generate Sales Analysis", "type": "ai_languageModel", "index": 0}]]},
    "Parse Report": {"main": [[{"node": "Send Email Report", "type": "main", "index": 0}], [{"node": "Post Slack Summary", "type": "main", "index": 0}]]}
  },
