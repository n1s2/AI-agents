{
  "name": "FLOOWBOX - Customer Support Ticket Resolver",
  "meta": { "instanceId": "navtej-floowbox-n8n-2025" },
  "nodes": [
    { "id": "n1", "name": "Ticket Webhook", "type": "n8n-nodes-base.webhook", "position": [240, 300], "parameters": { "path": "support-ticket", "httpMethod": "POST", "responseMode": "responseNode" }, "typeVersion": 2 },
    { "id": "n2", "name": "Extract Ticket Data", "type": "n8n-nodes-base.set", "position": [460, 300], "parameters": { "assignments": { "assignments": [ {"id":"st1","name":"ticket_id","type":"string","value":"={{ $json.ticket_id || $now.toMillis() }}"}, {"id":"st2","name":"customer_email","type":"string","value":"={{ $json.email }}"}, {"id":"st3","name":"customer_name","type":"string","value":"={{ $json.name || 'Customer' }}"}, {"id":"st4","name":"subject","type":"string","value":"={{ $json.subject }}"}, {"id":"st5","name":"message","type":"string","value":"={{ $json.message }}"}, {"id":"st6","name":"plan","type":"string","value":"={{ $json.plan || 'standard' }}"} ] } }, "typeVersion": 3.4 },
    { "id": "n3", "name": "Fetch Knowledge Base", "type": "n8n-nodes-base.httpRequest", "position": [680, 200], "parameters": { "url": "http://localhost:6333/collections/knowledge_base/points/search", "method": "POST", "sendBody": true, "specifyBody": "json", "jsonBody": "={\n  \"vector\": [0],\n  \"limit\": 5,\n  \"with_payload\": true,\n  \"filter\": {\"must\": [{\"key\": \"doc_type\", \"match\": {\"value\": \"support\"}}]}\n}" }, "typeVersion": 4.2 },
    { "id": "n4", "name": "Classify and Resolve", "type": "@n8n/n8n-nodes-langchain.chainLlm", "position": [900, 300], "parameters": { "promptType": "define", "text": "=Resolve this customer support ticket.\n\nCustomer: {{ $json.customer_name }}\nPlan: {{ $json.plan }}\nSubject: {{ $json.subject }}\nMessage: {{ $json.message }}\n\nReturn JSON:\n{\n  \"category\": \"billing/technical/account/feature_request/complaint/other\",\n  \"priority\": \"urgent/high/normal/low\",\n  \"can_auto_resolve\": true,\n  \"resolution\": \"complete answer if auto-resolvable\",\n  \"escalate_to\": \"null or team name\",\n  \"tone\": \"empathetic and helpful\",\n  \"email_reply\": \"full email reply to send customer\"\n}" }, "typeVersion": 1.5 },
    { "id": "n5", "name": "OpenAI GPT-4o", "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi", "position": [900, 460], "parameters": { "model": "gpt-4o", "options": {} }, "typeVersion": 1 },
    { "id": "n6", "name": "Parse Resolution", "type": "n8n-nodes-base.code", "position": [1100, 300], "parameters": { "jsCode": "const raw = $input.item.json.text.replace(/```json|```/g,'').trim();\nconst res = JSON.parse(raw);\nreturn [{ json: { ...res, ticket: $('Extract Ticket Data').item.json } }];" }, "typeVersion": 2 },
    { "id": "n7", "name": "Auto-Resolve?", "type": "n8n-nodes-base.if", "position": [1300, 300], "parameters": { "conditions": { "conditions": [{"leftValue": "={{ $json.can_auto_resolve }}", "rightValue": true, "operator": {"type": "boolean", "operation": "equal"}}] } }, "typeVersion": 2.2 },
    { "id": "n8", "name": "Send Resolution Email", "type": "n8n-nodes-base.emailSend", "position": [1500, 180], "parameters": { "toEmail": "={{ $json.ticket.customer_email }}", "fromEmail": "support@floowbox.com", "subject": "=Re: {{ $json.ticket.subject }}", "html": "=<p>Hi {{ $json.ticket.customer_name }},</p><p>{{ $json.email_reply.replace(/\\n/g,'<br>') }}</p><p>Ticket ID: {{ $json.ticket.ticket_id }}</p>", "options": {} }, "typeVersion": 2.1 },
    { "id": "n9", "name": "Escalate to Slack", "type": "n8n-nodes-base.slack", "position": [1500, 420], "parameters": { "operation": "post", "channel": "#support", "text": "=🎫 *Support Ticket — Needs Human Review*\n*ID:* {{ $json.ticket.ticket_id }}\n*From:* {{ $json.ticket.customer_name }} ({{ $json.ticket.plan }})\n*Category:* {{ $json.category }} | *Priority:* {{ $json.priority }}\n*Subject:* {{ $json.ticket.subject }}\n*Message:* {{ $json.ticket.message }}\n\n*Draft reply ready — review before sending.*" }, "typeVersion": 2.2 },
    { "id": "n10", "name": "Log to Airtable", "type": "n8n-nodes-base.airtable", "position": [1700, 300], "parameters": { "operation": "create", "baseId": "YOUR_AIRTABLE_BASE_ID", "tableId": "Support Tickets", "fieldsUi": { "fieldValues": [{"fieldId": "Ticket ID", "fieldValue": "={{ $json.ticket.ticket_id }}"}, {"fieldId": "Category", "fieldValue": "={{ $json.category }}"}, {"fieldId": "Priority", "fieldValue": "={{ $json.priority }}"}, {"fieldId": "Auto Resolved", "fieldValue": "={{ $json.can_auto_resolve }}"}, {"fieldId": "Date", "fieldValue": "={{ $now.toFormat('yyyy-MM-dd') }}"}] } }, "typeVersion": 2.1 },
    { "id": "n11", "name": "Respond OK", "type": "n8n-nodes-base.respondToWebhook", "position": [1700, 480], "parameters": { "respondWith": "json", "responseBody": "{\"status\": \"received\"}" }, "typeVersion": 1.1 },
    { "id": "n12", "name": "Sticky Note", "type": "n8n-nodes-base.stickyNote", "position": [220, 140], "parameters": { "content": "## Customer Support Ticket Resolver\nIncoming ticket → GPT-4o classifies + drafts resolution.\nCan auto-resolve: sends email immediately.\nCannot auto-resolve: escalates to Slack with draft.\nAll tickets logged to Airtable." }, "typeVersion": 1 }
  ],
  "connections": {
    "Ticket Webhook": {"main": [[{"node": "Extract Ticket Data", "type": "main", "index": 0}]]},
    "Extract Ticket Data": {"main": [[{"node": "Classify and Resolve", "type": "main", "index": 0}]]},
    "Classify and Resolve": {"main": [[{"node": "Parse Resolution", "type": "main", "index": 0}]]},
    "OpenAI GPT-4o": {"ai_languageModel": [[{"node": "Classify and Resolve", "type": "ai_languageModel", "index": 0}]]},
    "Parse Resolution": {"main": [[{"node": "Auto-Resolve?", "type": "main", "index": 0}], [{"node": "Log to Airtable", "type": "main", "index": 0}]]},
    "Auto-Resolve?": {"main": [[{"node": "Send Resolution Email", "type": "main", "index": 0}], [{"node": "Escalate to Slack", "type": "main", "index": 0}]]},
    "Send Resolution Email": {"main": [[{"node": "Respond OK", "type": "main", "index": 0}]]},
    "Escalate to Slack": {"main": [[{"node": "Respond OK", "type": "main", "index": 0}]]}
  },
  "active": false,
  "settings": {"executionOrder": "v1"}
}
