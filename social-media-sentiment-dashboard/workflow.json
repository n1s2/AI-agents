{
  "name": "FLOOWBOX - Social Media Sentiment Dashboard",
  "meta": { "instanceId": "navtej-floowbox-n8n-2025" },
  "nodes": [
    { "id": "n1", "name": "Daily Report Trigger", "type": "n8n-nodes-base.scheduleTrigger", "position": [240, 300], "parameters": { "rule": { "interval": [{"field": "days", "triggerAtHour": 7}] } }, "typeVersion": 1.2 },
    { "id": "n2", "name": "Set Brand Config", "type": "n8n-nodes-base.set", "position": [460, 300], "parameters": { "assignments": { "assignments": [ {"id":"s1","name":"brand","type":"string","value":"FLOOWBOX"}, {"id":"s2","name":"keywords","type":"string","value":"FLOOWBOX, n8n automation, AI workflow, no-code AI"} ] } }, "typeVersion": 3.4 },
    { "id": "n3", "name": "Search Twitter Mentions", "type": "n8n-nodes-base.httpRequest", "position": [680, 180], "parameters": { "url": "https://api.twitter.com/2/tweets/search/recent", "authentication": "genericCredentialType", "genericAuthType": "oAuth2Api", "sendQuery": true, "queryParameters": { "parameters": [ {"name": "query", "value": "={{ $json.brand }} OR #n8nautomation lang:en -is:retweet"}, {"name": "max_results", "value": "50"}, {"name": "tweet.fields", "value": "public_metrics,created_at,author_id"} ] } }, "typeVersion": 4.2 },
    { "id": "n4", "name": "Search Reddit Mentions", "type": "n8n-nodes-base.httpRequest", "position": [680, 380], "parameters": { "url": "https://www.reddit.com/search.json", "sendQuery": true, "queryParameters": { "parameters": [ {"name": "q", "value": "={{ $json.keywords }}"}, {"name": "sort", "value": "new"}, {"name": "limit", "value": "25"}, {"name": "t", "value": "day"} ] } }, "typeVersion": 4.2 },
    { "id": "n5", "name": "Search News via Perplexity", "type": "n8n-nodes-base.httpRequest", "position": [680, 560], "parameters": { "method": "POST", "url": "https://api.perplexity.ai/chat/completions", "authentication": "genericCredentialType", "genericAuthType": "httpHeaderAuth", "sendBody": true, "specifyBody": "json", "jsonBody": "={\n  \"model\": \"sonar\",\n  \"messages\": [{\"role\": \"user\", \"content\": \"Find any news or blog mentions of FLOOWBOX or n8n automation tools in the last 24 hours. List title, source, and brief description.\"}],\n  \"search_recency_filter\": \"day\"\n}" }, "typeVersion": 4.2 },
    { "id": "n6", "name": "Aggregate All Sources", "type": "n8n-nodes-base.aggregate", "position": [900, 380], "parameters": { "aggregate": "aggregateAllItemData", "options": {} }, "typeVersion": 1 },
    { "id": "n7", "name": "Generate Sentiment Report", "type": "@n8n/n8n-nodes-langchain.chainLlm", "position": [1120, 380], "parameters": { "promptType": "define", "text": "=Analyze all social media data for FLOOWBOX and generate a daily sentiment report.\n\nTwitter Data: {{ JSON.stringify($('Search Twitter Mentions').item.json) }}\nReddit Data: {{ JSON.stringify($('Search Reddit Mentions').item.json.data?.children?.slice(0,10)) }}\nNews Mentions: {{ $('Search News via Perplexity').item.json.choices[0].message.content }}\n\nReturn JSON:\n{\n  \"date\": \"today\",\n  \"overall_sentiment\": \"positive/neutral/negative\",\n  \"sentiment_score\": 0,\n  \"total_mentions\": 0,\n  \"twitter_mentions\": 0,\n  \"reddit_mentions\": 0,\n  \"top_positive_mentions\": [{\"platform\": \"\", \"text\": \"\", \"reach\": 0}],\n  \"top_negative_mentions\": [{\"platform\": \"\", \"text\": \"\", \"concern\": \"\"}],\n  \"trending_topics\": [],\n  \"competitor_mentions\": [],\n  \"action_items\": [],\n  \"daily_summary\": \"2-3 sentence plain text\"\n}" }, "typeVersion": 1.5 },
    { "id": "n8", "name": "OpenAI GPT-4o", "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi", "position": [1120, 540], "parameters": { "model": "gpt-4o", "options": {} }, "typeVersion": 1 },
    { "id": "n9", "name": "Parse Report", "type": "n8n-nodes-base.code", "position": [1340, 380], "parameters": { "jsCode": "const raw = $input.item.json.text.replace(/```json|```/g,'').trim();\nreturn [{ json: JSON.parse(raw) }];" }, "typeVersion": 2 },
    { "id": "n10", "name": "Save to Google Sheets", "type": "n8n-nodes-base.googleSheets", "position": [1560, 240], "parameters": { "operation": "appendOrUpdate", "documentId": "YOUR_SHEET_ID", "sheetName": "Sentiment Log", "fieldsUi": { "fieldValues": [ {"fieldId": "Date", "fieldValue": "={{ $now.toFormat('yyyy-MM-dd') }}"}, {"fieldId": "Sentiment", "fieldValue": "={{ $json.overall_sentiment }}"}, {"fieldId": "Score", "fieldValue": "={{ $json.sentiment_score }}"}, {"fieldId": "Mentions", "fieldValue": "={{ $json.total_mentions }}"}, {"fieldId": "Summary", "fieldValue": "={{ $json.daily_summary }}"} ] } }, "typeVersion": 4.4 },
    { "id": "n11", "name": "Daily Slack Digest", "type": "n8n-nodes-base.slack", "position": [1560, 460], "parameters": { "operation": "post", "channel": "#brand-monitoring", "text": "=📊 *Daily Sentiment Report — {{ $now.toFormat('MMM dd') }}*\n\n*Overall:* {{ $json.overall_sentiment }} ({{ $json.sentiment_score }}/10)\n*Total mentions:* {{ $json.total_mentions }}\n\n{{ $json.daily_summary }}\n\n*Trending topics:* {{ $json.trending_topics.join(', ') }}\n*Action items:* {{ $json.action_items.join(' | ') }}" }, "typeVersion": 2.2 },
    { "id": "n12", "name": "Sticky Note", "type": "n8n-nodes-base.stickyNote", "position": [220, 140], "parameters": { "content": "## FLOOWBOX - Sentiment Dashboard\nRuns every morning at 7 AM.\nPulls data from Twitter API, Reddit, and Perplexity news search.\nGPT-4o analyzes all mentions and generates a unified sentiment score.\nLogs daily trend to Google Sheets.\nPosts digest to Slack." }, "typeVersion": 1 }
  ],
  "connections": {
    "Daily Report Trigger": {"main": [[{"node": "Set Brand Config", "type": "main", "index": 0}]]},
    "Set Brand Config": {"main": [[{"node": "Search Twitter Mentions", "type": "main", "index": 0}], [{"node": "Search Reddit Mentions", "type": "main", "index": 0}], [{"node": "Search News via Perplexity", "type": "main", "index": 0}]]},
    "Search Twitter Mentions": {"main": [[{"node": "Aggregate All Sources", "type": "main", "index": 0}]]},
    "Search Reddit Mentions": {"main": [[{"node": "Aggregate All Sources", "type": "main", "index": 0}]]},
    "Search News via Perplexity": {"main": [[{"node": "Aggregate All Sources", "type": "main", "index": 0}]]},
    "Aggregate All Sources": {"main": [[{"node": "Generate Sentiment Report", "type": "main", "index": 0}]]},
    "Generate Sentiment Report": {"main": [[{"node": "Parse Report", "type": "main", "index": 0}]]},
    "OpenAI GPT-4o": {"ai_languageModel": [[{"node": "Generate Sentiment Report", "type": "ai_languageModel", "index": 0}]]},
    "Parse Report": {"main": [[{"node": "Save to Google Sheets", "type": "main", "index": 0}], [{"node": "Daily Slack Digest", "type": "main", "index": 0}]]}
  },
  "active": false,
  "settings": {"executionOrder": "v1"}
}
