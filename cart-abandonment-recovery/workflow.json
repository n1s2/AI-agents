{
  "name": "FLOOWBOX - Cart Abandonment Recovery Email Sequence",
  "meta": { "instanceId": "navtej-floowbox-n8n-2025" },
  "nodes": [
    { "id": "n1", "name": "Cart Abandoned Webhook", "type": "n8n-nodes-base.webhook", "position": [240, 300], "parameters": { "path": "cart-abandoned", "httpMethod": "POST", "responseMode": "responseNode" }, "typeVersion": 2 },
    { "id": "n2", "name": "Set Cart Data", "type": "n8n-nodes-base.set", "position": [460, 300], "parameters": { "assignments": { "assignments": [ {"id":"ca1","name":"customer_name","type":"string","value":"={{ $json.customer_name }}"}, {"id":"ca2","name":"customer_email","type":"string","value":"={{ $json.email }}"}, {"id":"ca3","name":"cart_items","type":"string","value":"={{ JSON.stringify($json.items) }}"}, {"id":"ca4","name":"cart_value","type":"number","value":"={{ $json.total }}"}, {"id":"ca5","name":"cart_url","type":"string","value":"={{ $json.checkout_url }}"}, {"id":"ca6","name":"customer_history","type":"string","value":"={{ $json.previous_orders || 0 }}"} ] } }, "typeVersion": 3.4 },
    { "id": "n3", "name": "Write Email 1 — Gentle Reminder", "type": "@n8n/n8n-nodes-langchain.chainLlm", "position": [680, 300], "parameters": { "promptType": "define", "text": "=Write a cart abandonment recovery email (Email 1 of 3 — sent 1 hour after abandonment).\n\nCustomer: {{ $json.customer_name }}\nCart Items: {{ $json.cart_items }}\nCart Value: ₹{{ $json.cart_value }}\nPrevious Orders: {{ $json.customer_history }}\n\nEmail 1 rules:\n- Friendly, helpful tone — not pushy\n- Remind them what is in their cart\n- No discount yet — just a nudge\n- Short — under 80 words\n- Subject line: curiosity-based\n\nReturn JSON: {\"subject\": \"\", \"body\": \"\"}" }, "typeVersion": 1.5 },
    { "id": "n4", "name": "OpenAI GPT-4o", "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi", "position": [680, 460], "parameters": { "model": "gpt-4o", "options": {} }, "typeVersion": 1 },
    { "id": "n5", "name": "Send Email 1", "type": "n8n-nodes-base.emailSend", "position": [900, 300], "parameters": { "toEmail": "={{ $('Set Cart Data').item.json.customer_email }}", "fromEmail": "hello@your-store.com", "subject": "={{ JSON.parse($json.text.replace(/```json|```/g,'')).subject }}", "html": "={{ JSON.parse($json.text.replace(/```json|```/g,'')).body.replace(/\\n/g,'<br>') }}<br><br><a href='{{ $('Set Cart Data').item.json.cart_url }}'>Complete your purchase →</a>", "options": {} }, "typeVersion": 2.1 },
    { "id": "n6", "name": "Wait 23 Hours", "type": "n8n-nodes-base.wait", "position": [1100, 300], "parameters": { "amount": 23, "unit": "hours" }, "typeVersion": 1.1 },
    { "id": "n7", "name": "Write Email 2 — Social Proof", "type": "@n8n/n8n-nodes-langchain.chainLlm", "position": [1300, 300], "parameters": { "promptType": "define", "text": "=Write cart recovery Email 2 (24 hours after abandonment — add social proof).\n\nCustomer: {{ $('Set Cart Data').item.json.customer_name }}\nCart Items: {{ $('Set Cart Data').item.json.cart_items }}\nCart Value: ₹{{ $('Set Cart Data').item.json.cart_value }}\n\nEmail 2 rules:\n- Lead with social proof (other customers love this)\n- Mention scarcity if applicable\n- Still no discount — create urgency through demand\n- Under 100 words\n\nReturn JSON: {\"subject\": \"\", \"body\": \"\"}" }, "typeVersion": 1.5 },
    { "id": "n8", "name": "OpenAI GPT-4o 2", "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi", "position": [1300, 460], "parameters": { "model": "gpt-4o", "options": {} }, "typeVersion": 1 },
    { "id": "n9", "name": "Send Email 2", "type": "n8n-nodes-base.emailSend", "position": [1500, 300], "parameters": { "toEmail": "={{ $('Set Cart Data').item.json.customer_email }}", "fromEmail": "hello@your-store.com", "subject": "={{ JSON.parse($json.text.replace(/```json|```/g,'')).subject }}", "html": "={{ JSON.parse($json.text.replace(/```json|```/g,'')).body.replace(/\\n/g,'<br>') }}<br><br><a href='{{ $('Set Cart Data').item.json.cart_url }}'>Complete your purchase →</a>", "options": {} }, "typeVersion": 2.1 },
    { "id": "n10", "name": "Wait 48 Hours", "type": "n8n-nodes-base.wait", "position": [1700, 300], "parameters": { "amount": 48, "unit": "hours" }, "typeVersion": 1.1 },
    { "id": "n11", "name": "Write Email 3 — Final Offer", "type": "@n8n/n8n-nodes-langchain.chainLlm", "position": [1900, 300], "parameters": { "promptType": "define", "text": "=Write cart recovery Email 3 (72 hours — final offer with discount).\n\nCustomer: {{ $('Set Cart Data').item.json.customer_name }}\nCart Items: {{ $('Set Cart Data').item.json.cart_items }}\nCart Value: ₹{{ $('Set Cart Data').item.json.cart_value }}\nDiscount Code: COMEBACK10\n\nEmail 3 rules:\n- This is the last email — make it count\n- Offer 10% discount with code COMEBACK10\n- Create real urgency — expires in 24 hours\n- Under 80 words\n- Subject: direct, mentions discount\n\nReturn JSON: {\"subject\": \"\", \"body\": \"\"}" }, "typeVersion": 1.5 },
    { "id": "n12", "name": "OpenAI GPT-4o 3", "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi", "position": [1900, 460], "parameters": { "model": "gpt-4o", "options": {} }, "typeVersion": 1 },
    { "id": "n13", "name": "Send Email 3", "type": "n8n-nodes-base.emailSend", "position": [2100, 300], "parameters": { "toEmail": "={{ $('Set Cart Data').item.json.customer_email }}", "fromEmail": "hello@your-store.com", "subject": "={{ JSON.parse($json.text.replace(/```json|```/g,'')).subject }}", "html": "={{ JSON.parse($json.text.replace(/```json|```/g,'')).body.replace(/\\n/g,'<br>') }}<br><br><a href='{{ $('Set Cart Data').item.json.cart_url }}'>Claim your 10% off →</a>", "options": {} }, "typeVersion": 2.1 },
    { "id": "n14", "name": "Respond OK", "type": "n8n-nodes-base.respondToWebhook", "position": [460, 500], "parameters": { "respondWith": "json", "responseBody": "{\"status\": \"sequence_started\"}" }, "typeVersion": 1.1 },
    { "id": "n15", "name": "Sticky Note", "type": "n8n-nodes-base.stickyNote", "position": [220, 140], "parameters": { "content": "## FLOOWBOX - Cart Abandonment Recovery\n3-email sequence, all GPT-4o personalized:\n- Email 1 (1hr): Gentle reminder, no discount\n- Email 2 (24hr): Social proof + scarcity\n- Email 3 (72hr): 10% discount, 24hr expiry\n\nEach email written fresh using cart contents + customer name.\nConnect via Shopify/WooCommerce webhook on cart abandonment." }, "typeVersion": 1 }
  ],
