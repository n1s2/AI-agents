{"name":"Job Application Screener Agent","nodes":[{"parameters":{"httpMethod":"POST","path":"screen-application","responseMode":"responseNode","options":{}},"id":"c3d4e5f6-0001","name":"Webhook","type":"n8n-nodes-base.webhook","typeVersion":2,"position":[200,320]},{"parameters":{"jsCode":"const body=$input.first().json.body;const required=['job_title','job_description','applicant_name','resume_or_summary'];const missing=required.filter(f=>!body[f]);if(missing.length)return[{json:{valid:false,error:'Missing: '+missing.join(', ')}}];if(body.resume_or_summary.trim().length<50)return[{json:{valid:false,error:'resume_or_summary too short'}}];const mustHaves=Array.isArray(body.must_have_criteria)?body.must_have_criteria:(body.must_have_criteria||'').split('\\n').map(c=>c.trim()).filter(Boolean);const niceToHaves=Array.isArray(body.nice_to_have_criteria)?body.nice_to_have_criteria:(body.nice_to_have_criteria||'').split('\\n').map(c=>c.trim()).filter(Boolean);return[{json:{valid:true,jobTitle:body.job_title.trim(),jobDescription:body.job_description.trim().slice(0,2000),mustHaveCriteria:mustHaves,niceToHaveCriteria:niceToHaves,applicantName:body.applicant_name.trim(),applicantEmail:body.applicant_email||'',resumeOrSummary:body.resume_or_summary.trim().slice(0,3000),applicationNote:(body.application_note||'').slice(0,500),hiringManagerEmail:body.hiring_manager_email||'',replyEmail:body.reply_email||null,applicationId:body.application_id||('APP-'+Date.now())}}];"},"id":"c3d4e5f6-0002","name":"Validate Input","type":"n8n-nodes-base.code","typeVersion":2,"position":[420,320]},{"parameters":{"conditions":{"conditions":[{"id":"cv","leftValue":"={{ $json.valid }}","rightValue":true,"operator":{"type":"boolean","operation":"true"}}],"combinator":"and"}},"id":"c3d4e5f6-0003","name":"Valid?","type":"n8n-nodes-base.if","typeVersion":2,"position":[640,320]},{"parameters":{"respondWith":"json","responseBody":"={{ { error: $json.error, status: 400 } }}"},"id":"c3d4e5f6-0004","name":"Return Error","type":"n8n-nodes-base.respondToWebhook","typeVersion":1,"position":[860,480]},{"parameters":{"model":"claude-sonnet-4-20250514","options":{"temperature":0.3,"maxTokens":1800},"messages":{"values":[{"content":"You screen job applications for hiring managers. You assess candidate fit against specific criteria fairly and consistently. You identify genuine strengths and real gaps, distinguish between dealbreakers and development areas, and flag anything that needs human judgment. You never fabricate experience not present in the resume. Always respond in valid JSON only.","role":"system"},{"content":"Screen this job application.\n\nRole: {{ $json.jobTitle }}\n\nJob description:\n{{ $json.jobDescription }}\n\nMust-have criteria:\n{{ $json.mustHaveCriteria.map((c,i)=>(i+1)+'. '+c).join('\\n') || 'none specified — infer from job description' }}\n\nNice-to-have criteria:\n{{ $json.niceToHaveCriteria.map((c,i)=>(i+1)+'. '+c).join('\\n') || 'none specified' }}\n\nApplicant: {{ $json.applicantName }}\n\nResume / summary:\n{{ $json.resumeOrSummary }}\n\nApplication note from candidate:\n{{ $json.applicationNote || 'none provided' }}\n\nReturn JSON:\n{\"overall_recommendation\":\"strong_yes|yes|maybe|no|strong_no\",\"fit_score\":7,\"must_have_assessment\":[{\"criterion\":\"\",\"met\":true,\"evidence\":\"specific evidence from resume or null\",\"gap\":\"specific gap if not met or null\"}],\"nice_to_have_assessment\":[{\"criterion\":\"\",\"met\":false,\"evidence\":null}],\"strengths\":[\"specific genuine strengths — based only on what is in the resume\"],\"concerns\":[\"specific gaps or red flags\"],\"questions_for_interview\":[\"3-4 specific questions to probe gaps or verify claims\"],\"screening_summary\":\"2-3 sentences for the hiring manager — what makes this candidate worth pursuing or not\",\"flags_for_human_review\":[\"anything that needs human judgment — e.g. career gap explanation, unusual background, potential overqualification\"]}","role":"user"}]}},"id":"c3d4e5f6-0005","name":"Claude Application Screener","type":"@n8n/n8n-nodes-langchain.lmChatAnthropic","typeVersion":1.3,"position":[860,240]},{"parameters":{"jsCode":"const raw=$input.first().json.text||$input.first().json.content?.[0]?.text||'';let screening;try{screening=JSON.parse(raw.replace(/```json|```/g,'').trim());}catch(e){return[{json:{error:'Parse error'}}];}const input=$('Validate Input').first().json;screening._meta={applicationId:input.applicationId,jobTitle:input.jobTitle,applicantName:input.applicantName,applicantEmail:input.applicantEmail,hiringManagerEmail:input.hiringManagerEmail,replyEmail:input.replyEmail};return[{json:screening}];"},"id":"c3d4e5f6-0006","name":"Parse Screening","type":"n8n-nodes-base.code","typeVersion":2,"position":[1080,240]},{"parameters":{"operation":"appendOrUpdate","documentId":"={{$env.SCREENING_SHEET_ID}}","sheetName":"Applications","columns":{"mappingMode":"defineBelow","value":{"application_id":"={{ $json._meta.applicationId }}","screened_at":"={{ $now.toISO() }}","job_title":"={{ $json._meta.jobTitle }}","applicant_name":"={{ $json._meta.applicantName }}","applicant_email":"={{ $json._meta.applicantEmail }}","overall_recommendation":"={{ $json.overall_recommendation }}","fit_score":"={{ $json.fit_score }}","must_haves_met":"={{ ($json.must_have_assessment||[]).filter(m=>m.met).length }}/{{ ($json.must_have_assessment||[]).length }}","summary":"={{ $json.screening_summary }}"}},"options":{}},"id":"c3d4e5f6-0007","name":"Log to Sheet","type":"n8n-nodes-base.googleSheets","typeVersion":4.3,"position":[1300,180],"credentials":{"googleSheetsOAuth2Api":{"id":"google-creds-01","name":"Google Sheets"}}},{"parameters":{"jsCode":"const s=$input.first().json;const m=s._meta;function esc(t){return String(t||'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');}const recConfig={strong_yes:{color:'#16a34a',bg:'#f0fdf4',label:'Strong Yes'},yes:{color:'#2563eb',bg:'#eff6ff',label:'Yes'},maybe:{color:'#d97706',bg:'#fffbeb',label:'Maybe'},no:{color:'#ea580c',bg:'#fff7ed',label:'No'},strong_no:{color:'#dc2626',bg:'#fef2f2',label:'Strong No'}};const rc=recConfig[s.overall_recommendation]||recConfig.maybe;const mustRows=(s.must_have_assessment||[]).map(a=>'<tr style=\"border-bottom:1px solid #f3f4f6\"><td style=\"padding:8px 12px;font-size:13px\">'+esc(a.criterion)+'</td><td style=\"padding:8px 12px;text-align:center\">'+( a.met?'<span style=\"color:#16a34a;font-weight:700\">\u2713</span>':'<span style=\"color:#dc2626;font-weight:700\">\u2717</span>')+'</td><td style=\"padding:8px 12px;font-size:12px;color:#6b7280\">'+esc(a.evidence||a.gap||'')+'</td></tr>').join('');const strengths=(s.strengths||[]).map(st=>'<div style=\"font-size:14px;padding:5px 0;border-bottom:1px solid #f0fdf4;color:#166534\">\u2713 '+esc(st)+'</div>').join('');const concerns=(s.concerns||[]).map(c=>'<div style=\"font-size:14px;padding:5px 0;border-bottom:1px solid #fff7ed;color:#92400e\">\u2192 '+esc(c)+'</div>').join('');const questions=(s.questions_for_interview||[]).map((q,i)=>'<div style=\"font-size:14px;padding:7px 0;border-bottom:1px solid #f3f4f6\">'+(i+1)+'. '+esc(q)+'</div>').join('');const flags=(s.flags_for_human_review||[]).map(f=>'<div style=\"font-size:13px;padding:5px 0;color:#92400e\">\u26a0 '+esc(f)+'</div>').join('');const score=s.fit_score||5;const scoreColor=score>=7?'#16a34a':score>=5?'#d97706':'#dc2626';const html='<!DOCTYPE html><html><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"></head><body style=\"margin:0;padding:16px;background:#f9fafb;font-family:sans-serif;color:#111\"><div style=\"max-width:700px;margin:0 auto\"><div style=\"background:#1e293b;color:#fff;padding:18px 26px;border-radius:10px 10px 0 0\"><div style=\"font-size:11px;text-transform:uppercase;color:#64748b\">Application Screening \u00b7 '+esc(m.applicationId)+'</div><div style=\"font-size:18px;font-weight:700\">'+esc(m.applicantName)+'</div><div style=\"font-size:13px;color:#94a3b8\">'+esc(m.jobTitle)+'</div></div><div style=\"background:'+rc.bg+';padding:14px 26px;border:1px solid '+rc.color+'44;border-top:none;display:flex;align-items:center;gap:14px\"><div style=\"text-align:center;flex-shrink:0\"><div style=\"font-size:32px;font-weight:800;color:'+scoreColor+'\">'+score+'</div><div style=\"font-size:10px;color:#9ca3af\">/10</div></div><div><span style=\"background:'+rc.color+';color:#fff;font-size:12px;font-weight:700;padding:4px 14px;border-radius:12px\">'+rc.label+'</span><p style=\"font-size:14px;color:#374151;margin:8px 0 0;line-height:1.65\">'+esc(s.screening_summary)+'</p></div></div>'+(mustRows?'<div style=\"background:#fff;border:1px solid #e5e7eb;border-top:3px solid #f3f4f6\"><table style=\"width:100%;border-collapse:collapse\"><thead><tr style=\"background:#f9fafb;font-size:11px;text-transform:uppercase;color:#9ca3af\"><th style=\"padding:7px 12px;text-align:left\">Must-have criterion</th><th style=\"padding:7px 12px;text-align:center\">Met</th><th style=\"padding:7px 12px;text-align:left\">Evidence / gap</th></tr></thead><tbody>'+mustRows+'</tbody></table></div>':'')+'<div style=\"background:#fff;padding:14px 26px;border:1px solid #e5e7eb;border-top:3px solid #f3f4f6\"><div style=\"display:grid;grid-template-columns:1fr 1fr;gap:20px\">'+(strengths?'<div><div style=\"font-size:11px;font-weight:700;text-transform:uppercase;color:#16a34a;margin-bottom:7px\">Strengths</div>'+strengths+'</div>':'')+(concerns?'<div><div style=\"font-size:11px;font-weight:700;text-transform:uppercase;color:#c2410c;margin-bottom:7px\">Concerns</div>'+concerns+'</div>':'')+'</div></div>'+(questions?'<div style=\"background:#fff;padding:14px 26px;border:1px solid #e5e7eb;border-top:3px solid #f3f4f6\"><div style=\"font-size:11px;font-weight:700;text-transform:uppercase;color:#9ca3af;margin-bottom:7px\">Interview questions</div>'+questions+'</div>':'')+(flags?'<div style=\"background:#fffbeb;padding:12px 26px;border:1px solid #fde68a\"><div style=\"font-size:11px;font-weight:700;text-transform:uppercase;color:#92400e;margin-bottom:5px\">Flags for human review</div>'+flags+'</div>':'')+'<div style=\"background:#1e293b;color:#475569;font-size:11px;padding:10px 26px;border-radius:0 0 10px 10px;text-align:center\">Application Screener \u00b7 '+esc(m.applicantName)+' \u00b7 '+esc(m.jobTitle)+'</div></div></body></html>';return[{json:{html,replyEmail:m.replyEmail,hiringManagerEmail:m.hiringManagerEmail,applicantName:m.applicantName,jobTitle:m.jobTitle,recommendation:s.overall_recommendation,fitScore:s.fit_score,screening:s}}];"},"id":"c3d4e5f6-0008","name":"Build Screening Report","type":"n8n-nodes-base.code","typeVersion":2,"position":[1300,300]},{"parameters":{"jsCode":"const emails=[$json.hiringManagerEmail,$json.replyEmail].filter(Boolean);return[{json:{...$json,allRecipients:[...new Set(emails)]}}];"},"id":"c3d4e5f6-0009","name":"Collect Recipients","type":"n8n-nodes-base.code","typeVersion":2,"position":[1520,300]},{"parameters":{"conditions":{"conditions":[{"id":"ce","leftValue":"={{ $json.allRecipients.length > 0 }}","rightValue":true,"operator":{"type":"boolean","operation":"true"}}],"combinator":"and"}},"id":"c3d4e5f6-0010","name":"Has Recipients?","type":"n8n-nodes-base.if","typeVersion":2,"position":[1740,300]},{"parameters":{"fromEmail":"={{$env.FROM_EMAIL}}","toEmail":"={{ $json.allRecipients.join(',') }}","subject":"Application screening: {{ $json.applicantName }} — {{ $json.recommendation.replace(/_/g,' ') }} ({{ $json.fitScore }}/10) — {{ $json.jobTitle }}","emailType":"html","message":"={{$json.html}}"},"id":"c3d4e5f6-0011","name":"Email Screening","type":"n8n-nodes-base.emailSend","typeVersion":2.1,"position":[1960,240],"credentials":{"smtp":{"id":"smtp-creds-01","name":"SMTP Account"}}},{"parameters":{"respondWith":"json","responseBody":"={{ { status: 'screened', application_id: $json.screening._meta.applicationId, applicant: $json.applicantName, job: $json.jobTitle, recommendation: $json.recommendation, fit_score: $json.fitScore, emailed_to: $json.allRecipients, screening: $json.screening } }}"},"id":"c3d4e5f6-0012","name":"Return Screening","type":"n8n-nodes-base.respondToWebhook","typeVersion":1,"position":[1960,380]}],"connections":{"Webhook":{"main":[[{"node":"Validate Input","type":"main","index":0}]]},"Validate Input":{"main":[[{"node":"Valid?","type":"main","index":0}]]},"Valid?":{"main":[[{"node":"Claude Application Screener","type":"main","index":0}],[{"node":"Return Error","type":"main","index":0}]]},"Claude Application Screener":{"main":[[{"node":"Parse Screening","type":"main","index":0}]]},"Parse Screening":{"main":[[{"node":"Log to Sheet","type":"main","index":0}],[{"node":"Build Screening Report","type":"main","index":0}]]},"Log to Sheet":{"main":[[]]},"Build Screening Report":{"main":[[{"node":"Collect Recipients","type":"main","index":0}]]},"Collect Recipients":{"main":[[{"node":"Has Recipients?","type":"main","index":0}]]},"Has Recipients?":{"main":[[{"node":"Email Screening","type":"main","index":0}],[{"node":"Return Screening","type":"main","index":0}]]},"Email Screening":{"main":[[{"node":"Return Screening","type":"main","index":0}]]}},"pinData":{},"settings":{"executionOrder":"v1","saveManualExecutions":true},"staticData":null,"tags":["hr","recruiting","screening","hiring"],"triggerCount":0,"updatedAt":"2025-05-24T11:00:00.000Z","versionId":"v1.0.0"}
