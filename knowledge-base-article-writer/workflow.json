{"name":"Knowledge Base Article Writer Agent","nodes":[{"parameters":{"httpMethod":"POST","path":"write-kb-article","responseMode":"responseNode","options":{}},"id":"v4w5x6y7-0001","name":"Webhook","type":"n8n-nodes-base.webhook","typeVersion":2,"position":[200,320]},{"parameters":{"jsCode":"const body=$input.first().json.body;const required=['article_topic','product_name'];const missing=required.filter(f=>!body[f]);if(missing.length)return[{json:{valid:false,error:'Missing: '+missing.join(', ')}}];const types=['how_to','troubleshooting','concept_explainer','reference','faq','release_notes_summary','best_practices'];const articleType=types.includes(body.article_type)?body.article_type:'how_to';return[{json:{valid:true,articleTopic:body.article_topic.trim(),productName:body.product_name.trim(),articleType,targetAudience:body.target_audience||'end_users',expertNotes:(body.expert_notes||'').slice(0,3000),commonErrors:(body.common_errors||'').slice(0,800),relatedArticles:Array.isArray(body.related_articles)?body.related_articles:(body.related_articles||'').split(',').map(a=>a.trim()).filter(Boolean),featureDescription:(body.feature_description||'').slice(0,600),prerequisiteKnowledge:(body.prerequisite_knowledge||'').slice(0,300),searchKeywords:Array.isArray(body.search_keywords)?body.search_keywords:(body.search_keywords||'').split(',').map(k=>k.trim()).filter(Boolean),tone:body.tone||'clear_and_helpful',replyEmail:body.reply_email||null}}];"},"id":"v4w5x6y7-0002","name":"Validate Input","type":"n8n-nodes-base.code","typeVersion":2,"position":[420,320]},{"parameters":{"conditions":{"conditions":[{"id":"cv","leftValue":"={{ $json.valid }}","rightValue":true,"operator":{"type":"boolean","operation":"true"}}],"combinator":"and"}},"id":"v4w5x6y7-0003","name":"Valid?","type":"n8n-nodes-base.if","typeVersion":2,"position":[640,320]},{"parameters":{"respondWith":"json","responseBody":"={{ { error: $json.error, status: 400 } }}"},"id":"v4w5x6y7-0004","name":"Return Error","type":"n8n-nodes-base.respondToWebhook","typeVersion":1,"position":[860,480]},{"parameters":{"model":"claude-sonnet-4-20250514","options":{"temperature":0.45,"maxTokens":3000},"messages":{"values":[{"content":"You write knowledge base articles for SaaS products. Good KB articles lead with what the user is trying to accomplish, use numbered steps for procedures, include screenshot placeholders, anticipate common mistakes, and have scannable structure. Always respond in valid JSON only.","role":"system"},{"content":"Write a knowledge base article.\n\nProduct: {{ $json.productName }}\nTopic: {{ $json.articleTopic }}\nType: {{ $json.articleType.replace(/_/g,' ') }}\nAudience: {{ $json.targetAudience.replace(/_/g,' ') }}\nTone: {{ $json.tone.replace(/_/g,' ') }}\nPrerequisites: {{ $json.prerequisiteKnowledge || 'none' }}\nKeywords: {{ $json.searchKeywords.join(', ') || 'none' }}\n\nExpert notes:\n{{ $json.expertNotes || 'write from topic and type' }}\n\nFeature description:\n{{ $json.featureDescription || 'not provided' }}\n\nCommon errors:\n{{ $json.commonErrors || 'none specified' }}\n\nReturn JSON:\n{\"title\":\"action-oriented article title\",\"meta_description\":\"under 160 chars\",\"estimated_read_time_minutes\":3,\"article\":{\"intro\":\"2-3 sentences: what user can do after reading\",\"prerequisites\":[\"list of prerequisites\"],\"sections\":[{\"heading\":\"\",\"content\":\"section body with numbered steps where procedural\",\"screenshot_placeholder\":\"what screenshot goes here or null\",\"callout\":null}],\"common_mistakes\":[{\"mistake\":\"\",\"fix\":\"\"}],\"next_steps\":[\"what to do next\"],\"related_articles\":[\"title and brief description\"]},\"internal_notes\":\"reviewer accuracy notes and screenshot list\",\"suggested_tags\":[\"tags\"]}","role":"user"}]}},"id":"v4w5x6y7-0005","name":"Claude Article Writer","type":"@n8n/n8n-nodes-langchain.lmChatAnthropic","typeVersion":1.3,"position":[860,240]},{"parameters":{"jsCode":"const raw=$input.first().json.text||$input.first().json.content?.[0]?.text||'';let article;try{article=JSON.parse(raw.replace(/```json|```/g,'').trim());}catch(e){return[{json:{error:'Parse error'}}];}const input=$('Validate Input').first().json;article._meta={articleTopic:input.articleTopic,productName:input.productName,articleType:input.articleType,replyEmail:input.replyEmail};return[{json:article}];"},"id":"v4w5x6y7-0006","name":"Parse Article","type":"n8n-nodes-base.code","typeVersion":2,"position":[1080,240]},{"parameters":{"jsCode":"const a=$input.first().json;const m=a._meta;const art=a.article||{};function esc(s){return String(s||'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');}const typeColors={how_to:'#2563eb',troubleshooting:'#dc2626',concept_explainer:'#7c3aed',reference:'#6b7280',faq:'#16a34a',release_notes_summary:'#d97706',best_practices:'#0891b2'};const tc=typeColors[m.articleType]||'#6b7280';const prereqs=(art.prerequisites||[]).map(p=>'<div style=\"font-size:13px;padding:4px 0;border-bottom:1px solid #e5e7eb\">\u2713 '+esc(p)+'</div>').join('');const sections=(art.sections||[]).map(sec=>{const spBlock=sec.screenshot_placeholder?'<div style=\"background:#f3f4f6;border:2px dashed #d1d5db;border-radius:6px;padding:14px;text-align:center;margin:10px 0\"><div style=\"font-size:12px;color:#9ca3af\">\ud83d\uddbc\ufe0f Screenshot: '+esc(sec.screenshot_placeholder)+'</div></div>':'';const calloutBlock=sec.callout?'<div style=\"background:#eff6ff;border-left:3px solid #2563eb;padding:10px 14px;border-radius:0 4px 4px 0;margin:10px 0;font-size:13px;color:#1e40af\">'+esc(sec.callout)+'</div>':'';return '<div style=\"margin-bottom:24px\"><h2 style=\"font-size:16px;font-weight:700;margin:0 0 8px\">'+esc(sec.heading)+'</h2><p style=\"font-size:14px;line-height:1.75;color:#374151;margin:0 0 8px;white-space:pre-line\">'+esc(sec.content||'')+'</p>'+spBlock+calloutBlock+'</div>';}).join('');const mistakes=(art.common_mistakes||[]).map(e=>'<div style=\"border:1px solid #fecaca;border-radius:6px;padding:10px 14px;margin-bottom:8px;background:#fef2f2\"><div style=\"font-size:13px;font-weight:600;color:#dc2626;margin-bottom:3px\">\u274c '+esc(e.mistake)+'</div><div style=\"font-size:13px;color:#374151\">\u2705 '+esc(e.fix)+'</div></div>').join('');const nextSteps=(art.next_steps||[]).map((ns,i)=>'<div style=\"font-size:14px;padding:6px 0;border-bottom:1px solid #f0f9ff;color:#1e40af\">'+(i+1)+'. '+esc(ns)+'</div>').join('');const related=(art.related_articles||[]).map(r=>'<div style=\"font-size:13px;padding:5px 0;border-bottom:1px solid #f3f4f6\">\u2192 '+esc(r)+'</div>').join('');const tags=(a.suggested_tags||[]).map(t=>'<span style=\"background:#f3f4f6;color:#374151;font-size:11px;padding:2px 8px;border-radius:10px;margin-right:3px\">'+esc(t)+'</span>').join('');const html='<!DOCTYPE html><html><head><meta charset=\"utf-8\"></head><body style=\"margin:0;padding:16px;background:#f5f5f0;font-family:sans-serif;color:#111\"><div style=\"max-width:760px;margin:0 auto\"><div style=\"background:#1e293b;color:#fff;padding:18px 28px;border-radius:10px 10px 0 0\"><div style=\"display:flex;gap:8px;align-items:center;margin-bottom:6px\"><span style=\"background:'+tc+';color:#fff;font-size:11px;font-weight:700;padding:2px 8px;border-radius:6px\">'+esc(m.articleType.replace(/_/g,' '))+'</span>'+(a.estimated_read_time_minutes?'<span style=\"font-size:11px;color:#64748b\">'+a.estimated_read_time_minutes+' min read</span>':'')+'</div><h1 style=\"font-size:20px;font-weight:700;margin:0\">'+esc(a.title||m.articleTopic)+'</h1></div>'+(art.intro?'<div style=\"background:#fff;padding:16px 28px;border:1px solid #e5e7eb;border-top:none\"><p style=\"font-size:14px;line-height:1.75;color:#374151;margin:0\">'+esc(art.intro)+'</p></div>':'')+(prereqs?'<div style=\"background:#fff;padding:14px 28px;border:1px solid #e5e7eb;border-top:3px solid #f5f5f0\"><div style=\"font-size:12px;font-weight:700;text-transform:uppercase;color:#9ca3af;margin-bottom:7px\">Before you start</div>'+prereqs+'</div>':'')+'<div style=\"background:#fff;padding:20px 28px;border:1px solid #e5e7eb;border-top:3px solid #f5f5f0\">'+sections+'</div>'+(mistakes?'<div style=\"background:#fff;padding:14px 28px;border:1px solid #e5e7eb;border-top:3px solid #f5f5f0\"><div style=\"font-size:12px;font-weight:700;text-transform:uppercase;color:#9ca3af;margin-bottom:8px\">Common mistakes</div>'+mistakes+'</div>':'')+(nextSteps?'<div style=\"background:#eff6ff;padding:14px 28px;border:1px solid #bfdbfe\"><div style=\"font-size:12px;font-weight:700;text-transform:uppercase;color:#1d4ed8;margin-bottom:7px\">Next steps</div>'+nextSteps+'</div>':'')+(related?'<div style=\"background:#fff;padding:12px 28px;border:1px solid #e5e7eb\"><div style=\"font-size:12px;font-weight:700;text-transform:uppercase;color:#9ca3af;margin-bottom:6px\">Related</div>'+related+'</div>':'')+(tags?'<div style=\"background:#fff;padding:10px 28px;border:1px solid #e5e7eb\">'+tags+'</div>':'')+(a.internal_notes?'<div style=\"background:#fffbeb;padding:14px 28px;border:1px solid #fde68a\"><div style=\"font-size:11px;font-weight:700;text-transform:uppercase;color:#92400e;margin-bottom:5px\">Internal notes (remove before publishing)</div><div style=\"font-size:13px;color:#78350f\">'+esc(a.internal_notes)+'</div></div>':'')+'<div style=\"background:#1e293b;color:#475569;font-size:11px;padding:10px 28px;border-radius:0 0 10px 10px;text-align:center\">KB Article \u00b7 '+esc(m.productName)+'</div></div></body></html>';return[{json:{html,replyEmail:m.replyEmail,articleTopic:m.articleTopic,productName:m.productName,article:a}}];"},"id":"v4w5x6y7-0007","name":"Build Article","type":"n8n-nodes-base.code","typeVersion":2,"position":[1300,240]},{"parameters":{"conditions":{"conditions":[{"id":"ce","leftValue":"={{ $json.replyEmail }}","rightValue":"","operator":{"type":"string","operation":"notEmpty"}}],"combinator":"and"}},"id":"v4w5x6y7-0008","name":"Has Email?","type":"n8n-nodes-base.if","typeVersion":2,"position":[1520,240]},{"parameters":{"fromEmail":"={{$env.FROM_EMAIL}}","toEmail":"={{$json.replyEmail}}","subject":"KB article draft: {{ $json.articleTopic }} — {{ $json.productName }}","emailType":"html","message":"={{$json.html}}"},"id":"v4w5x6y7-0009","name":"Email Article","type":"n8n-nodes-base.emailSend","typeVersion":2.1,"position":[1740,180],"credentials":{"smtp":{"id":"smtp-creds-01","name":"SMTP Account"}}},{"parameters":{"respondWith":"json","responseBody":"={{ { status: 'written', topic: $json.articleTopic, product: $json.productName, emailed: $json.replyEmail ? true : false, article: $json.article } }}"},"id":"v4w5x6y7-0010","name":"Return Article","type":"n8n-nodes-base.respondToWebhook","typeVersion":1,"position":[1960,240]}],"connections":{"Webhook":{"main":[[{"node":"Validate Input","type":"main","index":0}]]},"Validate Input":{"main":[[{"node":"Valid?","type":"main","index":0}]]},"Valid?":{"main":[[{"node":"Claude Article Writer","type":"main","index":0}],[{"node":"Return Error","type":"main","index":0}]]},"Claude Article Writer":{"main":[[{"node":"Parse Article","type":"main","index":0}]]},"Parse Article":{"main":[[{"node":"Build Article","type":"main","index":0}]]},"Build Article":{"main":[[{"node":"Has Email?","type":"main","index":0}]]},"Has Email?":{"main":[[{"node":"Email Article","type":"main","index":0}],[{"node":"Return Article","type":"main","index":0}]]},"Email Article":{"main":[[{"node":"Return Article","type":"main","index":0}]]}},"pinData":{},"settings":{"executionOrder":"v1","saveManualExecutions":true},"staticData":null,"tags":["documentation","knowledge-base","support"],"triggerCount":0,"updatedAt":"2025-05-31T09:00:00.000Z","versionId":"v1.0.0"}
