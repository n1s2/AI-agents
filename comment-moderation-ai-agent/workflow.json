{
  "name": "FLOOWBOX - Comment Moderation AI Agent",
  "meta": { "instanceId": "navtej-floowbox-n8n-2025" },
  "nodes": [
    { "id": "n1", "name": "New Comment Webhook", "type": "n8n-nodes-base.webhook", "position": [240, 300], "parameters": { "path": "moderate-comment", "httpMethod": "POST", "responseMode": "responseNode" }, "typeVersion": 2 },
    { "id": "n2", "name": "Extract Comment Data", "type": "n8n-nodes-base.set", "position": [460, 300], "parameters": { "assignments": { "assignments": [ {"id":"cm1","name":"comment_text","type":"string","value":"={{ $json.comment }}"}, {"id":"cm2","name":"commenter","type":"string","value":"={{ $json.username || 'Anonymous' }}"}, {"id":"cm3","name":"platform","type":"string","value":"={{ $json.platform || 'website' }}"}, {"id":"cm4","name":"post_topic","type":"string","value":"={{ $json.post_topic || '' }}"}, {"id":"cm5","name":"comment_id","type":"string","value":"={{ $json.comment_id }}"} ] } }, "typeVersion": 3.4 },
    { "id": "n3", "name": "Moderate and Respond", "type": "@n8n/n8n-nodes-langchain.chainLlm", "position": [680, 300], "parameters": { "promptType": "define", "text": "=Moderate this comment and draft a response if appropriate.\n\nPlatform: {{ $json.platform }}\nPost Topic: {{ $json.post_topic }}\nCommenter: {{ $json.commenter }}\nComment: {{ $json.comment_text }}\n\nModeration rules:\n- APPROVE: genuine questions, opinions, positive engagement, constructive criticism\n- FLAG: potential spam, off-topic promotion, mildly aggressive but not abusive\n- REMOVE: hate speech, harassment, explicit spam, abusive language\n\nResponse guidelines (if APPROVE or FLAG):\n- Match the energy of the comment\n- Add genuine value — don't just say 'great point!'\n- Ask a follow-up question to continue conversation\n- Keep under 100 words\n- FLOOWBOX brand voice: expert but human, never corporate\n\nReturn JSON:\n{\n  \"decision\": \"approve/flag/remove\",\n  \"confidence\": \"high/medium/low\",\n  \"reason\": \"\",\n  \"category\": \"question/praise/criticism/spam/hate/promotion/discussion\",\n  \"should_respond\": true,\n  \"draft_response\": \"\",\n  \"priority\": \"urgent/normal/low\"\n}" }, "typeVersion": 1.5 },
    { "id": "n4", "name": "OpenAI GPT-4o", "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi", "position": [680, 460], "parameters": { "model": "gpt-4o", "options": {} }, "typeVersion": 1 },
    { "id": "n5", "name": "Parse Decision", "type": "n8n-nodes-base.code", "position": [900, 300], "parameters": { "jsCode": "const raw = $input.item.json.text.replace(/```json|```/g,'').trim();\nconst mod = JSON.parse(raw);\nreturn [{ json: { ...mod, comment: $('Extract Comment Data').item.json } }];" }, "typeVersion": 2 },
    { "id": "n6", "name": "Route by Decision", "type": "n8n-nodes-base.switch", "position": [1100, 300], "parameters": { "dataType": "string", "value1": "={{ $json.decision }}", "rules": { "rules": [{"value2": "approve", "output": 0}, {"value2": "flag", "output": 1}, {"value2": "remove", "output": 2}] } }, "typeVersion": 3 },
    { "id": "n7", "name": "Log to Airtable", "type": "n8n-nodes-base.airtable", "position": [1300, 200], "parameters": { "operation": "create", "baseId": "YOUR_AIRTABLE_BASE_ID", "tableId": "Comment Moderation", "fieldsUi": { "fieldValues": [ {"fieldId": "Comment ID", "fieldValue": "={{ $json.comment.comment_id }}"}, {"fieldId": "Platform", "fieldValue": "={{ $json.comment.platform }}"}, {"fieldId": "Commenter", "fieldValue": "={{ $json.comment.commenter }}"}, {"fieldId": "Comment Text", "fieldValue": "={{ $json.comment.comment_text }}"}, {"fieldId": "Decision", "fieldValue": "={{ $json.decision }}"}, {"fieldId": "Category", "fieldValue": "={{ $json.category }}"}, {"fieldId": "Draft Response", "fieldValue": "={{ $json.draft_response }}"} ] } }, "typeVersion": 2.1 },
    { "id": "n8", "name": "Flag Alert to Slack", "type": "n8n-nodes-base.slack", "position": [1300, 380], "parameters": { "operation": "post", "channel": "#moderation", "text": "=⚠️ *Comment Flagged — {{ $json.comment.platform }}*\n\n*From:* {{ $json.comment.commenter }}\n*Comment:* {{ $json.comment.comment_text }}\n*Reason:* {{ $json.reason }}\n\n*Draft Response:*\n{{ $json.draft_response }}\n\nApprove or remove manually." }, "typeVersion": 2.2 },
    { "id": "n9", "name": "Remove Alert to Slack", "type": "n8n-nodes-base.slack", "position": [1300, 560], "parameters": { "operation": "post", "channel": "#moderation", "text": "=🚫 *Comment REMOVED — {{ $json.comment.platform }}*\n\n*From:* {{ $json.comment.commenter }}\n*Comment:* {{ $json.comment.comment_text }}\n*Reason:* {{ $json.reason }}\n*Category:* {{ $json.category }}" }, "typeVersion": 2.2 },
    { "id": "n10", "name": "Respond to Webhook", "type": "n8n-nodes-base.respondToWebhook", "position": [1540, 380], "parameters": { "respondWith": "json", "responseBody": "={{ JSON.stringify({ decision: $json.decision, draft_response: $json.draft_response }) }}" }, "typeVersion": 1.1 },
    { "id": "n11", "name": "Sticky Note", "type": "n8n-nodes-base.stickyNote", "position": [220, 140], "parameters": { "content": "## FLOOWBOX - Comment Moderation Agent\nTriggered on every new comment (webhook).\nGPT-4o classifies: question/praise/criticism/spam/hate.\nDecision: approve / flag / remove.\nDrafts a response for approved and flagged comments.\nRemove/flag decisions alert #moderation Slack channel.\nAll moderation decisions logged to Airtable.\n\nNever auto-removes — human confirms all removals." }, "typeVersion": 1 }
  ],
  "connections": {
    "New Comment Webhook": {"main": [[{"node": "Extract Comment Data", "type": "main", "index": 0}]]},
    "Extract Comment Data": {"main": [[{"node": "Moderate and Respond", "type": "main", "index": 0}]]},
    "Moderate and Respond": {"main": [[{"node": "Parse Decision", "type": "main", "index": 0}]]},
    "OpenAI GPT-4o": {"ai_languageModel": [[{"node": "Moderate and Respond", "type": "ai_languageModel", "index": 0}]]},
    "Parse Decision": {"main": [[{"node": "Route by Decision", "type": "main", "index": 0}], [{"node": "Log to Airtable", "type": "main", "index": 0}]]},
    "Route by Decision": {"main": [[{"node": "Respond to Webhook", "type": "main", "index": 0}], [{"node": "Flag Alert to Slack", "type": "main", "index": 0}], [{"node": "Remove Alert to Slack", "type": "main", "index": 0}]]},
    "Flag Alert to Slack": {"main": [[{"node": "Respond to Webhook", "type": "main", "index": 0}]]},
    "Remove Alert to Slack": {"main": [[{"node": "Respond to Webhook", "type": "main", "index": 0}]]}
  },
  "active": false,
  "settings": {"executionOrder": "v1"}
}
