{"name":"Team Retro Facilitator Agent","nodes":[{"parameters":{"httpMethod":"POST","path":"submit-retro-item","responseMode":"responseNode","options":{}},"id":"z4c7f1k3-0001","name":"Webhook - Submit Item","type":"n8n-nodes-base.webhook","typeVersion":2,"position":[200,260]},{"parameters":{"httpMethod":"POST","path":"generate-retro-summary","responseMode":"responseNode","options":{}},"id":"z4c7f1k3-0002","name":"Webhook - Generate Summary","type":"n8n-nodes-base.webhook","typeVersion":2,"position":[200,500]},{"parameters":{"jsCode":"const body=$input.first().json.body;const required=['sprint_name','category','item_text'];const missing=required.filter(f=>!body[f]);if(missing.length)return[{json:{valid:false,error:'Missing: '+missing.join(', ')}}];const categories=['went_well','went_poorly','action_item','kudos','blocker'];const category=categories.includes(body.category)?body.category:'went_poorly';return[{json:{valid:true,sprintName:body.sprint_name.trim(),category,itemText:body.item_text.trim().slice(0,500),submittedBy:body.submitted_by||'anonymous',anonymous:body.anonymous===true||body.anonymous==='true'}}];"},"id":"z4c7f1k3-0003","name":"Validate Item","type":"n8n-nodes-base.code","typeVersion":2,"position":[420,260]},{"parameters":{"conditions":{"conditions":[{"id":"cv1","leftValue":"={{ $json.valid }}","rightValue":true,"operator":{"type":"boolean","operation":"true"}}],"combinator":"and"}},"id":"z4c7f1k3-0004","name":"Item Valid?","type":"n8n-nodes-base.if","typeVersion":2,"position":[640,260]},{"parameters":{"respondWith":"json","responseBody":"={{ { error: $json.error, status: 400 } }}"},"id":"z4c7f1k3-0005","name":"Return Item Error","type":"n8n-nodes-base.respondToWebhook","typeVersion":1,"position":[860,380]},{"parameters":{"operation":"appendOrUpdate","documentId":"={{$env.RETRO_SHEET_ID}}","sheetName":"Items","columns":{"mappingMode":"defineBelow","value":{"submitted_at":"={{ $now.toISO() }}","sprint_name":"={{ $json.sprintName }}","category":"={{ $json.category }}","item_text":"={{ $json.itemText }}","submitted_by":"={{ $json.anonymous ? 'anonymous' : $json.submittedBy }}"}},"options":{}},"id":"z4c7f1k3-0006","name":"Save Item","type":"n8n-nodes-base.googleSheets","typeVersion":4.3,"position":[860,260],"credentials":{"googleSheetsOAuth2Api":{"id":"google-creds-01","name":"Google Sheets"}}},{"parameters":{"respondWith":"json","responseBody":"={{ { status: 'submitted', sprint: $json.sprintName, category: $json.category } }}"},"id":"z4c7f1k3-0007","name":"Return Item Result","type":"n8n-nodes-base.respondToWebhook","typeVersion":1,"position":[1080,260]},{"parameters":{"jsCode":"const body=$input.first().json.body;if(!body.sprint_name)return[{json:{valid:false,error:'Missing sprint_name'}}];return[{json:{valid:true,sprintName:body.sprint_name.trim(),teamEmail:body.team_email||'',replyEmail:body.reply_email||null}}];"},"id":"z4c7f1k3-0008","name":"Validate Summary Request","type":"n8n-nodes-base.code","typeVersion":2,"position":[420,500]},{"parameters":{"conditions":{"conditions":[{"id":"cv2","leftValue":"={{ $json.valid }}","rightValue":true,"operator":{"type":"boolean","operation":"true"}}],"combinator":"and"}},"id":"z4c7f1k3-0009","name":"Summary Valid?","type":"n8n-nodes-base.if","typeVersion":2,"position":[640,500]},{"parameters":{"respondWith":"json","responseBody":"={{ { error: $json.error, status: 400 } }}"},"id":"z4c7f1k3-0010","name":"Return Summary Error","type":"n8n-nodes-base.respondToWebhook","typeVersion":1,"position":[860,620]},{"parameters":{"operation":"read","documentId":"={{$env.RETRO_SHEET_ID}}","sheetName":"Items","options":{}},"id":"z4c7f1k3-0011","name":"Load Items","type":"n8n-nodes-base.googleSheets","typeVersion":4.3,"position":[860,500],"credentials":{"googleSheetsOAuth2Api":{"id":"google-creds-01","name":"Google Sheets"}}},{"parameters":{"jsCode":"const sprintName=$('Validate Summary Request').first().json.sprintName;const rows=$input.all().map(r=>r.json).filter(r=>r.sprint_name===sprintName&&r.item_text);const byCategory={};rows.forEach(r=>{if(!byCategory[r.category])byCategory[r.category]=[];byCategory[r.category].push(r.item_text);});return[{json:{sprintName,byCategory,totalItems:rows.length}}];"},"id":"z4c7f1k3-0012","name":"Group by Category","type":"n8n-nodes-base.code","typeVersion":2,"position":[1080,500]},{"parameters":{"model":"claude-sonnet-4-20250514","options":{"temperature":0.45,"maxTokens":1800},"messages":{"values":[{"content":"You facilitate team retrospectives. You cluster similar feedback into themes (multiple people often say the same thing differently), identify the most important patterns, and propose specific, achievable action items. You avoid vague actions like 'communicate better' - actions should be concrete and assignable. Always respond in valid JSON only.","role":"system"},{"content":"Synthesize this retrospective.\n\nSprint: {{ $json.sprintName }}\nTotal items submitted: {{ $json.totalItems }}\n\nWent well:\n{{ ($json.byCategory.went_well||[]).join('\\n') || 'none submitted' }}\n\nWent poorly:\n{{ ($json.byCategory.went_poorly||[]).join('\\n') || 'none submitted' }}\n\nAction items suggested:\n{{ ($json.byCategory.action_item||[]).join('\\n') || 'none submitted' }}\n\nKudos:\n{{ ($json.byCategory.kudos||[]).join('\\n') || 'none submitted' }}\n\nBlockers:\n{{ ($json.byCategory.blocker||[]).join('\\n') || 'none submitted' }}\n\nReturn JSON: {\"retro_summary\":\"2-3 sentences on the overall sprint sentiment and most important theme\",\"went_well_themes\":[{\"theme\":\"clustered theme\",\"mention_count\":0}],\"went_poorly_themes\":[{\"theme\":\"clustered theme\",\"mention_count\":0,\"severity\":\"high|medium|low\"}],\"proposed_action_items\":[{\"action\":\"specific concrete action\",\"addresses\":\"which went_poorly theme this fixes\",\"owner_suggestion\":\"role or team that should own this\"}],\"kudos_highlights\":[\"notable recognition items\"],\"team_health_signal\":\"one of: strong|stable|concerning|needs_attention\",\"facilitator_note\":\"one thing for the scrum master/lead to watch or follow up on\"}","role":"user"}]}},"id":"z4c7f1k3-0013","name":"Claude Retro Facilitator","type":"@n8n/n8n-nodes-langchain.lmChatAnthropic","typeVersion":1.3,"position":[1300,500]},{"parameters":{"jsCode":"const raw=$input.first().json.text||$input.first().json.content?.[0]?.text||'';let summary;try{summary=JSON.parse(raw.replace(/```json|```/g,'').trim());}catch(e){return[{json:{error:'Parse error'}}];}const d=$('Group by Category').first().json;const req=$('Validate Summary Request').first().json;function esc(s){return String(s||'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');}const healthColors={strong:'#16a34a',stable:'#2563eb',concerning:'#d97706',needs_attention:'#dc2626'};const hc=healthColors[summary.team_health_signal]||'#6b7280';const wellThemes=(summary.went_well_themes||[]).map(t=>'<div style=\"font-size:14px;padding:6px 0;border-bottom:1px solid #f0fdf4;color:#166534\">\u2713 '+esc(t.theme)+' <span style=\"color:#9ca3af;font-size:12px\">(\u00d7'+t.mention_count+')</span></div>').join('');const poorlyThemes=(summary.went_poorly_themes||[]).map(t=>{const sc={high:'#dc2626',medium:'#d97706',low:'#6b7280'}[t.severity]||'#6b7280';return '<div style=\"display:flex;justify-content:space-between;align-items:center;padding:6px 0;border-bottom:1px solid #fff7ed\"><span style=\"font-size:14px;color:#92400e\">'+esc(t.theme)+' <span style=\"color:#9ca3af;font-size:12px\">(\u00d7'+t.mention_count+')</span></span><span style=\"background:'+sc+'22;color:'+sc+';font-size:10px;font-weight:700;padding:1px 7px;border-radius:6px\">'+t.severity+'</span></div>';}).join('');const actions=(summary.proposed_action_items||[]).map((a,i)=>'<div style=\"border-left:3px solid #2563eb;padding:8px 12px;background:#f8faff;border-radius:0 4px 4px 0;margin-bottom:8px\"><div style=\"font-size:14px;font-weight:600\">'+esc(a.action)+'</div><div style=\"font-size:12px;color:#6b7280;margin-top:3px\">Addresses: '+esc(a.addresses)+' \u00b7 Owner: '+esc(a.owner_suggestion)+'</div></div>').join('');const kudos=(summary.kudos_highlights||[]).map(k=>'<div style=\"font-size:14px;padding:5px 0;border-bottom:1px solid #f5f3ff;color:#6d28d9\">\u2606 '+esc(k)+'</div>').join('');const html='<!DOCTYPE html><html><head><meta charset=\"utf-8\"></head><body style=\"margin:0;padding:16px;background:#f9fafb;font-family:sans-serif;color:#111\"><div style=\"max-width:680px;margin:0 auto\"><div style=\"background:#1e293b;color:#fff;padding:18px 26px;border-radius:10px 10px 0 0\"><div style=\"font-size:11px;text-transform:uppercase;color:#64748b\">Retrospective</div><div style=\"font-size:18px;font-weight:700\">'+esc(d.sprintName)+'</div><div style=\"font-size:13px;color:#94a3b8\">'+d.totalItems+' items submitted</div></div><div style=\"background:'+hc+'15;padding:14px 26px;border:1px solid '+hc+'44;border-top:none;display:flex;align-items:center;gap:12px\"><span style=\"background:'+hc+';color:#fff;font-size:12px;font-weight:700;padding:4px 12px;border-radius:10px\">'+esc((summary.team_health_signal||'').replace(/_/g,' ').toUpperCase())+'</span><p style=\"font-size:14px;color:#374151;margin:0\">'+esc(summary.retro_summary)+'</p></div>'+(wellThemes?'<div style=\"background:#f0fdf4;padding:14px 26px;border:1px solid #bbf7d0\"><div style=\"font-size:11px;font-weight:700;text-transform:uppercase;color:#15803d;margin-bottom:7px\">Went well</div>'+wellThemes+'</div>':'')+(poorlyThemes?'<div style=\"background:#fff;padding:14px 26px;border:1px solid #e5e7eb;border-top:3px solid #f3f4f6\"><div style=\"font-size:11px;font-weight:700;text-transform:uppercase;color:#92400e;margin-bottom:7px\">Went poorly</div>'+poorlyThemes+'</div>':'')+(actions?'<div style=\"background:#fff;padding:14px 26px;border:1px solid #e5e7eb;border-top:3px solid #f3f4f6\"><div style=\"font-size:11px;font-weight:700;text-transform:uppercase;color:#9ca3af;margin-bottom:8px\">Proposed action items</div>'+actions+'</div>':'')+(kudos?'<div style=\"background:#f5f3ff;padding:14px 26px;border:1px solid #ddd6fe\"><div style=\"font-size:11px;font-weight:700;text-transform:uppercase;color:#6d28d9;margin-bottom:7px\">Kudos</div>'+kudos+'</div>':'')+(summary.facilitator_note?'<div style=\"background:#fffbeb;padding:12px 26px;border:1px solid #fde68a\"><div style=\"font-size:11px;font-weight:700;text-transform:uppercase;color:#92400e;margin-bottom:4px\">Facilitator note (for lead)</div><div style=\"font-size:13px;color:#78350f\">'+esc(summary.facilitator_note)+'</div></div>':'')+'<div style=\"background:#1e293b;color:#475569;font-size:11px;padding:10px 26px;border-radius:0 0 10px 10px;text-align:center\">Retro \u00b7 '+esc(d.sprintName)+'</div></div></body></html>';return[{json:{html,teamEmail:req.teamEmail,replyEmail:req.replyEmail,sprintName:d.sprintName,summary}}];"},"id":"z4c7f1k3-0014","name":"Build Retro Doc","type":"n8n-nodes-base.code","typeVersion":2,"position":[1520,500]},{"parameters":{"jsCode":"const emails=[$json.teamEmail,$json.replyEmail].filter(Boolean);return[{json:{...$json,allRecipients:[...new Set(emails)]}}];"},"id":"z4c7f1k3-0015","name":"Collect Recipients","type":"n8n-nodes-base.code","typeVersion":2,"position":[1740,500]},{"parameters":{"conditions":{"conditions":[{"id":"ce","leftValue":"={{ $json.allRecipients.length > 0 }}","rightValue":true,"operator":{"type":"boolean","operation":"true"}}],"combinator":"and"}},"id":"z4c7f1k3-0016","name":"Has Recipients?","type":"n8n-nodes-base.if","typeVersion":2,"position":[1960,500]},{"parameters":{"fromEmail":"={{$env.FROM_EMAIL}}","toEmail":"={{ $json.allRecipients.join(',') }}","subject":"Retro summary: {{ $json.sprintName }}","emailType":"html","message":"={{$json.html}}"},"id":"z4c7f1k3-0017","name":"Email Retro","type":"n8n-nodes-base.emailSend","typeVersion":2.1,"position":[2180,440],"credentials":{"smtp":{"id":"smtp-creds-01","name":"SMTP Account"}}},{"parameters":{"respondWith":"json","responseBody":"={{ { status: 'summari