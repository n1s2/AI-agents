{"name":"Landing Page Copy Generator Agent","nodes":[{"parameters":{"httpMethod":"POST","path":"generate-landing-copy","responseMode":"responseNode","options":{}},"id":"y3b6e9j2-0001","name":"Webhook","type":"n8n-nodes-base.webhook","typeVersion":2,"position":[200,320]},{"parameters":{"jsCode":"const body=$input.first().json.body;const required=['product_name','value_proposition','target_audience'];const missing=required.filter(f=>!body[f]);if(missing.length)return[{json:{valid:false,error:'Missing: '+missing.join(', ')}}];const pageTypes=['saas_homepage','product_launch','lead_gen','event_registration','app_download','waitlist','free_trial'];const pageType=pageTypes.includes(body.page_type)?body.page_type:'saas_homepage';return[{json:{valid:true,productName:body.product_name.trim(),valueProposition:body.value_proposition.trim().slice(0,500),targetAudience:body.target_audience.trim().slice(0,300),pageType,features:Array.isArray(body.features)?body.features:(body.features||'').split('\\n').map(f=>f.trim()).filter(Boolean),socialProof:(body.social_proof||'').slice(0,300),pricingInfo:(body.pricing_info||'').slice(0,200),mainCta:body.main_cta||'',objectionsToAddress:Array.isArray(body.objections_to_address)?body.objections_to_address:(body.objections_to_address||'').split(',').map(o=>o.trim()).filter(Boolean),tone:body.tone||'confident_clear',competitorAngle:(body.competitor_angle||'').slice(0,300),replyEmail:body.reply_email||null}}];"},"id":"y3b6e9j2-0002","name":"Validate Input","type":"n8n-nodes-base.code","typeVersion":2,"position":[420,320]},{"parameters":{"conditions":{"conditions":[{"id":"cv","leftValue":"={{ $json.valid }}","rightValue":true,"operator":{"type":"boolean","operation":"true"}}],"combinator":"and"}},"id":"y3b6e9j2-0003","name":"Valid?","type":"n8n-nodes-base.if","typeVersion":2,"position":[640,320]},{"parameters":{"respondWith":"json","responseBody":"={{ { error: $json.error, status: 400 } }}"},"id":"y3b6e9j2-0004","name":"Return Error","type":"n8n-nodes-base.respondToWebhook","typeVersion":1,"position":[860,480]},{"parameters":{"model":"claude-sonnet-4-20250514","options":{"temperature":0.7,"maxTokens":3000},"messages":{"values":[{"content":"You write landing page copy that converts. Good landing page copy: leads with the outcome the visitor wants, not the product's features; uses specific, concrete language over vague claims; addresses objections before they become blockers; has one clear CTA repeated strategically, not many competing CTAs; matches the awareness level of the target audience. You write in scannable blocks, not dense paragraphs - real visitors skim. Always respond in valid JSON only.","role":"system"},{"content":"Write landing page copy.\n\nProduct: {{ $json.productName }}\nValue prop: {{ $json.valueProposition }}\nAudience: {{ $json.targetAudience }}\nPage type: {{ $json.pageType.replace(/_/g,' ') }}\nTone: {{ $json.tone.replace(/_/g,' ') }}\nFeatures: {{ $json.features.join(', ') || 'not specified' }}\nSocial proof available: {{ $json.socialProof || 'none provided' }}\nPricing: {{ $json.pricingInfo || 'not specified' }}\nMain CTA: {{ $json.mainCta || 'infer appropriate CTA' }}\nObjections to address: {{ $json.objectionsToAddress.join(', ') || 'none specified' }}\nCompetitor angle: {{ $json.competitorAngle || 'none' }}\n\nReturn JSON:\n{\"hero\":{\"headline\":\"the main headline - outcome-focused, under 10 words ideally\",\"subheadline\":\"1-2 sentences expanding on the headline\",\"cta_text\":\"button text\"},\"social_proof_bar\":\"short trust line using only the social proof provided, or null\",\"problem_section\":{\"headline\":\"section headline naming the problem\",\"body\":\"2-3 sentences on the problem from the visitor's perspective\"},\"solution_section\":{\"headline\":\"section headline\",\"body\":\"2-3 sentences on how the product solves it\"},\"feature_blocks\":[{\"headline\":\"feature name as a benefit, not a feature label\",\"body\":\"1-2 sentences explaining the benefit\"}],\"objection_handling\":[{\"objection\":\"the objection\",\"response\":\"how the copy addresses it\"}],\"final_cta_section\":{\"headline\":\"closing section headline\",\"body\":\"1-2 sentences\",\"cta_text\":\"button text\"},\"meta_title\":\"SEO page title under 60 chars\",\"meta_description\":\"SEO meta description under 160 chars\",\"copy_rationale\":\"2-3 sentences on the strategic choices made in this copy\"}","role":"user"}]}},"id":"y3b6e9j2-0005","name":"Claude Copywriter","type":"@n8n/n8n-nodes-langchain.lmChatAnthropic","typeVersion":1.3,"position":[860,240]},{"parameters":{"jsCode":"const raw=$input.first().json.text||$input.first().json.content?.[0]?.text||'';let copy;try{copy=JSON.parse(raw.replace(/```json|```/g,'').trim());}catch(e){return[{json:{error:'Parse error'}}];}const input=$('Validate Input').first().json;copy._meta={productName:input.productName,pageType:input.pageType,replyEmail:input.replyEmail};return[{json:copy}];"},"id":"y3b6e9j2-0006","name":"Parse Copy","type":"n8n-nodes-base.code","typeVersion":2,"position":[1080,240]},{"parameters":{"jsCode":"const c=$input.first().json;const m=c._meta;function esc(s){return String(s||'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');}const featureBlocks=(c.feature_blocks||[]).map(f=>'<div style=\"border:1px solid #e5e7eb;border-radius:8px;padding:14px;margin-bottom:10px\"><div style=\"font-size:15px;font-weight:700;margin-bottom:5px\">'+esc(f.headline)+'</div><div style=\"font-size:13px;color:#6b7280;line-height:1.6\">'+esc(f.body)+'</div></div>').join('');const objections=(c.objection_handling||[]).map(o=>'<div style=\"padding:10px 0;border-bottom:1px solid #f3f4f6\"><div style=\"font-size:13px;color:#9ca3af;margin-bottom:2px\">\"'+esc(o.objection)+'\"</div><div style=\"font-size:14px;color:#374151\">'+esc(o.response)+'</div></div>').join('');const html='<!DOCTYPE html><html><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"></head><body style=\"margin:0;padding:16px;background:#f9fafb;font-family:sans-serif;color:#111\"><div style=\"max-width:680px;margin:0 auto\"><div style=\"background:#111827;color:#fff;padding:18px 26px;border-radius:10px 10px 0 0\"><div style=\"font-size:11px;text-transform:uppercase;color:#6b7280\">Landing Page Copy \u00b7 '+esc(m.pageType.replace(/_/g,' '))+'</div><div style=\"font-size:18px;font-weight:700\">'+esc(m.productName)+'</div></div><div style=\"background:#fff;padding:28px;border:1px solid #e5e7eb;border-top:none;text-align:center\"><div style=\"font-size:26px;font-weight:800;line-height:1.25;margin-bottom:10px\">'+esc(c.hero?.headline)+'</div><div style=\"font-size:15px;color:#6b7280;margin-bottom:18px\">'+esc(c.hero?.subheadline)+'</div><div style=\"display:inline-block;background:#2563eb;color:#fff;font-size:14px;font-weight:700;padding:10px 24px;border-radius:6px\">'+esc(c.hero?.cta_text)+'</div></div>'+(c.social_proof_bar?'<div style=\"background:#f9fafb;padding:10px 26px;border:1px solid #e5e7eb;text-align:center;font-size:13px;color:#6b7280\">'+esc(c.social_proof_bar)+'</div>':'')+'<div style=\"background:#fff;padding:18px 26px;border:1px solid #e5e7eb;border-top:3px solid #f3f4f6\"><div style=\"font-size:17px;font-weight:700;margin-bottom:6px\">'+esc(c.problem_section?.headline)+'</div><div style=\"font-size:14px;color:#374151;line-height:1.7\">'+esc(c.problem_section?.body)+'</div></div><div style=\"background:#eff6ff;padding:18px 26px;border:1px solid #bfdbfe\"><div style=\"font-size:17px;font-weight:700;color:#1e3a8a;margin-bottom:6px\">'+esc(c.solution_section?.headline)+'</div><div style=\"font-size:14px;color:#1e40af;line-height:1.7\">'+esc(c.solution_section?.body)+'</div></div>'+(featureBlocks?'<div style=\"background:#fff;padding:18px 26px;border:1px solid #e5e7eb;border-top:3px solid #f3f4f6\"><div style=\"font-size:11px;font-weight:700;text-transform:uppercase;color:#9ca3af;margin-bottom:10px\">Features</div>'+featureBlocks+'</div>':'')+(objections?'<div style=\"background:#fff;padding:18px 26px;border:1px solid #e5e7eb;border-top:3px solid #f3f4f6\"><div style=\"font-size:11px;font-weight:700;text-transform:uppercase;color:#9ca3af;margin-bottom:6px\">Objection handling</div>'+objections+'</div>':'')+'<div style=\"background:#1e293b;color:#fff;padding:24px;text-align:center\"><div style=\"font-size:19px;font-weight:700;margin-bottom:8px\">'+esc(c.final_cta_section?.headline)+'</div><div style=\"font-size:14px;color:#cbd5e1;margin-bottom:14px\">'+esc(c.final_cta_section?.body)+'</div><div style=\"display:inline-block;background:#2563eb;color:#fff;font-size:14px;font-weight:700;padding:10px 24px;border-radius:6px\">'+esc(c.final_cta_section?.cta_text)+'</div></div>'+(c.copy_rationale?'<div style=\"background:#fffbeb;padding:12px 26px;border:1px solid #fde68a\"><div style=\"font-size:11px;font-weight:700;text-transform:uppercase;color:#92400e;margin-bottom:4px\">Strategy notes</div><div style=\"font-size:13px;color:#78350f\">'+esc(c.copy_rationale)+'</div></div>':'')+'<div style=\"background:#111827;color:#475569;font-size:11px;padding:10px 26px;border-radius:0 0 10px 10px;text-align:center\">Landing Page Copy \u00b7 '+esc(m.productName)+'</div></div></body></html>';return[{json:{html,replyEmail:m.replyEmail,productName:m.productName,copy:c}}];"},"id":"y3b6e9j2-0007","name":"Build Page Preview","type":"n8n-nodes-base.code","typeVersion":2,"position":[1300,240]},{"parameters":{"conditions":{"conditions":[{"id":"ce","leftValue":"={{ $json.replyEmail }}","rightValue":"","operator":{"type":"string","operation":"notEmpty"}}],"combinator":"and"}},"id":"y3b6e9j2-0008","name":"Has Email?","type":"n8n-nodes-base.if","typeVersion":2,"position":[1520,240]},{"parameters":{"fromEmail":"={{$env.FROM_EMAIL}}","toEmail":"={{$json.replyEmail}}","subject":"Landing page copy: {{ $json.productName }}","emailType":"html","message":"={{$json.html}}"},"id":"y3b6e9j2-0009","name":"Email Copy","type":"n8n-nodes-base.emailSend","typeVersion":2.1,"position":[1740,180],"credentials":{"smtp":{"id":"smtp-creds-01","name":"SMTP Account"}}},{"parameters":{"respondWith":"json","responseBody":"={{ { status: 'generated', product: $json.productName, emailed: $json.replyEmail ? true : false, copy: $json.copy } }}"},"id":"y3b6e9j2-0010","name":"Return Copy","type":"n8n-nodes-base.respondToWebhook","typeVersion":1,"position":[1960,240]}],"connections":{"Webhook":{"main":[[{"node":"Validate Input","type":"main","index":0}]]},"Validate Input":{"main":[[{"node":"Valid?","type":"main","index":0}]]},"Valid?":{"main":[[{"node":"Claude Copywriter","type":"main","index":0}],[{"node":"Return Error","type":"main","index":0}]]},"Claude Copywriter":{"main":[[{"node":"Parse Copy","type":"main","index":0}]]},"Parse Copy":{"main":[[{"node":"Build Page Preview","type":"main","index":0}]]},"Build Page Preview":{"main":[[{"node":"Has Email?","type":"main","index":0}]]},"Has Email?":{"main":[[{"node":"Email Copy","type":"main","index":0}],[{"node":"Return Copy","type":"main","index":0}]]},"Email Copy":{"main":[[{"node":"Return Copy","type":"main","index":0}]]}},"pinData":{},"settings":{"executionOrder":"v1","saveManualExecutions":true},"staticData":null,"tags":["marketing","copywriting","landing-page","conversion"],"triggerCount":0,"updatedAt":"2025-05-23T09:00:00.000Z","versionId":"v1.0.0"}
