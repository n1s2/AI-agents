.partnershipType.replace(/_/g,' ') }}\nChannel: {{ $json.input.channel }}\nValue prop: {{ $json.input.valueProposition }}\nMutual benefit: {{ $json.input.mutualBenefit || 'not specified' }}\nContext: {{ $json.input.partnerContext || 'none' }}\n\nPartner research:\n{{ $json.partnerResearch }}\n\nReturn JSON: {\"personalization_hook\":\"specific thing about partner to open with or null\",\"email\":{\"subject\":\"...\",\"body\":\"complete email body under 200 words\"},\"linkedin_message\":\"under 150 words different angle\",\"partnership_pitch\":\"3-4 bullet summary of partnership mechanics\",\"follow_up_angle\":\"different approach for non-responders\",\"outreach_quality_note\":\"one sentence assessment\"}","role":"user"}]}},"id":"u8x2a5d7-0007","name":"Claude Outreach Writer","type":"@n8n/n8n-nodes-langchain.lmChatAnthropic","typeVersion":1.3,"position":[1280,320]},{"parameters":{"jsCode":"const raw=$input.first().json.text||$input.first().json.content?.[0]?.text||'';let o;try{o=JSON.parse(raw.replace(/```json|```/g,'').trim());}catch(e){return[{json:{error:'Parse error'}}];}const input=$('Validate Input').first().json;o._meta={yourCompany:input.yourCompany,partnerCompany:input.partnerCompany,partnershipType:input.partnershipType,channel:input.channel,replyEmail:input.replyEmail};return[{json:o}];"},"id":"u8x2a5d7-0008","name":"Parse Outreach","type":"n8n-nodes-base.code","typeVersion":2,"position":[1500,320]},{"parameters":{"jsCode":"const o=$input.first().json;const m=o._meta;function esc(s){return String(s||'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');}const html='<!DOCTYPE html><html><head><meta charset=\"utf-8\"></head><body style=\"margin:0;padding:16px;background:#f9fafb;font-family:sans-serif\"><div style=\"max-width:660px;margin:0 auto\"><div style=\"background:#111827;color:#fff;padding:18px 26px;border-radius:10px 10px 0 0\"><div style=\"font-size:11px;text-transform:uppercase;color:#6b7280;margin-bottom:4px\">Partnership Outreach</d