{"name":"Partnership Outreach Writer Agent","nodes":[{"parameters":{"httpMethod":"POST","path":"write-partnership-outreach","responseMode":"responseNode","options":{}},"id":"u8x2a5d7-0001","name":"Webhook","type":"n8n-nodes-base.webhook","typeVersion":2,"position":[200,320]},{"parameters":{"jsCode":"const body=$input.first().json.body;const required=['your_company','partner_company','partnership_type','your_name','value_proposition'];const missing=required.filter(f=>!body[f]);if(missing.length)return[{json:{valid:false,error:'Missing: '+missing.join(', ')}}];const ptypes=['co_marketing','technology_integration','reseller','referral','distribution','content','strategic_alliance','agency_partner','affiliate'];const partnershipType=ptypes.includes(body.partnership_type)?body.partnership_type:'strategic_alliance';const channel=['email','linkedin','both'].includes(body.channel)?body.channel:'email';return[{json:{valid:true,yourCompany:body.your_company.trim(),yourDescription:(body.your_description||'').slice(0,400),yourName:body.your_name.trim(),yourTitle:body.your_title||'',partnerCompany:body.partner_company.trim(),partnerContact:body.partner_contact||'',partnerTitle:body.partner_title||'',partnerDescription:(body.partner_description||'').slice(0,400),partnershipType,channel,valueProposition:body.value_proposition.trim().slice(0,600),mutualBenefit:(body.mutual_benefit||'').slice(0,400),partnerContext:(body.partner_context||'').slice(0,500),existingRelationship:(body.existing_relationship||'').slice(0,200),tone:body.tone||'professional_warm',replyEmail:body.reply_email||null}}];}"},"id":"u8x2a5d7-0002","name":"Validate Input","type":"n8n-nodes-base.code","typeVersion":2,"position":[420,320]},{"parameters":{"conditions":{"conditions":[{"id":"cv","leftValue":"={{ $json.valid }}","rightValue":true,"operator":{"type":"boolean","operation":"true"}}],"combinator":"and"}},"id":"u8x2a5d7-0003","name":"Valid?","type":"n8n-nodes-base.if","typeVersion":2,"position":[640,320]},{"pa