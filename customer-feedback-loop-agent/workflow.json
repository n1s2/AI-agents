{
  "name": "FLOOWBOX - Customer Feedback Loop Agent",
  "meta": { "instanceId": "navtej-floowbox-n8n-2025" },
  "nodes": [
    { "id": "n1", "name": "Feedback Webhook", "type": "n8n-nodes-base.webhook", "position": [240, 300], "parameters": { "path": "customer-feedback", "httpMethod": "POST", "responseMode": "responseNode" }, "typeVersion": 2 },
    { "id": "n2", "name": "Set Feedback Data", "type": "n8n-nodes-base.set", "position": [460, 300], "parameters": { "assignments": { "assignments": [ {"id":"fb1","name":"customer_name","type":"string","value":"={{ $json.name }}"}, {"id":"fb2","name":"customer_email","type":"string","value":"={{ $json.email }}"}, {"id":"fb3","name":"feedback_text","type":"string","value":"={{ $json.feedback }}"}, {"id":"fb4","name":"rating","type":"number","value":"={{ $json.rating || 0 }}"}, {"id":"fb5","name":"product_area","type":"string","value":"={{ $json.area || 'general' }}"} ] } }, "typeVersion": 3.4 },
    { "id": "n3", "name": "Analyze Feedback", "type": "@n8n/n8n-nodes-langchain.chainLlm", "position": [680, 300], "parameters": { "promptType": "define", "text": "=Analyze this customer feedback and close the loop.\n\nCustomer: {{ $json.customer_name }}\nRating: {{ $json.rating }}/5\nProduct Area: {{ $json.product_area }}\nFeedback: {{ $json.feedback_text }}\n\nReturn JSON:\n{\n  \"sentiment\": \"positive/neutral/negative\",\n  \"feedback_type\": \"bug/feature_request/praise/confusion/complaint\",\n  \"actionable\": true,\n  \"action_team\": \"product/engineering/support/marketing\",\n  \"priority\": \"high/medium/low\",\n  \"feature_request_extracted\": \"\",\n  \"thank_you_email\": \"personalized reply to customer (acknowledge, validate, what happens next)\",\n  \"internal_note\": \"brief internal note for the team about what to do with this feedback\",\n  \"product_insight\": \"one sentence insight for the product roadmap\"\n}" }, "typeVersion": 1.5 },
    { "id": "n4", "name": "OpenAI GPT-4o", "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi", "position": [680, 460], "parameters": { "model": "gpt-4o", "options": {} }, "typeVersion": 1 },
    { "id": "n5", "name": "Parse Feedback", "type": "n8n-nodes-base.code", "position": [900, 300], "parameters": { "jsCode": "const raw = $input.item.json.text.replace(/```json|```/g,'').trim();\nconst analysis = JSON.parse(raw);\nreturn [{ json: { ...analysis, customer: $('Set Feedback Data').item.json } }];" }, "typeVersion": 2 },
    { "id": "n6", "name": "Send Thank You Email", "type": "n8n-nodes-base.emailSend", "position": [1100, 200], "parameters": { "toEmail": "={{ $json.customer.customer_email }}", "fromEmail": "navtej@floowbox.com", "subject": "=Thanks for your feedback, {{ $json.customer.customer_name }}", "html": "=<p>Hi {{ $json.customer.customer_name }},</p><p>{{ $json.thank_you_email.replace(/\\n/g,'<br>') }}</p><p>— Navtej, FLOOWBOX</p>", "options": {} }, "typeVersion": 2.1 },
    { "id": "n7", "name": "Log to Airtable", "type": "n8n-nodes-base.airtable", "position": [1100, 380], "parameters": { "operation": "create", "baseId": "YOUR_AIRTABLE_BASE_ID", "tableId": "Customer Feedback", "fieldsUi": { "fieldValues": [{"fieldId": "Customer", "fieldValue": "={{ $json.customer.customer_name }}"}, {"fieldId": "Rating", "fieldValue": "={{ $json.customer.rating }}"}, {"fieldId": "Type", "fieldValue": "={{ $json.feedback_type }}"}, {"fieldId": "Priority", "fieldValue": "={{ $json.priority }}"}, {"fieldId": "Action Team", "fieldValue": "={{ $json.action_team }}"}, {"fieldId": "Insight", "fieldValue": "={{ $json.product_insight }}"}, {"fieldId": "Date", "fieldValue": "={{ $now.toFormat('yyyy-MM-dd') }}"}] } }, "typeVersion": 2.1 },
    { "id": "n8", "name": "Route High Priority", "type": "n8n-nodes-base.if", "position": [1100, 560], "parameters": { "conditions": { "conditions": [{"leftValue": "={{ $json.priority }}", "rightValue": "high", "operator": {"type": "string", "operation": "equals"}}] } }, "typeVersion": 2.2 },
    { "id": "n9", "name": "Alert Team Slack", "type": "n8n-nodes-base.slack", "position": [1300, 480], "parameters": { "operation": "post", "channel": "#product", "text": "=💬 *High Priority Feedback — {{ $json.customer.product_area }}*\n*From:* {{ $json.customer.customer_name }} ({{ $json.customer.rating }}/5)\n*Type:* {{ $json.feedback_type }} | *Team:* {{ $json.action_team }}\n*Feedback:* {{ $json.customer.feedback_text }}\n*Insight:* {{ $json.product_insight }}\n*Note:* {{ $json.internal_note }}" }, "typeVersion": 2.2 },
    { "id": "n10", "name": "Respond OK", "type": "n8n-nodes-base.respondToWebhook", "position": [1300, 280], "parameters": { "respondWith": "json", "responseBody": "{\"status\": \"received\"}" }, "typeVersion": 1.1 },
    { "id": "n11", "name": "Sticky Note", "type": "n8n-nodes-base.stickyNote", "position": [220, 140], "parameters": { "content": "## Customer Feedback Loop Agent\nFeedback received → GPT-4o analyzes type, priority, action team.\nSends personalized thank-you email to customer immediately.\nLogs structured feedback to Airtable product backlog.\nHigh priority feedback → Slack alert to #product team." }, "typeVersion": 1 }
  ],
  "connections": {
    "Feedback Webhook": {"main": [[{"node": "Set Feedback Data", "type": "main", "index": 0}]]},
    "Set Feedback Data": {"main": [[{"node": "Analyze Feedback", "type": "main", "index": 0}]]},
    "Analyze Feedback": {"main": [[{"node": "Parse Feedback", "type": "main", "index": 0}]]},
    "OpenAI GPT-4o": {"ai_languageModel": [[{"node": "Analyze Feedback", "type": "ai_languageModel", "index": 0}]]},
    "Parse Feedback": {"main": [[{"node": "Send Thank You Email", "type": "main", "index": 0}], [{"node": "Log to Airtable", "type": "main", "index": 0}], [{"node": "Route High Priority", "type": "main", "index": 0}]]},
    "Send Thank You Email": {"main": [[{"node": "Respond OK", "type": "main", "index": 0}]]},
    "Route High Priority": {"main": [[{"node": "Alert Team Slack", "type": "main", "index": 0}], []]}
  },
  "active": false,
  "settings": {"executionOrder": "v1"}
}
