{"name":"Support Macro Generator Agent","nodes":[{"parameters":{"httpMethod":"POST","path":"generate-support-macros","responseMode":"responseNode","options":{}},"id":"c3d4e5f6g9-0001","name":"Webhook","type":"n8n-nodes-base.webhook","typeVersion":2,"position":[200,320]},{"parameters":{"jsCode":"const body=$input.first().json.body;const required=['common_issues','product_name'];const missing=required.filter(f=>!body[f]);if(missing.length)return[{json:{valid:false,error:'Missing: '+missing.join(', ')}}];const issues=Array.isArray(body.common_issues)?body.common_issues:[];if(issues.length===0)return[{json:{valid:false,error:'common_issues must be non-empty'}}];const formatted=issues.slice(0,20).map((iss,i)=>({id:iss.id||('ISSUE-'+String(i+1).padStart(3,'0')),issueSummary:(iss.issue_summary||'').trim().slice(0,300),resolutionSteps:(iss.resolution_steps||'').slice(0,600),frequency:iss.frequency||'',category:iss.category||'general'}));return[{json:{valid:true,productName:body.product_name.trim(),commonIssues:formatted,issueCount:formatted.length,brandVoice:(body.brand_voice||'').slice(0,200),supportToneGuidelines:(body.support_tone_guidelines||'').slice(0,300),includeSpanish:body.include_spanish===true||body.include_spanish==='true',replyEmail:body.reply_email||null}}];"},"id":"c3d4e5f6g9-0002","name":"Validate Input","type":"n8n-nodes-base.code","typeVersion":2,"position":[420,320]},{"parameters":{"conditions":{"conditions":[{"id":"cv","leftValue":"={{ $json.valid }}","rightValue":true,"operator":{"type":"boolean","operation":"true"}}],"combinator":"and"}},"id":"c3d4e5f6g9-0003","name":"Valid?","type":"n8n-nodes-base.if","typeVersion":2,"position":[640,320]},{"parameters":{"respondWith":"json","responseBody":"={{ { error: $json.error, status: 400 } }}"},"id":"c3d4e5f6g9-0004","name":"Return Error","type":"n8n-nodes-base.respondToWebhook","typeVersion":1,"position":[860,480]},{"parameters":{"model":"claude-sonnet-4-20250514","options":{"temperature":0.5,"maxTokens":3500},"messages":{"values":[{"content":"You write support macros (canned responses) for customer support teams. Good macros are personalized enough not to feel robotic even though they're templated, use placeholder variables clearly marked, get straight to the resolution without excessive apology, and include a natural closing that invites follow-up. Always respond in valid JSON only.","role":"system"},{"content":"Generate support macros.\n\nProduct: {{ $json.productName }}\nBrand voice: {{ $json.brandVoice || 'friendly and professional' }}\nTone guidelines: {{ $json.supportToneGuidelines || 'not specified' }}\n\nCommon issues:\n{{ $json.commonIssues.map(i=>i.id+' ['+i.category+']'+(i.frequency?' ['+i.frequency+']':'')+': '+i.issueSummary+(i.resolutionSteps?' | Resolution: '+i.resolutionSteps:'')).join('\\n\\n') }}\n\nReturn JSON:\n{\"macros\":[{\"issue_id\":\"\",\"macro_name\":\"short internal name for this macro\",\"subject_line\":\"if this is often the first response, a suggested subject line\",\"macro_body\":\"the complete macro text with {{placeholder}} style variables clearly marked for personalization — greeting, acknowledgment, resolution steps or explanation, closing\",\"placeholder_variables\":[\"list of placeholders used, e.g. customer_name, account_email\"],\"when_to_use\":\"specific guidance on when this macro fits vs when it does not\",\"personalization_note\":\"what the agent should customize before sending, not just fill in placeholders\"}],\"general_macro_guidelines\":[\"tips for the team on using macros well without sounding robotic\"]}","role":"user"}]}},"id":"c3d4e5f6g9-0005","name":"Claude Macro Writer","type":"@n8n/n8n-nodes-langchain.lmChatAnthropic","typeVersion":1.3,"position":[860,240]},{"parameters":{"jsCode":"const raw=$input.first().json.text||$input.first().json.content?.[0]?.text||'';let result;try{result=JSON.parse(raw.replace(/```json|```/g,'').trim());}catch(e){return[{json:{error:'Parse error'}}];}const input=$('Validate Input').first().json;result._meta={productName:input.productName,issueCount:input.issueCount,replyEmail:input.replyEmail};return[{json:result}];"},"id":"c3d4e5f6g9-0006","name":"Parse Result","type":"n8n-nodes-base.code","typeVersion":2,"position":[1080,240]},{"parameters":{"jsCode":"const r=$input.first().json;const m=r._meta;function esc(s){return String(s||'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');}const macroCards=(r.macros||[]).map(mc=>{const vars=(mc.placeholder_variables||[]).map(v=>'<code style=\"background:#eff6ff;color:#1d4ed8;padding:2px 6px;border-radius:3px;font-size:11px;margin-right:4px\">{{'+esc(v)+'}}</code>').join('');return '<div style=\"border:1px solid #e5e7eb;border-radius:8px;margin-bottom:14px;overflow:hidden\"><div style=\"background:#f8faff;padding:9px 16px;border-bottom:1px solid #e5e7eb;display:flex;justify-content:space-between;align-items:center\"><span style=\"font-size:14px;font-weight:700\">'+esc(mc.macro_name)+'</span><span style=\"font-size:11px;color:#9ca3af;font-family:monospace\">'+esc(mc.issue_id)+'</span></div><div style=\"padding:12px 16px\">'+(mc.subject_line?'<div style=\"font-size:12px;color:#9ca3af;margin-bottom:6px\">Subject: <strong>'+esc(mc.subject_line)+'</strong></div>':'')+'<div style=\"background:#f9fafb;border:1px solid #e5e7eb;border-radius:6px;padding:12px;margin-bottom:8px;font-size:14px;line-height:1.7;white-space:pre-line\">'+esc(mc.macro_body)+'</div>'+(vars?'<div style=\"margin-bottom:6px\">'+vars+'</div>':'')+(mc.when_to_use?'<div style=\"font-size:12px;color:#2563eb;margin-bottom:3px\">When to use: '+esc(mc.when_to_use)+'</div>':'')+(mc.personalization_note?'<div style=\"font-size:12px;color:#d97706\">Personalize: '+esc(mc.personalization_note)+'</div>':'')+'</div></div>';}).join('');const guidelines=(r.general_macro_guidelines||[]).map((g,i)=>'<div style=\"font-size:14px;padding:6px 0;border-bottom:1px solid #f0fdf4;color:#166534\">'+(i+1)+'. '+esc(g)+'</div>').join('');const html='<!DOCTYPE html><html><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"></head><body style=\"margin:0;padding:16px;background:#f9fafb;font-family:sans-serif;color:#111\"><div style=\"max-width:740px;margin:0 auto\"><div style=\"background:#1e293b;color:#fff;padding:18px 26px;border-radius:10px 10px 0 0\"><div style=\"font-size:11px;text-transform:uppercase;color:#64748b\">Support Macros</div><div style=\"font-size:18px;font-weight:700\">'+esc(m.productName)+'</div><div style=\"font-size:13px;color:#94a3b8\">'+(r.macros||[]).length+' macros generated</div></div><div style=\"background:#fff;padding:16px 26px;border:1px solid #e5e7eb;border-top:none\">'+macroCards+'</div>'+(guidelines?'<div style=\"background:#f0fdf4;padding:14px 26px;border:1px solid #bbf7d0\"><div style=\"font-size:11px;font-weight:700;text-transform:uppercase;color:#15803d;margin-bottom:7px\">Guidelines for using macros well</div>'+guidelines+'</div>':'')+'<div style=\"background:#1e293b;color:#475569;font-size:11px;padding:10px 26px;border-radius:0 0 10px 10px;text-align:center\">Support Macros \u00b7 '+esc(m.productName)+'</div></div></body></html>';return[{json:{html,replyEmail:m.replyEmail,productName:m.productName,macroCount:(r.macros||[]).length,result:r}}];"},"id":"c3d4e5f6g9-0007","name":"Build Macros","type":"n8n-nodes-base.code","typeVersion":2,"position":[1300,240]},{"parameters":{"conditions":{"conditions":[{"id":"ce","leftValue":"={{ $json.replyEmail }}","rightValue":"","operator":{"type":"string","operation":"notEmpty"}}],"combinator":"and"}},"id":"c3d4e5f6g9-0008","name":"Has Email?","type":"n8n-nodes-base.if","typeVersion":2,"position":[1520,240]},{"parameters":{"fromEmail":"={{$env.FROM_EMAIL}}","toEmail":"={{$json.replyEmail}}","subject":"Support macros: {{ $json.productName }} — {{ $json.macroCount }} macros","emailType":"html","message":"={{$json.html}}"},"id":"c3d4e5f6g9-0009","name":"Email Macros","type":"n8n-nodes-base.emailSend","typeVersion":2.1,"position":[1740,180],"credentials":{"smtp":{"id":"smtp-creds-01","name":"SMTP Account"}}},{"parameters":{"respondWith":"json","responseBody":"={{ { status: 'generated', product: $json.productName, macro_count: $json.macroCount, emailed: $json.replyEmail ? true : false, result: $json.result } }}"},"id":"c3d4e5f6g9-0010","name":"Return Result","type":"n8n-nodes-base.respondToWebhook","typeVersion":1,"position":[1960,240]}],"connections":{"Webhook":{"main":[[{"node":"Validate Input","type":"main","index":0}]]},"Validate Input":{"main":[[{"node":"Valid?","type":"main","index":0}]]},"Valid?":{"main":[[{"node":"Claude Macro Writer","type":"main","index":0}],[{"node":"Return Error","type":"main","index":0}]]},"Claude Macro Writer":{"main":[[{"node":"Parse Result","type":"main","index":0}]]},"Parse Result":{"main":[[{"node":"Build Macros","type":"main","index":0}]]},"Build Macros":{"main":[[{"node":"Has Email?","type":"main","index":0}]]},"Has Email?":{"main":[[{"node":"Email Macros","type":"main","index":0}],[{"node":"Return Result","type":"main","index":0}]]},"Email Macros":{"main":[[{"node":"Return Result","type":"main","index":0}]]}},"pinData":{},"settings":{"executionOrder":"v1","saveManualExecutions":true},"staticData":null,"tags":["support","macros","customer-service","cx"],"triggerCount":0,"updatedAt":"2025-06-20T11:00:00.000Z","versionId":"v1.0.0"}
