{
  "name": "FLOOWBOX - Amazon Product Review Analyzer",
  "meta": { "instanceId": "navtej-floowbox-n8n-2025" },
  "nodes": [
    { "id": "n1", "name": "Review Analysis Webhook", "type": "n8n-nodes-base.webhook", "position": [240, 300], "parameters": { "path": "amazon-reviews", "httpMethod": "POST", "responseMode": "responseNode" }, "typeVersion": 2 },
    { "id": "n2", "name": "Set Product Config", "type": "n8n-nodes-base.set", "position": [460, 300], "parameters": { "assignments": { "assignments": [ {"id":"ar1","name":"asin","type":"string","value":"={{ $json.asin }}"}, {"id":"ar2","name":"product_name","type":"string","value":"={{ $json.product_name || '' }}"}, {"id":"ar3","name":"competitor_asin","type":"string","value":"={{ $json.competitor_asin || '' }}"} ] } }, "typeVersion": 3.4 },
    { "id": "n3", "name": "Scrape Reviews via Apify", "type": "n8n-nodes-base.httpRequest", "position": [680, 200], "parameters": { "method": "POST", "url": "https://api.apify.com/v2/acts/junglee~amazon-reviews-scraper/runs", "authentication": "genericCredentialType", "genericAuthType": "httpHeaderAuth", "sendBody": true, "specifyBody": "json", "jsonBody": "={\n  \"ASIN\": \"{{ $json.asin }}\",\n  \"maxReviews\": 100,\n  \"filterByRating\": \"all\",\n  \"sortBy\": \"recent\"\n}" }, "typeVersion": 4.2 },
    { "id": "n4", "name": "Wait for Scrape", "type": "n8n-nodes-base.wait", "position": [900, 200], "parameters": { "amount": 45, "unit": "seconds" }, "typeVersion": 1.1 },
    { "id": "n5", "name": "Fetch Reviews Data", "type": "n8n-nodes-base.httpRequest", "position": [1100, 200], "parameters": { "url": "=https://api.apify.com/v2/acts/junglee~amazon-reviews-scraper/runs/{{ $('Scrape Reviews via Apify').item.json.data.id }}/dataset/items", "authentication": "genericCredentialType", "genericAuthType": "httpHeaderAuth" }, "typeVersion": 4.2 },
    { "id": "n6", "name": "Process Reviews", "type": "n8n-nodes-base.code", "position": [1300, 200], "parameters": { "jsCode": "const reviews = $input.item.json || [];\nconst arr = Array.isArray(reviews) ? reviews : [];\nconst sample = arr.slice(0, 50);\nconst ratings = sample.map(r => r.ratingScore || 0);\nconst avgRating = ratings.length ? (ratings.reduce((a,b)=>a+b,0)/ratings.length).toFixed(1) : 0;\nconst fiveStar = sample.filter(r=>r.ratingScore===5).length;\nconst oneStar = sample.filter(r=>r.ratingScore===1).length;\nconst reviewTexts = sample.map(r=>({rating: r.ratingScore, title: r.reviewTitle, text: (r.reviewDescription||'').substring(0,200)}));\nreturn [{ json: { reviews: reviewTexts, avg_rating: avgRating, total: arr.length, five_star: fiveStar, one_star: oneStar, asin: $('Set Product Config').item.json.asin } }];" }, "typeVersion": 2 },
    { "id": "n7", "name": "Analyze Reviews with AI", "type": "@n8n/n8n-nodes-langchain.chainLlm", "position": [1500, 300], "parameters": { "promptType": "define", "text": "=Analyze these Amazon product reviews and extract actionable insights.\n\nProduct ASIN: {{ $('Set Product Config').item.json.asin }}\nProduct: {{ $('Set Product Config').item.json.product_name }}\nAverage Rating: {{ $('Process Reviews').item.json.avg_rating }}/5\nTotal Reviews Analyzed: {{ $('Process Reviews').item.json.total }}\n\nReviews sample:\n{{ JSON.stringify($('Process Reviews').item.json.reviews) }}\n\nReturn JSON:\n{\n  \"overall_sentiment\": \"positive/mixed/negative\",\n  \"top_praised_features\": [],\n  \"top_complaints\": [],\n  \"recurring_keywords\": [],\n  \"competitor_mentions\": [],\n  \"quality_issues\": [],\n  \"listing_improvement_suggestions\": [],\n  \"response_needed_reviews\": [{\"issue\": \"\", \"review_type\": \"1-star/2-star\", \"suggested_response\": \"\"}],\n  \"product_development_insights\": [],\n  \"summary\": \"3-4 sentence analysis\"\n}" }, "typeVersion": 1.5 },
    { "id": "n8", "name": "OpenAI GPT-4o", "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi", "position": [1500, 460], "parameters": { "model": "gpt-4o", "options": {} }, "typeVersion": 1 },
    { "id": "n9", "name": "Parse Analysis", "type": "n8n-nodes-base.code", "position": [1700, 300], "parameters": { "jsCode": "const raw = $input.item.json.text.replace(/```json|```/g,'').trim();\nreturn [{ json: JSON.parse(raw) }];" }, "typeVersion": 2 },
    { "id": "n10", "name": "Save to Notion", "type": "n8n-nodes-base.notion", "position": [1900, 200], "parameters": { "resource": "page", "operation": "create", "databaseId": "YOUR_NOTION_DB_ID", "title": "=Amazon Reviews — {{ $('Set Product Config').item.json.asin }} — {{ $now.toFormat('MMM yyyy') }}", "propertiesUi": { "propertyValues": [{"key": "ASIN", "textValue": "={{ $('Set Product Config').item.json.asin }}"}, {"key": "Sentiment", "selectValue": "={{ $json.overall_sentiment }}"}] } }, "typeVersion": 2.2 },
    { "id": "n11", "name": "Respond with Analysis", "type": "n8n-nodes-base.respondToWebhook", "position": [1900, 420], "parameters": { "respondWith": "json", "responseBody": "={{ JSON.stringify($json) }}" }, "typeVersion": 1.1 },
    { "id": "n12", "name": "Sticky Note", "type": "n8n-nodes-base.stickyNote", "position": [220, 140], "parameters": { "content": "## FLOOWBOX - Amazon Review Analyzer\nSend ASIN via webhook.\nApify scrapes up to 100 recent reviews.\nGPT-4o analyzes: top praises, complaints, keywords, competitor mentions.\nGenerates listing improvement suggestions.\nIdentifies reviews needing seller responses with draft replies.\nSaves to Notion + responds with full analysis.\n\nApify actor: junglee~amazon-reviews-scraper" }, "typeVersion": 1 }
  ],
  "connections": {
    "Review Analysis Webhook": {"main": [[{"node": "Set Product Config", "type": "main", "index": 0}]]},
    "Set Product Config": {"main": [[{"node": "Scrape Reviews via Apify", "type": "main", "index": 0}]]},
    "Scrape Reviews via Apify": {"main": [[{"node": "Wait for Scrape", "type": "main", "index": 0}]]},
    "Wait for Scrape": {"main": [[{"node": "Fetch Reviews Data", "type": "main", "index": 0}]]},
    "Fetch Reviews Data": {"main": [[{"node": "Process Reviews", "type": "main", "index": 0}]]},
    "Process Reviews": {"main": [[{"node": "Analyze Reviews with AI", "type": "main", "index": 0}]]},
    "Analyze Reviews with AI": {"main": [[{"node": "Parse Analysis", "type": "main", "index": 0}]]},
    "OpenAI GPT-4o": {"ai_languageModel": [[{"node": "Analyze Reviews with AI", "type": "ai_languageModel", "index": 0}]]},
    "Parse Analysis": {"main": [[{"node": "Save to Notion", "type": "main", "index": 0}], [{"node": "Respond with Analysis", "type": "main", "index": 0}]]}
  },
  "active": false,
  "settings": {"executionOrder": "v1"}
}
