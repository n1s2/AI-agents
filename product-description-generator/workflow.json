{
  "name": "FLOOWBOX - Product Description Generator (SEO Optimized)",
  "meta": { "instanceId": "navtej-floowbox-n8n-2025" },
  "nodes": [
    { "id": "n1", "name": "Product Data Webhook", "type": "n8n-nodes-base.webhook", "position": [240, 300], "parameters": { "path": "generate-description", "httpMethod": "POST", "responseMode": "responseNode" }, "typeVersion": 2 },
    { "id": "n2", "name": "Set Product Data", "type": "n8n-nodes-base.set", "position": [460, 300], "parameters": { "assignments": { "assignments": [ {"id":"pd1","name":"product_name","type":"string","value":"={{ $json.name }}"}, {"id":"pd2","name":"category","type":"string","value":"={{ $json.category }}"}, {"id":"pd3","name":"features","type":"string","value":"={{ JSON.stringify($json.features) }}"}, {"id":"pd4","name":"target_audience","type":"string","value":"={{ $json.audience || 'general consumers' }}"}, {"id":"pd5","name":"tone","type":"string","value":"={{ $json.tone || 'professional' }}"}, {"id":"pd6","name":"platform","type":"string","value":"={{ $json.platform || 'website' }}"} ] } }, "typeVersion": 3.4 },
    { "id": "n3", "name": "Research Keywords", "type": "n8n-nodes-base.httpRequest", "position": [680, 200], "parameters": { "method": "POST", "url": "https://api.perplexity.ai/chat/completions", "authentication": "genericCredentialType", "genericAuthType": "httpHeaderAuth", "sendBody": true, "specifyBody": "json", "jsonBody": "={\n  \"model\": \"sonar\",\n  \"messages\": [{\"role\": \"user\", \"content\": \"What are the top SEO keywords people search for when looking for {{ $json.product_name }} in {{ $json.category }}? Include long-tail keywords, buying intent phrases, and semantic variants. Provide 15-20 keywords with approximate monthly search volume context.\"}],\n  \"search_recency_filter\": \"month\"\n}" }, "typeVersion": 4.2 },
    { "id": "n4", "name": "Generate All Descriptions", "type": "@n8n/n8n-nodes-langchain.chainLlm", "position": [900, 300], "parameters": { "promptType": "define", "text": "=Write SEO-optimized product descriptions for multiple platforms.\n\nProduct: {{ $json.product_name }}\nCategory: {{ $json.category }}\nFeatures: {{ $json.features }}\nTarget Audience: {{ $json.target_audience }}\nTone: {{ $json.tone }}\nPlatform: {{ $json.platform }}\n\nSEO Keywords to incorporate:\n{{ $('Research Keywords').item.json.choices[0].message.content }}\n\nGenerate:\n1. Long description (300-400 words, for website product page)\n2. Short description (50-80 words, for category/listing page)\n3. Amazon bullet points (5 bullets, keyword-rich)\n4. Meta description (150-160 chars, for SEO)\n5. Social media caption (Instagram/Facebook friendly)\n\nReturn JSON:\n{\n  \"long_description\": \"\",\n  \"short_description\": \"\",\n  \"amazon_bullets\": [],\n  \"meta_description\": \"\",\n  \"social_caption\": \"\",\n  \"primary_keywords_used\": [],\n  \"readability_score\": \"easy/medium/advanced\"\n}" }, "typeVersion": 1.5 },
    { "id": "n5", "name": "OpenAI GPT-4o", "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi", "position": [900, 460], "parameters": { "model": "gpt-4o", "options": {} }, "typeVersion": 1 },
    { "id": "n6", "name": "Parse Descriptions", "type": "n8n-nodes-base.code", "position": [1120, 300], "parameters": { "jsCode": "const raw = $input.item.json.text.replace(/```json|```/g,'').trim();\nreturn [{ json: JSON.parse(raw) }];" }, "typeVersion": 2 },
    { "id": "n7", "name": "Save to Google Sheets", "type": "n8n-nodes-base.googleSheets", "position": [1340, 200], "parameters": { "operation": "appendOrUpdate", "documentId": "YOUR_SHEET_ID", "sheetName": "Product Descriptions", "fieldsUi": { "fieldValues": [ {"fieldId": "Date", "fieldValue": "={{ $now.toFormat('yyyy-MM-dd') }}"}, {"fieldId": "Product", "fieldValue": "={{ $('Set Product Data').item.json.product_name }}"}, {"fieldId": "Short Description", "fieldValue": "={{ $json.short_description }}"}, {"fieldId": "Meta Description", "fieldValue": "={{ $json.meta_description }}"} ] } }, "typeVersion": 4.4 },
    { "id": "n8", "name": "Respond with All Versions", "type": "n8n-nodes-base.respondToWebhook", "position": [1340, 420], "parameters": { "respondWith": "json", "responseBody": "={{ JSON.stringify($json) }}" }, "typeVersion": 1.1 },
    { "id": "n9", "name": "Sticky Note", "type": "n8n-nodes-base.stickyNote", "position": [220, 140], "parameters": { "content": "## FLOOWBOX - Product Description Generator\nSend product name, features, category, audience, tone.\nPerplexity researches actual SEO keywords for that product.\nGPT-4o writes 5 versions simultaneously:\n- Long description (website)\n- Short description (listing)\n- Amazon bullet points\n- Meta description (SEO)\n- Social media caption\nSaves to Google Sheets + responds with all versions." }, "typeVersion": 1 }
  ],
  "connections": {
    "Product Data Webhook": {"main": [[{"node": "Set Product Data", "type": "main", "index": 0}]]},
    "Set Product Data": {"main": [[{"node": "Research Keywords", "type": "main", "index": 0}]]},
    "Research Keywords": {"main": [[{"node": "Generate All Descriptions", "type": "main", "index": 0}]]},
    "Generate All Descriptions": {"main": [[{"node": "Parse Descriptions", "type": "main", "index": 0}]]},
    "OpenAI GPT-4o": {"ai_languageModel": [[{"node": "Generate All Descriptions", "type": "ai_languageModel", "index": 0}]]},
    "Parse Descriptions": {"main": [[{"node": "Save to Google Sheets", "type": "main", "index": 0}], [{"node": "Respond with All Versions", "type": "main", "index": 0}]]}
  },
  "active": false,
  "settings": {"executionOrder": "v1"}
}
