{
  "name": "FLOOWBOX - Database Backup Notifier",
  "nodes": [
    { "id": "b2c3d4e5-0001-4000-8000-000000000001", "name": "Daily at 7 AM", "type": "n8n-nodes-base.scheduleTrigger", "typeVersion": 1.2, "position": [250, 300], "parameters": { "rule": { "interval": [{"field": "days", "triggerAtHour": 7}] } } },
    { "id": "b2c3d4e5-0002-4000-8000-000000000002", "name": "Fetch Backup Log", "type": "n8n-nodes-base.googleSheets", "typeVersion": 4.4, "position": [500, 300], "parameters": { "operation": "readRows", "documentId": "YOUR_BACKUP_SHEET_ID", "sheetName": "Backup Log" } },
    { "id": "b2c3d4e5-0003-4000-8000-000000000003", "name": "Check Freshness", "type": "n8n-nodes-base.code", "typeVersion": 2, "position": [750, 300], "parameters": { "jsCode": "const rows = $input.all().map(i => i.json);\nconst now = new Date();\nconst results = rows.map(row => {\n  const lastBackup = new Date(row['Last Backup']);\n  const hoursAgo = (now - lastBackup) / (1000 * 60 * 60);\n  const maxAge = parseInt(row['Max Age Hours'] || 24);\n  return { database: row['Database'], hours_ago: hoursAgo.toFixed(1), max_age: maxAge, stale: hoursAgo > maxAge };\n});\nconst stale = results.filter(r => r.stale);\nreturn [{ json: { results, stale_count: stale.length, stale_databases: stale, all_healthy: stale.length === 0 } }];" } },
    { "id": "b2c3d4e5-0004-4000-8000-000000000004", "name": "Any Stale?", "type": "n8n-nodes-base.if", "typeVersion": 2.2, "position": [1000, 300], "parameters": { "conditions": { "conditions": [{"leftValue": "={{ $json.all_healthy }}", "rightValue": false, "operator": {"type": "boolean", "operation": "equal"}}] } } },
    { "id": "b2c3d4e5-0005-4000-8000-000000000005", "name": "Stale Alert", "type": "n8n-nodes-base.slack", "typeVersion": 2.2, "position": [1250, 180], "parameters": { "operation": "post", "channel": "#alerts", "text": "=⚠️ *Stale Backup Alert*\n{{ $json.stale_databases.map(d=>`• ${d.database}: ${d.hours_ago}h ago (max ${d.max_age}h)`).join('\\n') }}" } },
    { "id": "b2c3d4e5-0006-4000-8000-000000000006", "name": "Daily Digest", "type": "n8n-nodes-base.slack", "typeVersion": 2.2, "position": [1250, 420], "parameters": { "operation": "post", "channel": "#devops", "text": "=💾 *Backup Status — {{ $now.toFormat('MMM dd') }}*\n✅ All {{ $json.results.length }} databases healthy\n{{ $json.results.map(r=>`• ${r.database}: ${r.hours_ago}h ago`).join('\\n') }}" } }
  ],
  "connections": {
    "Daily at 7 AM": {"main": [[{"node": "Fetch Backup Log", "type": "main", "index": 0}]]},
    "Fetch Backup Log": {"main": [[{"node": "Check Freshness", "type": "main", "index": 0}]]},
    "Check Freshness": {"main": [[{"node": "Any Stale?", "type": "main", "index": 0}]]},
    "Any Stale?": {"main": [[{"node": "Stale Alert", "type": "main", "index": 0}], [{"node": "Daily Digest", "type": "main", "index": 0}]]}
  },
  "active": false,
  "settings": { "executionOrder": "v1" },
  "id": "b2c3d4e5-0000-4000-8000-000000000036",
  "versionId": "b2c3d4e5-0000-4000-8000-000000000136",
  "meta": { "templateCredsSetupCompleted": true },
  "tags": []
}
