{
  "name": "FLOOWBOX - Personal Finance Advisor Agent",
  "meta": { "instanceId": "navtej-floowbox-n8n-2025" },
  "nodes": [
    { "id": "n1", "name": "Monthly Finance Trigger", "type": "n8n-nodes-base.scheduleTrigger", "position": [240, 300], "parameters": { "rule": { "interval": [{"field": "months", "triggerAtDayOfMonth": 1, "triggerAtHour": 9}] } }, "typeVersion": 1.2 },
    { "id": "n2", "name": "Fetch Bank Transactions", "type": "n8n-nodes-base.googleSheets", "position": [460, 300], "parameters": { "operation": "readRows", "documentId": "YOUR_TRANSACTIONS_SHEET_ID", "sheetName": "Current Month" }, "typeVersion": 4.4 },
    { "id": "n3", "name": "Fetch Last Month", "type": "n8n-nodes-base.googleSheets", "position": [460, 480], "parameters": { "operation": "readRows", "documentId": "YOUR_TRANSACTIONS_SHEET_ID", "sheetName": "Last Month" }, "typeVersion": 4.4 },
    { "id": "n4", "name": "Aggregate Transactions", "type": "n8n-nodes-base.aggregate", "position": [680, 300], "parameters": { "aggregate": "aggregateAllItemData", "options": {} }, "typeVersion": 1 },
    { "id": "n5", "name": "Aggregate Last Month", "type": "n8n-nodes-base.aggregate", "position": [680, 480], "parameters": { "aggregate": "aggregateAllItemData", "options": {} }, "typeVersion": 1 },
    { "id": "n6", "name": "Merge Both Months", "type": "n8n-nodes-base.merge", "position": [900, 380], "parameters": { "mode": "combine", "combineBy": "combineAll", "options": {} }, "typeVersion": 3 },
    { "id": "n7", "name": "Finance Analysis Agent", "type": "@n8n/n8n-nodes-langchain.chainLlm", "position": [1100, 380], "parameters": { "promptType": "define", "text": "=Analyze this month's personal finances and provide actionable advice.\n\nThis Month Transactions:\n{{ JSON.stringify($('Aggregate Transactions').item.json.data) }}\n\nLast Month Transactions:\n{{ JSON.stringify($('Aggregate Last Month').item.json.data) }}\n\nAnalyze:\n1. Total income vs expenses\n2. Spending by category (food, transport, entertainment, utilities, subscriptions)\n3. Month-over-month changes\n4. Unusual or one-time expenses\n5. Savings rate\n6. Subscriptions that might be unused\n\nReturn JSON:\n{\n  \"total_income\": 0,\n  \"total_expenses\": 0,\n  \"savings\": 0,\n  \"savings_rate_percent\": 0,\n  \"spending_by_category\": [{\"category\": \"\", \"amount\": 0, \"vs_last_month\": \"\"}],\n  \"biggest_changes\": [],\n  \"unusual_expenses\": [],\n  \"subscription_audit\": [{\"name\": \"\", \"amount\": 0, \"last_used\": \"\", \"keep\": true}],\n  \"top_3_savings_opportunities\": [],\n  \"monthly_summary\": \"plain English 3-4 sentence summary\",\n  \"action_items\": []\n}" }, "typeVersion": 1.5 },
    { "id": "n8", "name": "OpenAI GPT-4o", "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi", "position": [1100, 540], "parameters": { "model": "gpt-4o", "options": {} }, "typeVersion": 1 },
    { "id": "n9", "name": "Parse Analysis", "type": "n8n-nodes-base.code", "position": [1300, 380], "parameters": { "jsCode": "const raw = $input.item.json.text.replace(/```json|```/g,'').trim();\nreturn [{ json: JSON.parse(raw) }];" }, "typeVersion": 2 },
    { "id": "n10", "name": "Save Monthly Report", "type": "n8n-nodes-base.googleSheets", "position": [1500, 260], "parameters": { "operation": "appendOrUpdate", "documentId": "YOUR_TRANSACTIONS_SHEET_ID", "sheetName": "Monthly Reports", "fieldsUi": { "fieldValues": [ {"fieldId": "Month", "fieldValue": "={{ $now.toFormat('MMMM yyyy') }}"}, {"fieldId": "Income", "fieldValue": "={{ $json.total_income }}"}, {"fieldId": "Expenses", "fieldValue": "={{ $json.total_expenses }}"}, {"fieldId": "Savings", "fieldValue": "={{ $json.savings }}"}, {"fieldId": "Savings Rate", "fieldValue": "={{ $json.savings_rate_percent }}%"}, {"fieldId": "Summary", "fieldValue": "={{ $json.monthly_summary }}"} ] } }, "typeVersion": 4.4 },
    { "id": "n11", "name": "Send Monthly Report Email", "type": "n8n-nodes-base.emailSend", "position": [1500, 440], "parameters": { "toEmail": "navtej@floowbox.com", "fromEmail": "finance-bot@floowbox.com", "subject": "=Monthly Finance Report — {{ $now.toFormat('MMMM yyyy') }}", "html": "=<h2>Monthly Finance Summary</h2><p>{{ $json.monthly_summary }}</p><table border='1' cellpadding='8'><tr><th>Metric</th><th>Amount</th></tr><tr><td>Total Income</td><td>₹{{ $json.total_income }}</td></tr><tr><td>Total Expenses</td><td>₹{{ $json.total_expenses }}</td></tr><tr><td>Savings</td><td>₹{{ $json.savings }}</td></tr><tr><td>Savings Rate</td><td>{{ $json.savings_rate_percent }}%</td></tr></table><h3>Top Savings Opportunities</h3><ul>{{ $json.top_3_savings_opportunities.map(o=>`<li>${o}</li>`).join('') }}</ul><h3>Action Items</h3><ul>{{ $json.action_items.map(a=>`<li>${a}</li>`).join('') }}</ul>", "options": {} }, "typeVersion": 2.1 },
    { "id": "n12", "name": "Sticky Note", "type": "n8n-nodes-base.stickyNote", "position": [220, 140], "parameters": { "content": "## FLOOWBOX - Personal Finance Advisor\nRuns on 1st of every month.\nFetches this month + last month transactions from Google Sheets.\nGPT-4o analyzes: income, expenses, savings rate, subscription audit.\nIdentifies savings opportunities and unused subscriptions.\nSaves to monthly report sheet + email digest.\n\nTransaction sheet format: Date, Description, Category, Amount, Type (income/expense)" }, "typeVersion": 1 }
  ],
  "connections": {
    "Monthly Finance Trigger": {"main": [[{"node": "Fetch Bank Transactions", "type": "main", "index": 0}], [{"node": "Fetch Last Month", "type": "main", "index": 0}]]},
