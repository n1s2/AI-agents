{"name":"Product Launch Checklist Builder Agent","nodes":[{"parameters":{"httpMethod":"POST","path":"build-launch-checklist","responseMode":"responseNode","options":{}},"id":"z9a1b2c3d4-0001","name":"Webhook","type":"n8n-nodes-base.webhook","typeVersion":2,"position":[200,320]},{"parameters":{"jsCode":"const body=$input.first().json.body;const required=['launch_name','launch_date'];const missing=required.filter(f=>!body[f]);if(missing.length)return[{json:{valid:false,error:'Missing: '+missing.join(', ')}}];const launchSizes=['small','medium','major'];const launchSize=launchSizes.includes(body.launch_size)?body.launch_size:'medium';return[{json:{valid:true,launchName:body.launch_name.trim(),launchDate:body.launch_date,launchSize,featureDescription:(body.feature_description||'').slice(0,600),targetAudience:(body.target_audience||'').slice(0,300),teamsInvolved:Array.isArray(body.teams_involved)?body.teams_involved:(body.teams_involved||'').split(',').map(t=>t.trim()).filter(Boolean),hasPricingChange:body.has_pricing_change===true||body.has_pricing_change==='true',hasBreakingChanges:body.has_breaking_changes===true||body.has_breaking_changes==='true',pressOutreachPlanned:body.press_outreach_planned===true||body.press_outreach_planned==='true',replyEmail:body.reply_email||null}}];"},"id":"z9a1b2c3d4-0002","name":"Validate Input","type":"n8n-nodes-base.code","typeVersion":2,"position":[420,320]},{"parameters":{"conditions":{"conditions":[{"id":"cv","leftValue":"={{ $json.valid }}","rightValue":true,"operator":{"type":"boolean","operation":"true"}}],"combinator":"and"}},"id":"z9a1b2c3d4-0003","name":"Valid?","type":"n8n-nodes-base.if","typeVersion":2,"position":[640,320]},{"parameters":{"respondWith":"json","responseBody":"={{ { error: $json.error, status: 400 } }}"},"id":"z9a1b2c3d4-0004","name":"Return Error","type":"n8n-nodes-base.respondToWebhook","typeVersion":1,"position":[860,480]},{"parameters":{"model":"claude-sonnet-4-20250514","options":{"temperature":0.4,"maxTokens":2800},"messages":{"values":[{"content":"You build product launch checklists spanning all functions — engineering, product, marketing, sales, support, and legal. Good launch checklists have specific, assigned, dated items, not generic reminders, and account for the specific complications this launch has (pricing changes, breaking changes, press). Always respond in valid JSON only.","role":"system"},{"content":"Build a launch checklist.\n\nLaunch: {{ $json.launchName }}\nDate: {{ $json.launchDate }}\nSize: {{ $json.launchSize }}\nFeature: {{ $json.featureDescription || 'not specified' }}\nTarget audience: {{ $json.targetAudience || 'not specified' }}\nTeams involved: {{ $json.teamsInvolved.join(', ') || 'not specified' }}\nHas pricing change: {{ $json.hasPricingChange }}\nHas breaking changes: {{ $json.hasBreakingChanges }}\nPress outreach planned: {{ $json.pressOutreachPlanned }}\n\nReturn JSON:\n{\"launch_summary\":\"2-3 sentences on launch scope and key complications to manage\",\"phases\":[{\"phase\":\"e.g. 4 weeks before, 1 week before, launch day, 1 week after\",\"items\":[{\"item\":\"\",\"owner_team\":\"engineering|product|marketing|sales|support|legal|design\",\"priority\":\"critical|important|nice_to_have\",\"details\":\"\"}]}],\"cross_team_dependencies\":[{\"dependency\":\"\",\"blocking_team\":\"\",\"blocked_team\":\"\",\"needed_by\":\"\"}],\"risk_items\":[{\"risk\":\"\",\"mitigation\":\"\"}],\"launch_day_runbook\":[\"specific sequential steps for launch day itself\"],\"rollback_trigger\":\"what would trigger pulling back the launch\",\"success_metrics\":[{\"metric\":\"\",\"target\":\"\",\"measurement_window\":\"\"}],\"post_launch_review_date\":\"suggested timing for a launch retro\"}","role":"user"}]}},"id":"z9a1b2c3d4-0005","name":"Claude Checklist Builder","type":"@n8n/n8n-nodes-langchain.lmChatAnthropic","typeVersion":1.3,"position":[860,240]},{"parameters":{"jsCode":"const raw=$input.first().json.text||$input.first().json.content?.[0]?.text||'';let result;try{result=JSON.parse(raw.replace(/```json|```/g,'').trim());}catch(e){return[{json:{error:'Parse error'}}];}const input=$('Validate Input').first().json;result._meta={launchName:input.launchName,launchDate:input.launchDate,launchSize:input.launchSize,replyEmail:input.replyEmail};return[{json:result}];"},"id":"z9a1b2c3d4-0006","name":"Parse Result","type":"n8n-nodes-base.code","typeVersion":2,"position":[1080,240]},{"parameters":{"jsCode":"const r=$input.first().json;const m=r._meta;function esc(s){return String(s||'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');}const teamColors={engineering:'#2563eb',product:'#7c3aed',marketing:'#d97706',sales:'#16a34a',support:'#0891b2',legal:'#dc2626',design:'#ec4899'};const prioColors={critical:'#dc2626',important:'#d97706',nice_to_have:'#6b7280'};const phases=(r.phases||[]).map(ph=>{const items=(ph.items||[]).map(it=>{const tc=teamColors[it.owner_team]||'#6b7280';const pc=prioColors[it.priority]||'#6b7280';return '<div style=\"display:flex;gap:8px;align-items:flex-start;padding:6px 0;border-bottom:1px solid #f3f4f6\"><input type=\"checkbox\" style=\"margin-top:3px\"><div style=\"flex:1\"><div style=\"display:flex;gap:6px;align-items:center;flex-wrap:wrap\"><span style=\"font-size:13px\">'+esc(it.item)+'</span><span style=\"background:'+tc+'22;color:'+tc+';font-size:9px;font-weight:700;padding:1px 6px;border-radius:4px\">'+esc(it.owner_team)+'</span><span style=\"background:'+pc+'22;color:'+pc+';font-size:9px;font-weight:700;padding:1px 6px;border-radius:4px\">'+esc(it.priority.replace(/_/g,' '))+'</span></div>'+(it.details?'<div style=\"font-size:11px;color:#9ca3af\">'+esc(it.details)+'</div>':'')+'</div></div>';}).join('');return '<div style=\"margin-bottom:16px\"><div style=\"font-size:13px;font-weight:700;text-transform:uppercase;color:#1e293b;margin-bottom:6px;padding-bottom:4px;border-bottom:2px solid #e5e7eb\">'+esc(ph.phase)+'</div>'+items+'</div>';}).join('');const deps=(r.cross_team_dependencies||[]).map(d=>'<div style=\"border-left:3px solid #7c3aed;padding:8px 12px;background:#f5f3ff;border-radius:0 4px 4px 0;margin-bottom:6px\"><div style=\"font-size:13px;font-weight:700\">'+esc(d.dependency)+'</div><div style=\"font-size:12px;color:#6b7280\">'+esc(d.blocking_team)+' \u2192 '+esc(d.blocked_team)+' \u00b7 needed by '+esc(d.needed_by)+'</div></div>').join('');const risks=(r.risk_items||[]).map(rk=>'<div style=\"border-left:3px solid #dc2626;padding:8px 12px;background:#fafafa;border-radius:0 4px 4px 0;margin-bottom:6px\"><div style=\"font-size:13px;font-weight:700\">'+esc(rk.risk)+'</div><div style=\"font-size:12px;color:#2563eb\">\u2192 '+esc(rk.mitigation)+'</div></div>').join('');const runbook=(r.launch_day_runbook||[]).map((s,i)=>'<div style=\"font-size:13px;padding:5px 0;border-bottom:1px solid #eff6ff;color:#1e40af\">'+(i+1)+'. '+esc(s)+'</div>').join('');const metrics=(r.success_metrics||[]).map(sm=>'<div style=\"border:1px solid #e5e7eb;border-radius:5px;padding:8px 12px;margin-bottom:6px\"><div style=\"display:flex;justify-content:space-between\"><span style=\"font-size:13px;font-weight:600\">'+esc(sm.metric)+'</span><span style=\"font-size:13px;font-weight:700;color:#16a34a\">'+esc(sm.target)+'</span></div><div style=\"font-size:11px;color:#9ca3af\">'+esc(sm.measurement_window)+'</div></div>').join('');const html='<!DOCTYPE html><html><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"></head><body style=\"margin:0;padding:16px;background:#f9fafb;font-family:sans-serif;color:#111\"><div style=\"max-width:780px;margin:0 auto\"><div style=\"background:#1e293b;color:#fff;padding:18px 26px;border-radius:10px 10px 0 0\"><div style=\"font-size:11px;text-transform:uppercase;color:#64748b\">Launch Checklist \u00b7 '+esc(m.launchSize)+'</div><div style=\"font-size:18px;font-weight:700\">'+esc(m.launchName)+'</div><div style=\"font-size:13px;color:#94a3b8\">Launch date: '+esc(m.launchDate)+'</div></div><div style=\"background:#fff;padding:14px 26px;border:1px solid #e5e7eb;border-top:none\"><p style=\"font-size:14px;color:#374151;margin:0\">'+esc(r.launch_summary)+'</p></div><div style=\"background:#fff;padding:18px 26px;border:1px solid #e5e7eb;border-top:3px solid #f3f4f6\">'+phases+'</div>'+(deps?'<div style=\"background:#fff;padding:14px 26px;border:1px solid #e5e7eb;border-top:3px solid #f3f4f6\"><div style=\"font-size:11px;font-weight:700;text-transform:uppercase;color:#7c3aed;margin-bottom:8px\">Cross-team dependencies</div>'+deps+'</div>':'')+(risks?'<div style=\"background:#fff;padding:14px 26px;border:1px solid #e5e7eb;border-top:3px solid #f3f4f6\"><div style=\"font-size:11px;font-weight:700;text-transform:uppercase;color:#dc2626;margin-bottom:8px\">Risk items</div>'+risks+'</div>':'')+(runbook?'<div style=\"background:#eff6ff;padding:14px 26px;border:1px solid #bfdbfe\"><div style=\"font-size:11px;font-weight:700;text-transform:uppercase;color:#1d4ed8;margin-bottom:7px\">Launch day runbook</div>'+runbook+'</div>':'')+(r.rollback_trigger?'<div style=\"background:#fef2f2;padding:10px 26px;border:1px solid #fecaca\"><div style=\"font-size:11px;font-weight:700;text-transform:uppercase;color:#dc2626;margin-bottom:3px\">Rollback trigger</div><div style=\"font-size:13px;color:#7f1d1d\">'+esc(r.rollback_trigger)+'</div></div>':'')+(metrics?'<div style=\"background:#fff;padding:14px 26px;border:1px solid #e5e7eb;border-top:3px solid #f3f4f6\"><div style=\"font-size:11px;font-weight:700;text-transform:uppercase;color:#9ca3af;margin-bottom:7px\">Success metrics</div>'+metrics+(r.post_launch_review_date?'<div style=\"font-size:12px;color:#9ca3af;margin-top:6px\">Review scheduled: '+esc(r.post_launch_review_date)+'</div>':'')+'</div>':'')+'<div style=\"background:#1e293b;color:#475569;font-size:11px;padding:10px 26px;border-radius:0 0 10px 10px;text-align:center\">Launch Checklist \u00b7 '+esc(m.launchName)+'</div></div></body></html>';return[{json:{html,replyEmail:m.replyEmail,launchName:m.launchName,result:r}}];"},"id":"z9a1b2c3d4-0007","name":"Build Checklist","type":"n8n-nodes-base.code","typeVersion":2,"position":[1300,240]},{"parameters":{"conditions":{"conditions":[{"id":"ce","leftValue":"={{ $json.replyEmail }}","rightValue":"","operator":{"type":"string","operation":"notEmpty"}}],"combinator":"and"}},"id":"z9a1b2c3d4-0008","name":"Has Email?","type":"n8n-nodes-base.if","typeVersion":2,"position":[1520,240]},{"parameters":{"fromEmail":"={{$env.FROM_EMAIL}}","toEmail":"={{$json.replyEmail}}","subject":"Launch checklist: {{ $json.launchName }}","emailType":"html","message":"={{$json.html}}"},"id":"z9a1b2c3d4-0009","name":"Email Checklist","type":"n8n-nodes-base.emailSend","typeVersion":2.1,"position":[1740,180],"credentials":{"smtp":{"id":"smtp-creds-01","name":"SMTP Account"}}},{"parameters":{"respondWith":"json","responseBody":"={{ { status: 'built', launch: $json.launchName, emailed: $json.replyEmail ? true : false, result: $json.result } }}"},"id":"z9a1b2c3d4-0010","name":"Return Result","type":"n8n-nodes-base.respondToWebhook","typeVersion":1,"position":[1960,240]}],"connections":{"Webhook":{"main":[[{"node":"Validate Input","type":"main","index":0}]]},"Validate Input":{"main":[[{"node":"Valid?","type":"main","index":0}]]},"Valid?":{"main":[[{"node":"Claude Checklist Builder","type":"main","index":0}],[{"node":"Return Error","type":"main","index":0}]]},"Claude Checklist Builder":{"main":[[{"node":"Parse Result","type":"main","index":0}]]},"Parse Result":{"main":[[{"node":"Build Checklist","type":"main","index":0}]]},"Build Checklist":{"main":[[{"node":"Has Email?","type":"main","index":0}]]},"Has Email?":{"main":[[{"node":"Email Checklist","type":"main","index":0}],[{"node":"Return Result","type":"main","index":0}]]},"Email Checklist":{"main":[[{"node":"Return Result","type":"main","index":0}]]}},"pinData":{},"settings":{"executionOrder":"v1","saveManualExecutions":true},"staticData":null,"tags":["product","launc