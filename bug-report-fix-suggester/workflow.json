{
  "name": "FLOOWBOX - Bug Report to Fix Suggester Agent",
  "meta": { "instanceId": "navtej-floowbox-n8n-2025" },
  "nodes": [
    { "id": "n1", "name": "GitHub Issue Webhook", "type": "n8n-nodes-base.webhook", "position": [240, 300], "parameters": { "path": "github-issue", "httpMethod": "POST", "responseMode": "responseNode" }, "typeVersion": 2 },
    { "id": "n2", "name": "Filter Bug Reports", "type": "n8n-nodes-base.filter", "position": [460, 300], "parameters": { "conditions": { "conditions": [{"leftValue": "={{ $json.action }}", "rightValue": "opened", "operator": {"type": "string", "operation": "equals"}}, {"leftValue": "={{ $json.issue.labels.map(l=>l.name).includes('bug') }}", "rightValue": true, "operator": {"type": "boolean", "operation": "equal"}}] } }, "typeVersion": 2.2 },
    { "id": "n3", "name": "Extract Issue Data", "type": "n8n-nodes-base.set", "position": [660, 300], "parameters": { "assignments": { "assignments": [ {"id":"br1","name":"issue_number","type":"number","value":"={{ $json.issue.number }}"}, {"id":"br2","name":"title","type":"string","value":"={{ $json.issue.title }}"}, {"id":"br3","name":"body","type":"string","value":"={{ $json.issue.body || '' }}"}, {"id":"br4","name":"repo","type":"string","value":"={{ $json.repository.full_name }}"}, {"id":"br5","name":"labels","type":"string","value":"={{ $json.issue.labels.map(l=>l.name).join(', ') }}"} ] } }, "typeVersion": 3.4 },
    { "id": "n4", "name": "Search Codebase for Context", "type": "n8n-nodes-base.httpRequest", "position": [860, 300], "parameters": { "url": "=https://api.github.com/search/code", "authentication": "genericCredentialType", "genericAuthType": "httpHeaderAuth", "sendQuery": true, "queryParameters": { "parameters": [{"name": "q", "value": "={{ $json.title.split(' ').slice(0,3).join('+') + '+repo:' + $json.repo }}"}, {"name": "per_page", "value": "5"}] } }, "typeVersion": 4.2 },
    { "id": "n5", "name": "Analyze Bug and Suggest Fix", "type": "@n8n/n8n-nodes-langchain.chainLlm", "position": [1060, 300], "parameters": { "promptType": "define", "text": "=Analyze this bug report and suggest a fix.\n\nIssue #{{ $('Extract Issue Data').item.json.issue_number }}: {{ $('Extract Issue Data').item.json.title }}\nDescription:\n{{ $('Extract Issue Data').item.json.body }}\n\nRelated code files found:\n{{ JSON.stringify($json.items?.slice(0,3).map(f=>({name:f.name,path:f.path,url:f.html_url}))) }}\n\nProvide:\n1. Root cause analysis\n2. Exact fix with code example\n3. How to test the fix\n4. Whether this could affect other parts of the codebase\n\nReturn JSON:\n{\n  \"root_cause\": \"\",\n  \"severity\": \"critical/high/medium/low\",\n  \"fix_summary\": \"one sentence\",\n  \"code_fix\": \"code snippet showing the fix\",\n  \"files_to_change\": [],\n  \"test_steps\": [],\n  \"regression_risk\": \"low/medium/high\",\n  \"regression_areas\": [],\n  \"estimated_fix_time\": \"30min/2h/1day/2+days\",\n  \"github_comment\": \"full helpful comment to post on the issue\"\n}" }, "typeVersion": 1.5 },
    { "id": "n6", "name": "OpenAI GPT-4o", "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi", "position": [1060, 460], "parameters": { "model": "gpt-4o", "options": {} }, "typeVersion": 1 },
    { "id": "n7", "name": "Parse Fix Suggestion", "type": "n8n-nodes-base.code", "position": [1260, 300], "parameters": { "jsCode": "const raw = $input.item.json.text.replace(/```json|```/g,'').trim();\nconst fix = JSON.parse(raw);\nreturn [{ json: { ...fix, issue: $('Extract Issue Data').item.json } }];" }, "typeVersion": 2 },
    { "id": "n8", "name": "Add Label by Severity", "type": "n8n-nodes-base.httpRequest", "position": [1460, 180], "parameters": { "method": "POST", "url": "=https://api.github.com/repos/{{ $json.issue.repo }}/issues/{{ $json.issue.issue_number }}/labels", "authentication": "genericCredentialType", "genericAuthType": "httpHeaderAuth", "sendBody": true, "specifyBody": "json", "jsonBody": "={\"labels\": [\"{{ $json.severity }}\", \"ai-analyzed\"]}" }, "typeVersion": 4.2 },
    { "id": "n9", "name": "Post Fix Comment", "type": "n8n-nodes-base.httpRequest", "position": [1460, 340], "parameters": { "method": "POST", "url": "=https://api.github.com/repos/{{ $json.issue.repo }}/issues/{{ $json.issue.issue_number }}/comments", "authentication": "genericCredentialType", "genericAuthType": "httpHeaderAuth", "sendBody": true, "specifyBody": "json", "jsonBody": "={\"body\": \"{{ $json.github_comment.replace(/\"/g,'\\\\\"').replace(/\\n/g,'\\\\n') }}\"}" }, "typeVersion": 4.2 },
    { "id": "n10", "name": "Critical Bug Slack Alert", "type": "n8n-nodes-base.if", "position": [1460, 500], "parameters": { "conditions": { "conditions": [{"leftValue": "={{ $json.severity }}", "rightValue": "critical", "operator": {"type": "string", "operation": "equals"}}] } }, "typeVersion": 2.2 },
    { "id": "n11", "name": "Urgent Slack", "type": "n8n-nodes-base.slack", "position": [1660, 420], "parameters": { "operation": "post", "channel": "#engineering", "text": "=🐛 *CRITICAL BUG — Issue #{{ $json.issue.issue_number }}*\n\n*Title:* {{ $json.issue.title }}\n*Root Cause:* {{ $json.root_cause }}\n*Fix:* {{ $json.fix_summary }}\n*Time to Fix:* {{ $json.estimated_fix_time }}\n*Regression Risk:* {{ $json.regression_risk }}\n\nhttps://github.com/{{ $json.issue.repo }}/issues/{{ $json.issue.issue_number }}" }, "typeVersion": 2.2 },
    { "id": "n12", "name": "Respond OK", "type": "n8n-nodes-base.respondToWebhook", "position": [1880, 300], "parameters": { "respondWith": "json", "responseBody": "{\"status\": \"analyzed\"}" }, "typeVersion": 1.1 },
    { "id": "n13", "name": "Sticky Note", "type": "n8n-nodes-base.stickyNote", "position": [220, 140], "parameters": { "content": "## FLOOWBOX - Bug Fix Suggester\nTriggers on GitHub issues labeled 'bug'.\nSearches codebase for relevant files.\nGPT-4o analyzes root cause + suggests exact fix with code.\nPosts fix suggestion as GitHub comment automatically.\nLabels issue by severity.\nCritical bugs trigger Slack alert." }, "typeVersion": 1 }
  ],
  "connections": {
    "GitHub Issue Webhook": {"main": [[{"node": "Filter Bug Reports", "type": "main", "index": 0}]]},
    "Filter Bug Reports": {"main": [[{"node": "Extract Issue Data", "type": "main", "index": 0}]]},
    "Extract Issue Data": {"main": [[{"node": "Search Codebase for Context", "type": "main", "index": 0}]]},
    "Search Codebase for Context": {"main": [[{"node": "Analyze Bug and Suggest Fix", "type": "main", "index": 0}]]},
    "Analyze Bug and Suggest Fix": {"main": [[{"node": "Parse Fix Suggestion", "type": "main", "index": 0}]]},
    "OpenAI GPT-4o": {"ai_languageModel": [[{"node": "Analyze Bug and Suggest Fix", "type": "ai_languageModel", "index": 0}]]},
    "Parse Fix Suggestion": {"main": [[{"node": "Add Label by Severity", "type": "main", "index": 0}], [{"node": "Post Fix Comment", "type": "main", "index": 0}], [{"node": "Critical Bug Slack Alert", "type": "main", "index": 0}]]},
    "Critical Bug Slack Alert": {"main": [[], [{"node": "Urgent Slack", "type": "main", "index": 0}]]},
    "Post Fix Comment": {"main": [[{"node": "Respond OK", "type": "main", "index": 0}]]}
  },
  "active": false,
  "settings": {"executionOrder": "v1"}
}
