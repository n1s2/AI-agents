{
  "name": "FLOOWBOX - YouTube Thumbnail A/B Test Tracker",
  "meta": { "instanceId": "navtej-floowbox-n8n-2025" },
  "nodes": [
    { "id": "n1", "name": "Daily Check", "type": "n8n-nodes-base.scheduleTrigger", "position": [240, 300], "parameters": { "rule": { "interval": [{"field": "days", "triggerAtHour": 10}] } }, "typeVersion": 1.2 },
    { "id": "n2", "name": "Fetch Videos Under Test", "type": "n8n-nodes-base.airtable", "position": [460, 300], "parameters": { "operation": "search", "baseId": "YOUR_AIRTABLE_BASE_ID", "tableId": "Thumbnail Tests", "filterByFormula": "{Status} = 'Testing'" }, "typeVersion": 2.1 },
    { "id": "n3", "name": "Get YouTube Stats", "type": "n8n-nodes-base.httpRequest", "position": [680, 300], "parameters": { "url": "=https://www.googleapis.com/youtube/v3/videos", "sendQuery": true, "queryParameters": { "parameters": [ {"name": "part", "value": "statistics,snippet"}, {"name": "id", "value": "={{ $json.fields['Video ID'] }}"}, {"name": "key", "value": "YOUR_YOUTUBE_API_KEY"} ] } }, "typeVersion": 4.2 },
    { "id": "n4", "name": "Extract Metrics", "type": "n8n-nodes-base.set", "position": [900, 300], "parameters": { "assignments": { "assignments": [ {"id":"l1","name":"video_id","type":"string","value":"={{ $json.items[0].id }}"}, {"id":"l2","name":"title","type":"string","value":"={{ $json.items[0].snippet.title }}"}, {"id":"l3","name":"views","type":"number","value":"={{ $json.items[0].statistics.viewCount }}"}, {"id":"l4","name":"ctr_estimate","type":"string","value":"={{ $json.items[0].statistics.viewCount > 1000 ? 'high' : 'low' }}"}, {"id":"l5","name":"likes","type":"number","value":"={{ $json.items[0].statistics.likeCount }}"}, {"id":"l6","name":"thumbnail_version","type":"string","value":"={{ $('Fetch Videos Under Test').item.json.fields['Current Thumbnail'] }}"}, {"id":"l7","name":"days_live","type":"number","value":"={{ Math.floor((Date.now() - new Date($json.items[0].snippet.publishedAt)) / (1000*60*60*24)) }}"} ] } }, "typeVersion": 3.4 },
    { "id": "n5", "name": "Analyze Performance with AI", "type": "@n8n/n8n-nodes-langchain.chainLlm", "position": [1120, 300], "parameters": { "promptType": "define", "text": "=Analyze this YouTube video's thumbnail performance and give a recommendation.\n\nVideo: {{ $json.title }}\nViews: {{ $json.views }}\nLikes: {{ $json.likes }}\nDays Live: {{ $json.days_live }}\nCurrent Thumbnail Version: {{ $json.thumbnail_version }}\nTest History: {{ JSON.stringify($('Fetch Videos Under Test').item.json.fields) }}\n\nAnalyze:\n1. Is the current CTR performing above/below average for this niche?\n2. Should they switch to the next thumbnail variant?\n3. What elements likely helped or hurt CTR?\n\nReturn JSON:\n{\n  \"performance_verdict\": \"strong/average/weak\",\n  \"switch_thumbnail\": true/false,\n  \"switch_reason\": \"\",\n  \"ctr_estimate\": \"below 2% / 2-5% / above 5%\",\n  \"winning_elements\": [],\n  \"improvement_tips\": [],\n  \"keep_testing_days\": 0\n}" }, "typeVersion": 1.5 },
    { "id": "n6", "name": "OpenAI GPT-4o", "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi", "position": [1120, 460], "parameters": { "model": "gpt-4o", "options": {} }, "typeVersion": 1 },
    { "id": "n7", "name": "Parse Analysis", "type": "n8n-nodes-base.code", "position": [1340, 300], "parameters": { "jsCode": "const raw = $input.item.json.text.replace(/```json|```/g,'').trim();\nconst analysis = JSON.parse(raw);\nreturn [{ json: { ...analysis, video: $('Extract Metrics').item.json, record_id: $('Fetch Videos Under Test').item.json.id } }];" }, "typeVersion": 2 },
    { "id": "n8", "name": "Update Airtable Log", "type": "n8n-nodes-base.airtable", "position": [1560, 200], "parameters": { "operation": "update", "baseId": "YOUR_AIRTABLE_BASE_ID", "tableId": "Thumbnail Tests", "id": "={{ $json.record_id }}", "fieldsUi": { "fieldValues": [ {"fieldId": "Last Check Views", "fieldValue": "={{ $json.video.views }}"}, {"fieldId": "Performance", "fieldValue": "={{ $json.performance_verdict }}"}, {"fieldId": "Last Checked", "fieldValue": "={{ $now.toFormat('yyyy-MM-dd') }}"}, {"fieldId": "AI Recommendation", "fieldValue": "={{ $json.switch_reason }}"} ] } }, "typeVersion": 2.1 },
    { "id": "n9", "name": "Switch Alert?", "type": "n8n-nodes-base.if", "position": [1560, 400], "parameters": { "conditions": { "conditions": [{"leftValue": "={{ $json.switch_thumbnail }}", "rightValue": true, "operator": {"type": "boolean", "operation": "equal"}}] } }, "typeVersion": 2.2 },
    { "id": "n10", "name": "Slack Switch Alert", "type": "n8n-nodes-base.slack", "position": [1780, 300], "parameters": { "operation": "post", "channel": "#youtube", "text": "=🎨 *Thumbnail Switch Recommended*\n\n*Video:* {{ $json.video.title }}\n*Performance:* {{ $json.performance_verdict }} ({{ $json.video.views }} views in {{ $json.video.days_live }} days)\n*Reason:* {{ $json.switch_reason }}\n*Tips:* {{ $json.improvement_tips.join(', ') }}\n\nSwitch to next thumbnail variant now." }, "typeVersion": 2.2 },
    { "id": "n11", "name": "Sticky Note", "type": "n8n-nodes-base.stickyNote", "position": [220, 140], "parameters": { "content": "## FLOOWBOX - YouTube Thumbnail A/B Tracker\nRuns daily. Fetches view counts for videos currently being tested.\nGPT-4o analyzes performance and recommends whether to switch thumbnails.\nAlerts on Slack when a switch is recommended.\nLogs all data to Airtable for trend tracking." }, "typeVersion": 1 }
  ],
  "connections": {
    "Daily Check": {"main": [[{"node": "Fetch Videos Under Test", "type": "main", "index": 0}]]},
    "Fetch Videos Under Test": {"main": [[{"node": "Get YouTube Stats", "type": "main", "index": 0}]]},
    "Get YouTube Stats": {"main": [[{"node": "Extract Metrics", "type": "main", "index": 0}]]},
    "Extract Metrics": {"main": [[{"node": "Analyze Performance with AI", "type": "main", "index": 0}]]},
    "Analyze Performance with AI": {"main": [[{"node": "Parse Analysis", "type": "main", "index": 0}]]},
    "OpenAI GPT-4o": {"ai_languageModel": [[{"node": "Analyze Performance with AI", "type": "ai_languageModel", "index": 0}]]},
    "Parse Analysis": {"main": [[{"node": "Update Airtable Log", "type": "main", "index": 0}], [{"node": "Switch Alert?", "type": "main", "index": 0}]]},
    "Switch Alert?": {"main": [[{"node": "Slack Switch Alert", "type": "main", "index": 0}], []]}
  },
  "active": false,
  "settings": {"executionOrder": "v1"}
}
