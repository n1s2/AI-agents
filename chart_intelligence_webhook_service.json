{
  "id": "chartIntelWebhook01",
  "meta": {
    "instanceId": "3f9b7e2a1c4d4b6e8a9c0f1e2d3b4a5c"
  },
  "name": "Chart Intelligence Webhook Service",
  "tags": ["finance", "vision", "analysis"],
  "nodes": [
    {
      "id": "chart-webhook",
      "name": "Chart Upload Webhook",
      "type": "n8n-nodes-base.webhook",
      "position": [-220, -20],
      "parameters": {
        "path": "chart/analyze",
        "httpMethod": "POST",
        "responseMode": "responseNode"
      }
    },
    {
      "id": "chart-ai",
      "name": "Technical Chart Analyzer",
      "type": "@n8n/n8n-nodes-langchain.openAi",
      "position": [-40, -20],
      "parameters": {
        "resource": "image",
        "operation": "analyze",
        "inputType": "base64",
        "modelId": "gpt-4o-mini",
        "text": "You are a market analysis assistant. Review the provided price chart and explain potential trend direction and key signals in simple, non-advisory language."
      },
      "credentials": {
        "openAiApi": {
          "id": "OpenAI_Main",
          "name": "OpenAI Primary"
        }
      }
    },
    {
      "id": "respond",
      "name": "Return Analysis",
      "type": "n8n-nodes-base.respondToWebhook",
      "position": [140, -20],
      "parameters": {
        "respondWith": "text",
        "responseBody": "={{ $json.content }}"
      }
    }
  ],
  "connections": {
    "Chart Upload Webhook": { "main": [[{ "node": "Technical Chart Analyzer", "type": "main", "index": 0 }]] },
    "Technical Chart Analyzer": { "main": [[{ "node": "Return Analysis", "type": "main", "index": 0 }]] }
  },
  "active": true,
  "settings": { "executionOrder": "v1" }
}
