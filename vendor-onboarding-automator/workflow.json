{
  "name": "FLOOWBOX - Vendor Onboarding Automator",
  "meta": { "instanceId": "navtej-floowbox-n8n-2025" },
  "nodes": [
    { "id": "n1", "name": "New Vendor Webhook", "type": "n8n-nodes-base.webhook", "position": [240, 300], "parameters": { "path": "new-vendor", "httpMethod": "POST", "responseMode": "responseNode" }, "typeVersion": 2 },
    { "id": "n2", "name": "Set Vendor Data", "type": "n8n-nodes-base.set", "position": [460, 300], "parameters": { "assignments": { "assignments": [ {"id":"vo1","name":"vendor_name","type":"string","value":"={{ $json.company }}"}, {"id":"vo2","name":"contact_name","type":"string","value":"={{ $json.contact }}"}, {"id":"vo3","name":"contact_email","type":"string","value":"={{ $json.email }}"}, {"id":"vo4","name":"service_type","type":"string","value":"={{ $json.service }}"}, {"id":"vo5","name":"contract_value","type":"string","value":"={{ $json.value || 'TBD' }}"} ] } }, "typeVersion": 3.4 },
    { "id": "n3", "name": "Generate Onboarding Checklist", "type": "@n8n/n8n-nodes-langchain.chainLlm", "position": [680, 300], "parameters": { "promptType": "define", "text": "=Generate a vendor onboarding plan for FLOOWBOX.\n\nVendor: {{ $json.vendor_name }}\nContact: {{ $json.contact_name }}\nService: {{ $json.service_type }}\nContract Value: {{ $json.contract_value }}\n\nReturn JSON:\n{\n  \"required_documents\": [],\n  \"setup_steps\": [{\"step\": 1, \"action\": \"\", \"owner\": \"FLOOWBOX/Vendor\", \"deadline_days\": 0}],\n  \"systems_to_provision\": [],\n  \"welcome_email\": \"personalized welcome email to vendor contact\",\n  \"internal_checklist\": [\"internal tasks for FLOOWBOX team\"],\n  \"estimated_go_live_days\": 0\n}" }, "typeVersion": 1.5 },
    { "id": "n4", "name": "OpenAI GPT-4o", "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi", "position": [680, 460], "parameters": { "model": "gpt-4o", "options": {} }, "typeVersion": 1 },
    { "id": "n5", "name": "Parse Onboarding Plan", "type": "n8n-nodes-base.code", "position": [900, 300], "parameters": { "jsCode": "const raw = $input.item.json.text.replace(/```json|```/g,'').trim();\nconst plan = JSON.parse(raw);\nreturn [{ json: { ...plan, vendor: $('Set Vendor Data').item.json } }];" }, "typeVersion": 2 },
    { "id": "n6", "name": "Create Airtable Record", "type": "n8n-nodes-base.airtable", "position": [1100, 200], "parameters": { "operation": "create", "baseId": "YOUR_AIRTABLE_BASE_ID", "tableId": "Vendors", "fieldsUi": { "fieldValues": [{"fieldId": "Company", "fieldValue": "={{ $json.vendor.vendor_name }}"}, {"fieldId": "Contact", "fieldValue": "={{ $json.vendor.contact_name }}"}, {"fieldId": "Email", "fieldValue": "={{ $json.vendor.contact_email }}"}, {"fieldId": "Service", "fieldValue": "={{ $json.vendor.service_type }}"}, {"fieldId": "Status", "fieldValue": "Onboarding"}, {"fieldId": "Go Live Days", "fieldValue": "={{ $json.estimated_go_live_days }}"}] } }, "typeVersion": 2.1 },
    { "id": "n7", "name": "Send Welcome Email", "type": "n8n-nodes-base.emailSend", "position": [1100, 380], "parameters": { "toEmail": "={{ $json.vendor.contact_email }}", "fromEmail": "ops@floowbox.com", "subject": "=Welcome to FLOOWBOX — Next Steps", "html": "=<p>Hi {{ $json.vendor.contact_name }},</p><p>{{ $json.welcome_email.replace(/\\n/g,'<br>') }}</p><h3>Documents we'll need from you:</h3><ul>{{ $json.required_documents.map(d=>`<li>${d}</li>`).join('') }}</ul><p>We expect to be fully set up within {{ $json.estimated_go_live_days }} business days.</p>", "options": {} }, "typeVersion": 2.1 },
    { "id": "n8", "name": "Notify Team Slack", "type": "n8n-nodes-base.slack", "position": [1100, 560], "parameters": { "operation": "post", "channel": "#operations", "text": "=🤝 *New Vendor Onboarding — {{ $json.vendor.vendor_name }}*\n*Service:* {{ $json.vendor.service_type }}\n*Contact:* {{ $json.vendor.contact_name }}\n*Est. Go-Live:* {{ $json.estimated_go_live_days }} days\n\n*Internal Tasks:*\n{{ $json.internal_checklist.map(t=>`• ${t}`).join('\\n') }}" }, "typeVersion": 2.2 },
    { "id": "n9", "name": "Respond OK", "type": "n8n-nodes-base.respondToWebhook", "position": [1300, 380], "parameters": { "respondWith": "json", "responseBody": "{\"status\": \"onboarding_started\"}" }, "typeVersion": 1.1 },
    { "id": "n10", "name": "Sticky Note", "type": "n8n-nodes-base.stickyNote", "position": [220, 140], "parameters": { "content": "## Vendor Onboarding Automator\nNew vendor submitted → GPT-4o generates full onboarding plan.\nCreates Airtable vendor record.\nSends personalized welcome email with document checklist.\nNotifies internal team on Slack with action items.\nEstimates go-live timeline." }, "typeVersion": 1 }
  ],
  "connections": {
    "New Vendor Webhook": {"main": [[{"node": "Set Vendor Data", "type": "main", "index": 0}]]},
    "Set Vendor Data": {"main": [[{"node": "Generate Onboarding Checklist", "type": "main", "index": 0}]]},
    "Generate Onboarding Checklist": {"main": [[{"node": "Parse Onboarding Plan", "type": "main", "index": 0}]]},
    "OpenAI GPT-4o": {"ai_languageModel": [[{"node": "Generate Onboarding Checklist", "type": "ai_languageModel", "index": 0}]]},
    "Parse Onboarding Plan": {"main": [[{"node": "Create Airtable Record", "type": "main", "index": 0}], [{"node": "Send Welcome Email", "type": "main", "index": 0}], [{"node": "Notify Team Slack", "type": "main", "index": 0}]]},
    "Send Welcome Email": {"main": [[{"node": "Respond OK", "type": "main", "index": 0}]]}
  },
  "active": false,
  "settings": {"executionOrder": "v1"}
}
