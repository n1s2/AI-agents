{
  "name": "FLOOWBOX - Competitor Price Monitor with AI Analysis",
  "nodes": [
    {
      "parameters": {
        "content": "## Competitor Price Monitor\nScrapes competitor pricing pages daily and uses AI to detect changes.\n\nAlerts you via email when a competitor changes their pricing — so you always know before your clients do.\n\n**Setup:**\n- OpenAI API key\n- Gmail/SMTP credentials\n- List your competitor URLs in Set Config node",
        "height": 240,
        "width": 400,
        "color": 7
      },
      "id": "4d5e6f7g-0005-0005-0005-000000000001",
      "name": "Sticky Note",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [180, 100]
    },
    {
      "parameters": {
        "rule": {
          "interval": [{"field": "days", "daysInterval": 1}]
        }
      },
      "id": "4d5e6f7g-0005-0005-0005-000000000002",
      "name": "Daily Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [220, 400]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "cfg-001",
              "name": "competitor_1_name",
              "value": "Competitor A",
              "type": "string"
            },
            {
              "id": "cfg-002",
              "name": "competitor_1_url",
              "value": "https://competitor-a.com/pricing",
              "type": "string"
            },
            {
              "id": "cfg-003",
              "name": "competitor_2_name",
              "value": "Competitor B",
              "type": "string"
            },
            {
              "id": "cfg-004",
              "name": "competitor_2_url",
              "value": "https://competitor-b.com/pricing",
              "type": "string"
            },
            {
              "id": "cfg-005",
              "name": "alert_email",
              "value": "navtej@floowbox.com",
              "type": "string"
            },
            {
              "id": "cfg-006",
              "name": "my_pricing",
              "value": "FLOOWBOX starter: ₹25,000/month, growth: ₹50,000/month",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "4d5e6f7g-0005-0005-0005-000000000003",
      "name": "Set Competitor Config",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [440, 400]
    },
    {
      "parameters": {
        "url": "={{ $json.competitor_1_url }}",
        "options": {}
      },
      "id": "4d5e6f7g-0005-0005-0005-000000000004",
      "name": "Fetch Competitor 1 Page",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [660, 300]
    },
    {
      "parameters": {
        "url": "={{ $('Set Competitor Config').item.json.competitor_2_url }}",
        "options": {}
      },
      "id": "4d5e6f7g-0005-0005-0005-000000000005",
      "name": "Fetch Competitor 2 Page",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [660, 500]
    },
    {
      "parameters": {
        "operation": "extractHtmlContent",
        "dataPropertyName": "data",
        "extractionValues": {
          "values": [
            {
              "key": "pricing_text",
              "cssSelector": "body",
              "returnArray": false
            }
          ]
        },
        "options": {}
      },
      "id": "4d5e6f7g-0005-0005-0005-000000000006",
      "name": "Extract Page 1 Text",
      "type": "n8n-nodes-base.html",
      "typeVersion": 1.2,
      "position": [880, 300]
    },
    {
      "parameters": {
        "operation": "extractHtmlContent",
        "dataPropertyName": "data",
        "extractionValues": {
          "values": [
            {
              "key": "pricing_text",
              "cssSelector": "body",
              "returnArray": false
            }
          ]
        },
        "options": {}
      },
      "id": "4d5e6f7g-0005-0005-0005-000000000007",
      "name": "Extract Page 2 Text",
      "type": "n8n-nodes-base.html",
      "typeVersion": 1.2,
      "position": [880, 500]
    },
    {
      "parameters": {
        "mode": "combine",
        "combinationMode": "mergeByPosition",
        "options": {}
      },
      "id": "4d5e6f7g-0005-0005-0005-000000000008",
      "name": "Merge Both Pages",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3,
      "position": [1100, 400]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=You are a competitive intelligence analyst.\n\nMy pricing: {{ $('Set Competitor Config').item.json.my_pricing }}\n\nCompetitor 1 ({{ $('Set Competitor Config').item.json.competitor_1_name }}) pricing page content:\n{{ $json.pricing_text.substring(0, 1500) }}\n\nCompetitor 2 ({{ $('Set Competitor Config').item.json.competitor_2_name }}) pricing page content:\n{{ $json.pricing_text1.substring(0, 1500) }}\n\nAnalyze and provide:\n1. COMPETITOR 1 PRICING: Extract all plans and prices\n2. COMPETITOR 2 PRICING: Extract all plans and prices\n3. VS MY PRICING: How do I compare?\n4. OPPORTUNITIES: What gaps or advantages do I have?\n5. RECOMMENDATION: Should I adjust my pricing?\n\nBe specific with numbers. Flag anything that looks like a recent change.",
        "options": {
          "systemMessage": "You analyze competitor pricing with precision. You always extract exact numbers and plan names. You give actionable recommendations."
        }
      },
      "id": "4d5e6f7g-0005-0005-0005-000000000009",
      "name": "Analyze Pricing with AI",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.5,
      "position": [1320, 400]
    },
    {
      "parameters": {
        "model": "gpt-4o",
        "options": {}
      },
      "id": "4d5e6f7g-0005-0005-0005-000000000010",
      "name": "OpenAI GPT-4o",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1.2,
      "position": [1320, 580]
    },
    {
      "parameters": {
        "toEmail": "={{ $('Set Competitor Config').item.json.alert_email }}",
        "subject": "=Daily Competitor Pricing Report - {{ $now.toFormat('dd MMM yyyy') }}",
        "emailType": "text",
        "message": "=Daily competitor pricing intelligence from FLOOWBOX:\n\n{{ $json.text }}\n\n---\nAuto-generated by FLOOWBOX competitor monitor.",
        "options": {}
      },
      "id": "4d5e6f7g-0005-0005-0005-000000000011",
      "name": "Send Daily Report",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [1540, 400]
    }
  ],
  "connections": {
    "Daily Trigger": {
      "main": [[{"node": "Set Competitor Config", "type": "main", "index": 0}]]
    },
    "Set Competitor Config": {
      "main": [
        [{"node": "Fetch Competitor 1 Page", "type": "main", "index": 0}],
        [{"node": "Fetch Competitor 2 Page", "type": "main", "index": 0}]
      ]
    },
    "Fetch Competitor 1 Page": {
      "main": [[{"node": "Extract Page 1 Text", "type": "main", "index": 0}]]
    },
    "Fetch Competitor 2 Page": {
      "main": [[{"node": "Extract Page 2 Text", "type": "main", "index": 0}]]
    },
    "Extract Page 1 Text": {
      "main": [[{"node": "Merge Both Pages", "type": "main", "index": 0}]]
    },
    "Extract Page 2 Text": {
      "main": [[{"node": "Merge Both Pages", "type": "main", "index": 1}]]
    },
    "Merge Both Pages": {
      "main": [[{"node": "Analyze Pricing with AI", "type": "main", "index": 0}]]
    },
    "Analyze Pricing with AI": {
      "main": [[{"node": "Send Daily Report", "type": "main", "index": 0}]]
    },
    "OpenAI GPT-4o": {
      "ai_languageModel": [[{"node": "Analyze Pricing with AI", "type": "ai_languageModel", "index": 0}]]
    }
  },
  "pinData": {},
  "settings": {
    "executionOrder": "v1"
  },
  "staticData": null,
  "meta": {
