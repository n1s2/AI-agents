{
  "name": "FLOOWBOX - Sales Call Intelligence Agent",
  "meta": { "instanceId": "navtej-floowbox-n8n-2025" },
  "nodes": [
    { "id": "n1", "name": "Call Transcript Webhook", "type": "n8n-nodes-base.webhook", "position": [240, 300], "parameters": { "path": "sales-call", "httpMethod": "POST", "responseMode": "responseNode" }, "typeVersion": 2 },
    { "id": "n2", "name": "Extract Call Data", "type": "n8n-nodes-base.set", "position": [460, 300], "parameters": { "assignments": { "assignments": [ {"id":"sc1","name":"prospect_name","type":"string","value":"={{ $json.prospect }}"}, {"id":"sc2","name":"prospect_company","type":"string","value":"={{ $json.company }}"}, {"id":"sc3","name":"transcript","type":"string","value":"={{ $json.transcript }}"}, {"id":"sc4","name":"call_duration","type":"string","value":"={{ $json.duration || 'unknown' }}"} ] } }, "typeVersion": 3.4 },
    { "id": "n3", "name": "Analyze Call", "type": "@n8n/n8n-nodes-langchain.chainLlm", "position": [680, 300], "parameters": { "promptType": "define", "text": "=Analyze this sales call transcript and extract intelligence.\n\nProspect: {{ $json.prospect_name }} at {{ $json.prospect_company }}\nDuration: {{ $json.call_duration }}\n\nTranscript:\n{{ $json.transcript }}\n\nReturn JSON:\n{\n  \"deal_stage\": \"awareness/consideration/decision/closed_won/closed_lost\",\n  \"deal_score\": 0,\n  \"prospect_pain_points\": [],\n  \"objections_raised\": [{\"objection\": \"\", \"how_handled\": \"\", \"resolved\": true}],\n  \"buying_signals\": [],\n  \"red_flags\": [],\n  \"next_steps_agreed\": [],\n  \"follow_up_email_draft\": \"personalized follow up email\",\n  \"crm_note\": \"concise CRM update\",\n  \"talk_ratio\": \"estimated salesperson vs prospect talking time\",\n  \"call_summary\": \"3-4 sentence summary\"\n}" }, "typeVersion": 1.5 },
    { "id": "n4", "name": "OpenAI GPT-4o", "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi", "position": [680, 460], "parameters": { "model": "gpt-4o", "options": {} }, "typeVersion": 1 },
    { "id": "n5", "name": "Parse Intelligence", "type": "n8n-nodes-base.code", "position": [900, 300], "parameters": { "jsCode": "const raw = $input.item.json.text.replace(/```json|```/g,'').trim();\nconst intel = JSON.parse(raw);\nreturn [{ json: { ...intel, call: $('Extract Call Data').item.json } }];" }, "typeVersion": 2 },
    { "id": "n6", "name": "Update CRM", "type": "n8n-nodes-base.airtable", "position": [1100, 200], "parameters": { "operation": "create", "baseId": "YOUR_AIRTABLE_BASE_ID", "tableId": "Deals", "fieldsUi": { "fieldValues": [{"fieldId": "Prospect", "fieldValue": "={{ $json.call.prospect_name }}"}, {"fieldId": "Company", "fieldValue": "={{ $json.call.prospect_company }}"}, {"fieldId": "Stage", "fieldValue": "={{ $json.deal_stage }}"}, {"fieldId": "Score", "fieldValue": "={{ $json.deal_score }}"}, {"fieldId": "Notes", "fieldValue": "={{ $json.crm_note }}"}, {"fieldId": "Date", "fieldValue": "={{ $now.toFormat('yyyy-MM-dd') }}"}] } }, "typeVersion": 2.1 },
    { "id": "n7", "name": "Send Follow-up Email", "type": "n8n-nodes-base.emailSend", "position": [1100, 380], "parameters": { "toEmail": "navtej@floowbox.com", "fromEmail": "navtej@floowbox.com", "subject": "=Follow-up draft — {{ $json.call.prospect_name }}", "html": "=<p>{{ $json.follow_up_email_draft.replace(/\\n/g,'<br>') }}</p><hr><p><b>Call Summary:</b> {{ $json.call_summary }}</p><p><b>Next Steps:</b> {{ $json.next_steps_agreed.join(', ') }}</p>", "options": {} }, "typeVersion": 2.1 },
    { "id": "n8", "name": "Post to Slack", "type": "n8n-nodes-base.slack", "position": [1100, 560], "parameters": { "operation": "post", "channel": "#sales", "text": "=📞 *Sales Call — {{ $json.call.prospect_name }} @ {{ $json.call.prospect_company }}*\n*Stage:* {{ $json.deal_stage }} | *Score:* {{ $json.deal_score }}/10\n\n{{ $json.call_summary }}\n\n*Buying signals:* {{ $json.buying_signals.join(', ') || 'None' }}\n*Red flags:* {{ $json.red_flags.join(', ') || 'None' }}\n*Next steps:* {{ $json.next_steps_agreed.join(', ') }}" }, "typeVersion": 2.2 },
    { "id": "n9", "name": "Respond OK", "type": "n8n-nodes-base.respondToWebhook", "position": [1300, 380], "parameters": { "respondWith": "json", "responseBody": "{\"status\": \"analyzed\"}" }, "typeVersion": 1.1 },
    { "id": "n10", "name": "Sticky Note", "type": "n8n-nodes-base.stickyNote", "position": [220, 140], "parameters": { "content": "## Sales Call Intelligence Agent\nPost call transcript via webhook.\nGPT-4o extracts: pain points, objections, buying signals, deal stage.\nAuto-updates CRM, drafts follow-up email, posts summary to Slack.\nBuilt for FLOOWBOX sales process." }, "typeVersion": 1 }
  ],
  "connections": {
    "Call Transcript Webhook": {"main": [[{"node": "Extract Call Data", "type": "main", "index": 0}]]},
    "Extract Call Data": {"main": [[{"node": "Analyze Call", "type": "main", "index": 0}]]},
    "Analyze Call": {"main": [[{"node": "Parse Intelligence", "type": "main", "index": 0}]]},
    "OpenAI GPT-4o": {"ai_languageModel": [[{"node": "Analyze Call", "type": "ai_languageModel", "index": 0}]]},
    "Parse Intelligence": {"main": [[{"node": "Update CRM", "type": "main", "index": 0}], [{"node": "Send Follow-up Email", "type": "main", "index": 0}], [{"node": "Post to Slack", "type": "main", "index": 0}]]},
    "Send Follow-up Email": {"main": [[{"node": "Respond OK", "type": "main", "index": 0}]]}
  },
  "active": false,
  "settings": {"executionOrder": "v1"}
}
