{
  "name": "FLOOWBOX - Error Log Analyzer",
  "nodes": [
    { "id": "c3d4e5f6-0001-4000-8000-000000000001", "name": "Hourly Scan", "type": "n8n-nodes-base.scheduleTrigger", "typeVersion": 1.2, "position": [250, 300], "parameters": { "rule": { "interval": [{"field": "hours", "triggerAtMinute": 0}] } } },
    { "id": "c3d4e5f6-0002-4000-8000-000000000002", "name": "Fetch Error Logs", "type": "n8n-nodes-base.googleSheets", "typeVersion": 4.4, "position": [500, 300], "parameters": { "operation": "readRows", "documentId": "YOUR_LOGS_SHEET_ID", "sheetName": "Error Logs" } },
    { "id": "c3d4e5f6-0003-4000-8000-000000000003", "name": "Filter Last Hour", "type": "n8n-nodes-base.code", "typeVersion": 2, "position": [750, 300], "parameters": { "jsCode": "const rows = $input.all().map(i => i.json);\nconst cutoff = new Date(Date.now() - 60*60*1000);\nconst recent = rows.filter(r => new Date(r['Timestamp']) > cutoff);\nif (!recent.length) return [{ json: { has_errors: false, count: 0, errors: [], critical_count: 0 } }];\nconst critical = recent.filter(r => (r['Severity']||'').toLowerCase() === 'critical');\nreturn [{ json: { has_errors: true, count: recent.length, errors: recent, critical_count: critical.length } }];" } },
    { "id": "c3d4e5f6-0004-4000-8000-000000000004", "name": "Any Errors?", "type": "n8n-nodes-base.if", "typeVersion": 2.2, "position": [1000, 300], "parameters": { "conditions": { "conditions": [{"leftValue": "={{ $json.has_errors }}", "rightValue": true, "operator": {"type": "boolean", "operation": "equal"}}] } } },
    { "id": "c3d4e5f6-0005-4000-8000-000000000005", "name": "AI Root Cause", "type": "@n8n/n8n-nodes-langchain.chainLlm", "typeVersion": 1.5, "position": [1250, 200], "parameters": { "promptType": "define", "text": "=Analyze {{ $json.count }} errors ({{ $json.critical_count }} critical) from the last hour.\n\nErrors: {{ JSON.stringify($json.errors.slice(0,15)) }}\n\nReturn JSON: {\"root_cause_hypothesis\": \"\", \"error_pattern\": \"spike/steady/isolated\", \"affected_components\": [], \"likely_user_impact\": \"\", \"immediate_action\": \"\", \"digest\": \"2-3 sentence summary\"}" } },
    { "id": "c3d4e5f6-0006-4000-8000-000000000006", "name": "OpenAI GPT-4o", "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi", "typeVersion": 1, "position": [1250, 380], "parameters": { "model": "gpt-4o", "options": {} } },
    { "id": "c3d4e5f6-0007-4000-8000-000000000007", "name": "Parse and Alert", "type": "n8n-nodes-base.code", "typeVersion": 2, "position": [1500, 200], "parameters": { "jsCode": "const raw = $input.item.json.text.replace(/```json|```/g,'').trim();\nreturn [{ json: { ...JSON.parse(raw), stats: $('Filter Last Hour').item.json } }];" } },
    { "id": "c3d4e5f6-0008-4000-8000-000000000008", "name": "Slack Alert", "type": "n8n-nodes-base.slack", "typeVersion": 2.2, "position": [1750, 200], "parameters": { "operation": "post", "channel": "#engineering", "text": "=🔥 *Error Alert — {{ $now.toFormat('HH:mm') }}*\n*{{ $json.stats.count }} errors* ({{ $json.stats.critical_count }} critical) | Pattern: {{ $json.error_pattern }}\n\n{{ $json.digest }}\n\n*Hypothesis:* {{ $json.root_cause_hypothesis }}\n*Action:* {{ $json.immediate_action }}" } }
  ],
  "connections": {
    "Hourly Scan": {"main": [[{"node": "Fetch Error Logs", "type": "main", "index": 0}]]},
    "Fetch Error Logs": {"main": [[{"node": "Filter Last Hour", "type": "main", "index": 0}]]},
    "Filter Last Hour": {"main": [[{"node": "Any Errors?", "type": "main", "index": 0}]]},
    "Any Errors?": {"main": [[{"node": "AI Root Cause", "type": "main", "index": 0}], []]},
    "AI Root Cause": {"main": [[{"node": "Parse and Alert", "type": "main", "index": 0}]]},
    "OpenAI GPT-4o": {"ai_languageModel": [[{"node": "AI Root Cause", "type": "ai_languageModel", "index": 0}]]},
    "Parse and Alert": {"main": [[{"node": "Slack Alert", "type": "main", "index": 0}]]}
  },
  "active": false,
  "settings": { "executionOrder": "v1" },
  "id": "c3d4e5f6-0000-4000-8000-000000000036",
  "versionId": "c3d4e5f6-0000-4000-8000-000000000136",
  "meta": { "templateCredsSetupCompleted": true },
  "tags": []
}
