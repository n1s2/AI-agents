{"name":"Interview Question Generator Agent","nodes":[{"parameters":{"httpMethod":"POST","path":"generate-interview-questions","responseMode":"responseNode","options":{}},"id":"j1k2l3m4-0001","name":"Webhook","type":"n8n-nodes-base.webhook","typeVersion":2,"position":[200,320]},{"parameters":{"jsCode":"const body=$input.first().json.body;const required=['job_title','interview_type'];const missing=required.filter(f=>!body[f]);if(missing.length)return[{json:{valid:false,error:'Missing: '+missing.join(', ')}}];const interviewTypes=['behavioral','technical','case_study','culture_fit','leadership','panel','phone_screen'];const interviewType=interviewTypes.includes(body.interview_type)?body.interview_type:'behavioral';const questionCount=Math.min(20,Math.max(3,parseInt(body.question_count)||8));return[{json:{valid:true,jobTitle:body.job_title.trim(),interviewType,jobDescription:(body.job_description||'').slice(0,1500),competenciesRequired:Array.isArray(body.competencies_required)?body.competencies_required:(body.competencies_required||'').split('\\n').map(c=>c.trim()).filter(Boolean),seniorityLevel:body.seniority_level||'mid',industryContext:(body.industry_context||'').slice(0,300),interviewDuration:parseInt(body.interview_duration_minutes)||45,questionCount,includeScoring:body.include_scoring!==false,candidateBackground:(body.candidate_background||'').slice(0,400),replyEmail:body.reply_email||null}}];"},"id":"j1k2l3m4-0002","name":"Validate Input","type":"n8n-nodes-base.code","typeVersion":2,"position":[420,320]},{"parameters":{"conditions":{"conditions":[{"id":"cv","leftValue":"={{ $json.valid }}","rightValue":true,"operator":{"type":"boolean","operation":"true"}}],"combinator":"and"}},"id":"j1k2l3m4-0003","name":"Valid?","type":"n8n-nodes-base.if","typeVersion":2,"position":[640,320]},{"parameters":{"respondWith":"json","responseBody":"={{ { error: $json.error, status: 400 } }}"},"id":"j1k2l3m4-0004","name":"Return Error","type":"n8n-nodes-base.respondToWebhook","typeVersion":1,"position":[860,480]},{"parameters":{"model":"claude-sonnet-4-20250514","options":{"temperature":0.55,"maxTokens":3000},"messages":{"values":[{"content":"You design interview question sets for hiring managers. Good interview questions: are specific enough to distinguish strong from average candidates; use the STAR format for behavioral questions; probe for depth with follow-up questions; avoid illegal or biased questions; and map to specific competencies. Always respond in valid JSON only.","role":"system"},{"content":"Generate interview questions.\n\nRole: {{ $json.jobTitle }}\nInterview type: {{ $json.interviewType.replace(/_/g,' ') }}\nSeniority: {{ $json.seniorityLevel }}\nDuration: {{ $json.interviewDuration }} minutes\nQuestion count: {{ $json.questionCount }}\n\nJob description:\n{{ $json.jobDescription || 'not provided — infer from job title' }}\n\nRequired competencies:\n{{ $json.competenciesRequired.join('\\n') || 'infer from role and interview type' }}\n\nIndustry context: {{ $json.industryContext || 'general' }}\n\nCandidate background (if known):\n{{ $json.candidateBackground || 'not provided' }}\n\nReturn JSON:\n{\"interview_guide\":{\"opening_script\":\"2-3 sentences to open the interview and set expectations\",\"time_allocation\":\"how to split the {{ $json.interviewDuration }} minutes\"},\"questions\":[{\"question_number\":1,\"competency\":\"what this question tests\",\"question\":\"the question to ask\",\"question_type\":\"behavioral|technical|situational|hypothetical|motivational\",\"difficulty\":\"warmup|core|probe\",\"follow_ups\":[\"follow-up to go deeper\"],\"what_good_looks_like\":\"what a strong answer includes\",\"red_flags\":\"specific signals in the answer that should concern the interviewer\",\"estimated_time_minutes\":5}],\"scoring_guide\":{\"dimensions\":[{\"dimension\":\"\",\"weight_percent\":0,\"1_description\":\"poor performance indicators\",\"3_description\":\"meets expectations\",\"5_description\":\"exceptional performance\"}]},\"closing_questions\":\"questions to invite from the candidate\",\"debrief_notes\":\"what interviewers should record immediately after\"}","role":"user"}]}},"id":"j1k2l3m4-0005","name":"Claude Question Designer","type":"@n8n/n8n-nodes-langchain.lmChatAnthropic","typeVersion":1.3,"position":[860,240]},{"parameters":{"jsCode":"const raw=$input.first().json.text||$input.first().json.content?.[0]?.text||'';let guide;try{guide=JSON.parse(raw.replace(/```json|```/g,'').trim());}catch(e){return[{json:{error:'Parse error'}}];}const input=$('Validate Input').first().json;guide._meta={jobTitle:input.jobTitle,interviewType:input.interviewType,questionCount:(guide.questions||[]).length,replyEmail:input.replyEmail};return[{json:guide}];"},"id":"j1k2l3m4-0006","name":"Parse Guide","type":"n8n-nodes-base.code","typeVersion":2,"position":[1080,240]},{"parameters":{"jsCode":"const g=$input.first().json;const m=g._meta;function esc(s){return String(s||'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');}const diffColors={warmup:'#16a34a',core:'#2563eb',probe:'#7c3aed'};const typeColors={behavioral:'#2563eb',technical:'#dc2626',situational:'#d97706',hypothetical:'#7c3aed',motivational:'#16a34a'};const qCards=(g.questions||[]).map((q,i)=>{const dc=diffColors[q.difficulty]||'#6b7280';const tc=typeColors[q.question_type]||'#6b7280';const fups=(q.follow_ups||[]).map(f=>'<div style=\"font-size:12px;color:#6b7280;padding:3px 0;padding-left:12px;border-left:2px solid #e5e7eb\">\u21b3 '+esc(f)+'</div>').join('');return '<div style=\"border:1px solid #e5e7eb;border-radius:8px;margin-bottom:10px;overflow:hidden\"><div style=\"background:#f8faff;padding:8px 14px;border-bottom:1px solid #e5e7eb;display:flex;justify-content:space-between;align-items:center\"><div style=\"display:flex;gap:6px;align-items:center\"><span style=\"font-size:13px;font-weight:700;color:#1e3a8a\">Q'+q.question_number+'</span><span style=\"background:'+tc+'22;color:'+tc+';font-size:10px;font-weight:700;padding:1px 7px;border-radius:6px\">'+esc(q.question_type)+'</span><span style=\"background:'+dc+'22;color:'+dc+';font-size:10px;font-weight:700;padding:1px 7px;border-radius:6px\">'+esc(q.difficulty)+'</span></div><div style=\"display:flex;gap:8px;align-items:center\"><span style=\"font-size:11px;color:#9ca3af\">'+esc(q.competency)+'</span><span style=\"font-size:11px;color:#9ca3af\">~'+q.estimated_time_minutes+'min</span></div></div><div style=\"padding:12px 14px\"><div style=\"font-size:15px;font-weight:600;margin-bottom:8px;line-height:1.5\">'+esc(q.question)+'</div>'+(fups?'<div style=\"margin-bottom:8px\">'+fups+'</div>':'')+'<div style=\"display:grid;grid-template-columns:1fr 1fr;gap:8px\"><div style=\"background:#f0fdf4;padding:8px;border-radius:4px\"><div style=\"font-size:10px;font-weight:700;text-transform:uppercase;color:#16a34a;margin-bottom:3px\">Strong answer</div><div style=\"font-size:12px;color:#166534\">'+esc(q.what_good_looks_like)+'</div></div><div style=\"background:#fef2f2;padding:8px;border-radius:4px\"><div style=\"font-size:10px;font-weight:700;text-transform:uppercase;color:#dc2626;margin-bottom:3px\">Red flags</div><div style=\"font-size:12px;color:#7f1d1d\">'+esc(q.red_flags)+'</div></div></div></div></div>';}).join('');const ig=g.interview_guide||{};const scoreCards=(g.scoring_guide?.dimensions||[]).map(d=>'<div style=\"border:1px solid #e5e7eb;border-radius:6px;padding:10px 14px;margin-bottom:8px\"><div style=\"display:flex;justify-content:space-between;margin-bottom:6px\"><span style=\"font-size:13px;font-weight:700\">'+esc(d.dimension)+'</span><span style=\"font-size:12px;color:#9ca3af\">Weight: '+d.weight_percent+'%</span></div><div style=\"display:grid;grid-template-columns:1fr 1fr 1fr;gap:6px;font-size:11px\"><div style=\"background:#fef2f2;padding:6px;border-radius:4px\"><div style=\"color:#dc2626;font-weight:700;margin-bottom:2px\">1 — Poor</div><div style=\"color:#7f1d1d\">'+esc(d['1_description'])+'</div></div><div style=\"background:#fffbeb;padding:6px;border-radius:4px\"><div style=\"color:#d97706;font-weight:700;margin-bottom:2px\">3 — Meets</div><div style=\"color:#92400e\">'+esc(d['3_description'])+'</div></div><div style=\"background:#f0fdf4;padding:6px;border-radius:4px\"><div style=\"color:#16a34a;font-weight:700;margin-bottom:2px\">5 — Exceptional</div><div style=\"color:#166534\">'+esc(d['5_description'])+'</div></div></div></div>').join('');const html='<!DOCTYPE html><html><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"></head><body style=\"margin:0;padding:16px;background:#f9fafb;font-family:sans-serif;color:#111\"><div style=\"max-width:740px;margin:0 auto\"><div style=\"background:#1e293b;color:#fff;padding:18px 26px;border-radius:10px 10px 0 0\"><div style=\"font-size:11px;text-transform:uppercase;color:#64748b\">Interview Guide \u00b7 '+esc(m.interviewType.replace(/_/g,' '))+'</div><div style=\"font-size:18px;font-weight:700\">'+esc(m.jobTitle)+'</div><div style=\"font-size:13px;color:#9ca3af;margin-top:3px\">'+m.questionCount+' questions</div></div>'+(ig.opening_script?'<div style=\"background:#fff;padding:14px 26px;border:1px solid #e5e7eb;border-top:none\"><div style=\"font-size:11px;font-weight:700;text-transform:uppercase;color:#9ca3af;margin-bottom:5px\">Opening script</div><div style=\"font-size:14px;color:#374151;font-style:italic\">'+esc(ig.opening_script)+'</div>'+(ig.time_allocation?'<div style=\"font-size:13px;color:#9ca3af;margin-top:6px\">Time: '+esc(ig.time_allocation)+'</div>':'')+'</div>':'')+'<div style=\"background:#fff;padding:16px 26px;border:1px solid #e5e7eb;border-top:3px solid #f3f4f6\">'+qCards+'</div>'+(scoreCards?'<div style=\"background:#fff;padding:14px 26px;border:1px solid #e5e7eb;border-top:3px solid #f3f4f6\"><div style=\"font-size:11px;font-weight:700;text-transform:uppercase;color:#9ca3af;margin-bottom:8px\">Scoring guide</div>'+scoreCards+'</div>':'')+(g.closing_questions||g.debrief_notes?'<div style=\"background:#fffbeb;padding:14px 26px;border:1px solid #fde68a\">'+(g.closing_questions?'<div style=\"font-size:11px;font-weight:700;text-transform:uppercase;color:#92400e;margin-bottom:4px\">Closing questions</div><div style=\"font-size:13px;color:#78350f;margin-bottom:10px\">'+esc(g.closing_questions)+'</div>':'')+(g.debrief_notes?'<div style=\"font-size:11px;font-weight:700;text-transform:uppercase;color:#92400e;margin-bottom:4px\">Post-interview debrief</div><div style=\"font-size:13px;color:#78350f\">'+esc(g.debrief_notes)+'</div>':'')+'</div>':'')+'<div style=\"background:#1e293b;color:#475569;font-size:11px;padding:10px 26px;border-radius:0 0 10px 10px;text-align:center\">Interview Guide \u00b7 '+esc(m.jobTitle)+'</div></div></body></html>';return[{json:{html,replyEmail:m.replyEmail,jobTitle:m.jobTitle,interviewType:m.interviewType,questionCount:m.questionCount,guide:g}}];"},"id":"j1k2l3m4-0007","name":"Build Guide Doc","type":"n8n-nodes-base.code","typeVersion":2,"position":[1300,240]},{"parameters":{"conditions":{"conditions":[{"id":"ce","leftValue":"={{ $json.replyEmail }}","rightValue":"","operator":{"type":"string","operation":"notEmpty"}}],"combinator":"and"}},"id":"j1k2l3m4-0008","name":"Has Email?","type":"n8n-nodes-base.if","typeVersion":2,"position":[1520,240]},{"parameters":{"fromEmail":"={{$env.FROM_EMAIL}}","toEmail":"={{$json.replyEmail}}","subject":"Interview guide: {{ $json.jobTitle }} — {{ $json.interviewType.replace(/_/g,' ') }} — {{ $json.questionCount }} questions","emailType":"html","message":"={{$json.html}}"},"id":"j1k2l3m4-0009","name":"Email Guide","type":"n8n-nodes-base.emailSend","typeVersion":2.1,"position":[1740,180],"credentials":{"smtp":{"id":"smtp-creds-01","name":"SMTP Account"}}},{"parameters":{"respondWith":"json","responseBody":"={{ { status: 'generated', job: $json.jobTitle, type: $json.interviewType, question_count: $json.questionCount, emailed: $json.replyEmail ? true : false, guide: $json.guide } }}"},"id":"j1k2l3m4-0010","name":"Return Guide","type":"n8n-nodes-base.respondToWebhook","typeVersion":1,"position":[1960,240]}],"connections":{"Webhook":{"main":[[{"node":"Validate Input","type":"main","index":0}]]},"Validate Input":{"main":[[{"node":"Valid?","type":"main","index":0}]]},"Valid?":{"main":[[{"node":"Claude Question Designer","type":"main","index":0}],[{"node":"Return Error","type":"main","index":0}]]},"Claude Question Designer":{"main":[[{"node":"Parse Guide","type":"main","index":0}]]},"Parse Guide":{"main":[[{"node":"Build Guide Doc","type":"main","index":0}]]},"Build Guide Doc":{"main":[[{"node":"Has Email?","type":"main","index":0}]]},"Has Email?":{"main":[[{"node":"Email Guide","type":"main","index":0}],[{"node":"Return Guide","type":"main","index":0}]]},"Email Guide":{"main":[[{"node":"Return Guide","type":"main","index":0}]]}},"pinData":{},"settings":{"executionOrder":"v1","saveManualExecutions":true},"staticData":null,"tags":["hr","recruiting","interviews","hiring"],"triggerCount":0,"updatedAt":"2025-05-27T09:00:00.000Z","versionId":"v1.0.0"}
