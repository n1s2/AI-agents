{
  "name": "Daily Standup Writer Agent",
  "nodes": [
    {
      "parameters": { "httpMethod": "POST", "path": "standup", "responseMode": "responseNode", "options": {} },
      "id": "b8e2h5k7-0001", "name": "Webhook – Submit Updates",
      "type": "n8n-nodes-base.webhook", "typeVersion": 2, "position": [200, 300]
    },
    {
      "parameters": { "rule": { "interval": [{ "field": "days", "daysInterval": 1, "triggerAtHour": 9, "triggerAtMinute": 15 }] } },
      "id": "b8e2h5k7-0002", "name": "Daily 9:15am Digest",
      "type": "n8n-nodes-base.scheduleTrigger", "typeVersion": 1.1, "position": [200, 520]
    },
    {
      "parameters": { "jsCode": "const body = $input.first().json.body;\nconst required = ['team_member_name', 'raw_update'];\nconst missing = required.filter(f => !body[f]);\nif (missing.length) return [{ json: { valid: false, error: `Missing: ${missing.join(', ')}` } }];\nif (body.raw_update.trim().length < 20) return [{ json: { valid: false, error: 'raw_update too short' } }];\nreturn [{ json: { valid: true, teamMemberName: body.team_member_name.trim(), team: body.team||'', rawUpdate: body.raw_update.trim().slice(0,2000), mood: body.mood||null, blockers: body.blockers||'', standupFormat: body.standup_format||'yesterday_today_blockers', maxWords: Math.min(150,Math.max(30,parseInt(body.max_words)||80)), slackChannel: body.slack_channel||null, date: body.date||new Date().toISOString().split('T')[0], requestedAt: new Date().toISOString() } }];" },
      "id": "b8e2h5k7-0003", "name": "Validate Input",
      "type": "n8n-nodes-base.code", "typeVersion": 2, "position": [420, 300]
    },
    {
      "parameters": { "conditions": { "conditions": [{ "id": "cv", "leftValue": "={{ $json.valid }}", "rightValue": true, "operator": { "type": "boolean", "operation": "true" } }], "combinator": "and" } },
      "id": "b8e2h5k7-0004", "name": "Valid?",
      "type": "n8n-nodes-base.if", "typeVersion": 2, "position": [640, 300]
    },
    {
      "parameters": { "respondWith": "json", "responseBody": "={{ { error: $json.error, status: 400 } }}" },
      "id": "b8e2h5k7-0005", "name": "Return Error",
      "type": "n8n-nodes-base.respondToWebhook", "typeVersion": 1, "position": [860, 440]
    },
    {
      "parameters": {
        "model": "claude-sonnet-4-20250514",
        "options": { "temperature": 0.55, "maxTokens": 400 },
        "messages": { "values": [
          { "content": "You turn messy brain-dumps into clean, professional standup updates. Keep all real substance — every task, blocker, plan — but cut filler and structure clearly.\n\nFormat rules:\n- yesterday_today_blockers: three clear sections with concise bullets\n- async_message: single flowing paragraph, no headers, reads like a natural Slack message\n- bullet_only: flat bullet list, no section headers\n\nNever invent tasks. Never add details not mentioned. Keep under the word limit.\n\nRespond with only the standup text — no preamble, no explanation.", "role": "system" },
          { "content": "Write a standup for {{ $json.teamMemberName }}.\nDate: {{ $json.date }} | Format: {{ $json.standupFormat }} | Max words: {{ $json.maxWords }} | Team: {{ $json.team||'unspecified' }}\n\nRaw notes:\n{{ $json.rawUpdate }}\n{{ $json.blockers ? 'Blockers: ' + $json.blockers : '' }}\n{{ $json.mood !== null ? 'Mood: ' + $json.mood + '/5' : '' }}", "role": "user" }
        ]}
      },
      "id": "b8e2h5k7-0006", "name": "Claude Standup Writer",
      "type": "@n8n/n8n-nodes-langchain.lmChatAnthropic", "typeVersion": 1.3, "position": [860, 220]
    },
    {
      "parameters": {
        "operation": "appendOrUpdate", "documentId": "={{$env.STANDUP_SHEET_ID}}", "sheetName": "Standups",
        "columns": { "mappingMode": "defineBelow", "value": { "date": "={{ $('Validate Input').first().json.date }}", "team_member": "={{ $('Validate Input').first().json.teamMemberName }}", "team": "={{ $('Validate Input').first().json.team }}", "raw_update": "={{ $('Validate Input').first().json.rawUpdate }}", "formatted_standup": "={{ $input.first().json.text || $input.first().json.content?.[0]?.text }}", "mood": "={{ $('Validate Input').first().json.mood }}", "logged_at": "={{ $now.toISO() }}" } }, "options": {}
      },
      "id": "b8e2h5k7-0007", "name": "Save to Sheet",
      "type": "n8n-nodes-base.googleSheets", "typeVersion": 4.3, "position": [1080, 220],
      "credentials": { "googleSheetsOAuth2Api": { "id": "google-creds-01", "name": "Google Sheets" } }
    },
    {
      "parameters": { "conditions": { "conditions": [{ "id": "cs", "leftValue": "={{ $('Validate Input').first().json.slackChannel || '' }}", "rightValue": "", "operator": { "type": "string", "operation": "notEmpty" } }], "combinator": "and" } },
      "id": "b8e2h5k7-0008", "name": "Post to Slack?",
      "type": "n8n-nodes-base.if", "typeVersion": 2, "position": [1280, 220]
    },
    {
      "parameters": { "channel": "={{ $('Validate Input').first().json.slackChannel }}", "text": "{{ $('Validate Input').first().json.teamMemberName }} · {{ $('Validate Input').first().json.date }}\n\n{{ $('Claude Standup Writer').first().json.text || $('Claude Standup Writer').first().json.content?.[0]?.text }}", "otherOptions": {} },
      "id": "b8e2h5k7-0009", "name": "Post to Slack",
      "type": "n8n-nodes-base.slack", "typeVersion": 2.1, "position": [1500, 160],
      "credentials": { "slackApi": { "id": "slack-creds-01", "name": "Slack Account" } }
    },
    {
      "parameters": { "respondWith": "json", "responseBody": "={{ { status: 'written', team_member: $('Validate Input').first().json.teamMemberName, date: $('Validate Input').first().json.date, standup: $('Claude Standup Writer').first().json.text || $('Claude Standup Writer').first().json.content?.[0]?.text, posted_to_slack: $('Validate Input').first().json.slackChannel ? true : false } }}" },
      "id": "b8e2h5k7-0010", "name": "Return Standup",
      "type": "n8n-nodes-base.respondToWebhook", "typeVersion": 1, "position": [1720, 220]
    },
    {
      "parameters": { "operation": "read", "documentId": "={{$env.STANDUP_SHEET_ID}}", "sheetName": "Standups", "options": {} },
      "id": "b8e2h5k7-0011", "name": "Load Todays Standups",
      "type": "n8n-nodes-base.googleSheets", "typeVersion": 4.3, "position": [420, 520],
      "credentials": { "googleSheetsOAuth2Api": { "id": "google-creds-01", "name": "Google Sheets" } }
    },
    {
      "parameters": { "jsCode": "const rows = $input.all().map(r => r.json);\nconst today = new Date().toISOString().split('T')[0];\nconst todayRows = rows.filter(r => r.date === today);\nif (todayRows.length === 0) return [{ json: { hasStandups: false, date: today } }];\nreturn [{ json: { hasStandups: true, date: today, standups: todayRows, count: todayRows.length } }];" },
      "id": "b8e2h5k7-0012", "name": "Filter Today",
      "type": "n8n-nodes-base.code", "typeVersion": 2, "position": [640, 520]
    },
    {
      "parameters": { "conditions": { "conditions": [{ "id": "ch", "leftValue": "={{ $json.hasStandups }}", "rightValue": true, "operator": { "type": "boolean", "operation": "true" } }], "combinator": "and" } },
      "id": "b8e2h5k7-0013", "name": "Has Standups?",
      "type": "n8n-nodes-base.if", "typeVersion": 2, "position": [860, 520]
    },
    {
      "parameters": { "channel": "={{$env.DIGEST_SLACK_CHANNEL}}", "text": "📋 *Team Standup Digest · {{ $json.date }}*\n\n{{ $json.standups.map(s => '*' + s.team_member + '*\\n' + s.formatted_standup).join('\\n\\n---\\n\\n') }}", "otherOptions": {} },
      "id": "b8e2h5k7-0014", "name": "Post Team Digest",
      "type": "n8n-nodes-base.slack", "typeVersion": 2.1, "position": [1080, 520],
      "credentials": { "slackApi": { "id": "slack-creds-01", "name": "Slack Account" } }
    }
  ],
  "connections": {
    "Webhook – Submit Updates": { "main": [[{ "node": "Validate Input", "type": "main", "index": 0 }]] },
    "Validate Input": { "main": [[{ "node": "Valid?", "type": "main", "index": 0 }]] },
    "Valid?": { "main": [[{ "node": "Claude Standup Writer", "type": "main", "index": 0 }], [{ "node": "Return Error", "type": "main", "index": 0 }]] },
    "Claude Standup Writer": { "main": [[{ "node": "Save to Sheet", "type": "main", "index": 0 }]] },
    "Save to Sheet": { "main": [[{ "node": "Post to Slack?", "type": "main", "index": 0 }]] },
    "Post to Slack?": { "main": [[{ "node": "Post to Slack", "type": "main", "index": 0 }], [{ "node": "Return Standup", "type": "main", "index": 0 }]] },
    "Post to Slack": { "main": [[{ "node": "Return Standup", "type": "main", "index": 0 }]] },
    "Daily 9:15am Digest": { "main": [[{ "node": "Load Todays Standups", "type": "main", "index": 0 }]] },
    "Load Todays Standups": { "main": [[{ "node": "Filter Today", "type": "main", "index": 0 }]] },
    "Filter Today": { "main": [[{ "node": "Has Standups?", "type": "main", "index": 0 }]] },
    "Has Standups?": { "main": [[{ "node": "Post Team Digest", "type": "main", "index": 0 }], []] }
  },
  "pinData": {},
  "settings": { "executionOrder": "v1", "saveManualExecutions": true, "callerPolicy": "workflowsFromSameOwner" },
