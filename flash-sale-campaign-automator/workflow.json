{
  "name": "FLOOWBOX - Flash Sale Campaign Automator",
  "meta": { "instanceId": "navtej-floowbox-n8n-2025" },
  "nodes": [
    { "id": "n1", "name": "Launch Sale Webhook", "type": "n8n-nodes-base.webhook", "position": [240, 300], "parameters": { "path": "launch-flash-sale", "httpMethod": "POST", "responseMode": "responseNode" }, "typeVersion": 2 },
    { "id": "n2", "name": "Set Sale Config", "type": "n8n-nodes-base.set", "position": [460, 300], "parameters": { "assignments": { "assignments": [ {"id":"fs1","name":"sale_name","type":"string","value":"={{ $json.sale_name }}"}, {"id":"fs2","name":"discount_percent","type":"number","value":"={{ $json.discount }}"}, {"id":"fs3","name":"products","type":"string","value":"={{ JSON.stringify($json.products) }}"}, {"id":"fs4","name":"duration_hours","type":"number","value":"={{ $json.hours || 24 }}"}, {"id":"fs5","name":"discount_code","type":"string","value":"={{ $json.code }}"}, {"id":"fs6","name":"target_segment","type":"string","value":"={{ $json.segment || 'all customers' }}"} ] } }, "typeVersion": 3.4 },
    { "id": "n3", "name": "Write Email Campaign", "type": "@n8n/n8n-nodes-langchain.chainLlm", "position": [680, 200], "parameters": { "promptType": "define", "text": "=Write a flash sale email campaign.\n\nSale: {{ $json.sale_name }}\nDiscount: {{ $json.discount_percent }}% off\nProducts: {{ $json.products }}\nDuration: {{ $json.duration_hours }} hours only\nCode: {{ $json.discount_code }}\nTarget: {{ $json.target_segment }}\n\nWrite:\n1. Subject line (urgency + curiosity, under 50 chars)\n2. Preview text (30-40 chars)\n3. Email body (150-200 words, punchy, countdown urgency)\n\nReturn JSON: {\"subject\": \"\", \"preview\": \"\", \"body\": \"\"}" }, "typeVersion": 1.5 },
    { "id": "n4", "name": "Write Social Posts", "type": "@n8n/n8n-nodes-langchain.chainLlm", "position": [680, 400], "parameters": { "promptType": "define", "text": "=Write social media posts for a flash sale.\n\nSale: {{ $json.sale_name }}\nDiscount: {{ $json.discount_percent }}% off\nDuration: {{ $json.duration_hours }} hours\nCode: {{ $json.discount_code }}\n\nWrite:\n1. Instagram caption with emojis and hashtags\n2. Twitter/X post (under 240 chars, punchy)\n3. LinkedIn post (professional tone, why now)\n4. WhatsApp broadcast message (short, friendly)\n\nReturn JSON: {\"instagram\": \"\", \"twitter\": \"\", \"linkedin\": \"\", \"whatsapp\": \"\"}" }, "typeVersion": 1.5 },
    { "id": "n5", "name": "OpenAI GPT-4o", "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi", "position": [680, 600], "parameters": { "model": "gpt-4o", "options": {} }, "typeVersion": 1 },
    { "id": "n6", "name": "Parse Email Copy", "type": "n8n-nodes-base.code", "position": [900, 200], "parameters": { "jsCode": "const raw = $input.item.json.text.replace(/```json|```/g,'').trim();\nreturn [{ json: { email: JSON.parse(raw), config: $('Set Sale Config').item.json } }];" }, "typeVersion": 2 },
    { "id": "n7", "name": "Parse Social Copy", "type": "n8n-nodes-base.code", "position": [900, 400], "parameters": { "jsCode": "const raw = $input.item.json.text.replace(/```json|```/g,'').trim();\nreturn [{ json: { social: JSON.parse(raw) } }];" }, "typeVersion": 2 },
    { "id": "n8", "name": "Fetch Customer List", "type": "n8n-nodes-base.googleSheets", "position": [900, 580], "parameters": { "operation": "readRows", "documentId": "YOUR_CUSTOMERS_SHEET_ID", "sheetName": "Active Customers" }, "typeVersion": 4.4 },
    { "id": "n9", "name": "Send Sale Emails", "type": "n8n-nodes-base.emailSend", "position": [1120, 200], "parameters": { "toEmail": "={{ $('Fetch Customer List').all().map(i=>i.json['Email']).join(',') }}", "fromEmail": "deals@your-store.com", "subject": "={{ $json.email.subject }}", "html": "=<p>{{ $json.email.body.replace(/\\n/g,'<br>') }}</p><br><a href='https://your-store.com/shop?code={{ $json.config.discount_code }}' style='background:#e44;color:white;padding:12px 24px;text-decoration:none;border-radius:4px;font-weight:bold;'>SHOP NOW — {{ $json.config.discount_percent }}% OFF</a>", "options": {} }, "typeVersion": 2.1 },
    { "id": "n10", "name": "Post to Slack Channels", "type": "n8n-nodes-base.slack", "position": [1120, 400], "parameters": { "operation": "post", "channel": "#marketing", "text": "=🔥 *Flash Sale LIVE — {{ $('Set Sale Config').item.json.sale_name }}*\n\n*Instagram:*\n{{ $json.social.instagram }}\n\n*Twitter:*\n{{ $json.social.twitter }}\n\n*WhatsApp:*\n{{ $json.social.whatsapp }}\n\nCode: {{ $('Set Sale Config').item.json.discount_code }} | Expires in {{ $('Set Sale Config').item.json.duration_hours }}hrs" }, "typeVersion": 2.2 },
    { "id": "n11", "name": "Schedule End Reminder", "type": "n8n-nodes-base.wait", "position": [1340, 300], "parameters": { "amount": "={{ $('Set Sale Config').item.json.duration_hours - 2 }}", "unit": "hours" }, "typeVersion": 1.1 },
    { "id": "n12", "name": "Send Final 2hr Urgency Email", "type": "@n8n/n8n-nodes-langchain.chainLlm", "position": [1540, 300], "parameters": { "promptType": "define", "text": "=Write a final urgency email — 2 hours left in the sale.\n\nSale: {{ $('Set Sale Config').item.json.sale_name }}\nDiscount: {{ $('Set Sale Config').item.json.discount_percent }}% off\nCode: {{ $('Set Sale Config').item.json.discount_code }}\n\nMake it very short (50-80 words), pure urgency, last chance tone.\n\nReturn JSON: {\"subject\": \"\", \"body\": \"\"}" }, "typeVersion": 1.5 },
    { "id": "n13", "name": "OpenAI GPT-4o Final", "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi", "position": [1540, 460], "parameters": { "model": "gpt-4o", "options": {} }, "typeVersion": 1 },
    { "id": "n14", "name": "Respond to Webhook", "type": "n8n-nodes-base.respondToWebhook", "position": [460, 520], "parameters": { "respondWith": "json", "responseBody": "{\"status\": \"campaign_launched\"}" }, "typeVersion": 1.1 },
    { "id": "n15", "name": "Sticky Note", "type": "n8n-nodes-base.stickyNote", "position": [220, 140], "parameters": { "content": "## FLOOWBOX - Flash Sale Automator\nTrigger via webhook with sale config.\nGPT-4o writes:\n- Email (subject + body)\n- Instagram, Twitter, LinkedIn, WhatsApp copy\nSends to full customer list immediately.\nPosts all social copy to Slack for manual posting.\nAutomatically sends urgency email 2 hours before sale ends." }, "typeVersion": 1 }
  ],
  "connections": {
    "Launch Sale Webhook": {"main": [[{"node": "Set Sale Config", "type": "main", "index": 0}], [{"node": "Respond to Webhook", "type": "main", "index": 0}]]},
    "Set Sale Config": {"main": [[{"node": "Write Email Campaign", "type": "main", "index": 0}], [{"node": "Write Social Posts", "type": "main", "index": 0}], [{"node": "Fetch Customer List", "type": "main", "index": 0}]]},
    "Write Email Campaign": {"main": [[{"node": "Parse Email Copy", "type": "main", "index": 0}]]},
    "Write Social Posts": {"main": [[{"node": "Parse Social Copy", "type": "main", "index": 0}]]},
    "OpenAI GPT-4o": {"ai_languageModel": [[{"node": "Write Email Campaign", "type": "ai_languageModel", "index": 0}], [{"node": "Write Social Posts", "type": "ai_languageModel", "index": 0}]]},
    "Parse Email Copy": {"main": [[{"node": "Send Sale Emails", "type": "main", "index": 0}]]},
    "Parse Social Copy": {"main": [[{"node": "Post to Slack Channels", "type": "main", "index": 0}]]},
    "Send Sale Emails": {"main": [[{"node": "Schedule End Reminder", "type": "main", "index": 0}]]},
    "Schedule End Reminder": {"main": [[{"node": "Send Final 2hr Urgency Email", "type": "main", "index": 0}]]},
    "Send Final 2hr Urgency Email": {"main": [[{"node": "Parse Email Copy", "type": "main", "index": 0}]]},
    "OpenAI GPT-4o Final": {"ai_languageModel": [[{"node": "Send Final 2hr Urgency Email", "type": "ai_languageModel", "index": 0}]]}
  },
  "active": false,
  "settings": {"executionOrder": "v1"}
}
